    },
    {
      "id": "beat",
      "label": "Kick on the beat",
      "type": "boolean",
      "default": true,
      "help": "Adds a pulse on each detected beat. Has no effect on speech or ambient audio, where there is no steady tempo to find."
    },
    {
      "id": "captions",
      "label": "Captions",
      "type": "boolean",
      "default": true,
      "help": "Shows subtitles when the audio was scripted in Lolly, or when a transcript is set below. The script's own word timings drive them where it has any; otherwise the transcript does."
    },
    {
      "id": "transcript",
      "label": "Transcript",
      "type": "longtext",
      "default": "",
      "rows": 6,
      "dataSource": {
        "accept": ".srt,.vtt,text/plain,text/vtt"
      },
      "help": "Subtitles as SRT. Filled by Transcribe, or drop in your own file."
    },
    {
      "id": "autoCaption",
      "label": "Auto-caption",
      "type": "boolean",
      "default": false,
      "help": "Transcribe a newly picked clip on the spot, with no click. Runs on your device; the first run downloads the speech model once."
    },
    {
      "id": "accent",
      "label": "Waveform colour",
      "type": "color",
      "default": "{color.semantic.secondary}"
    },
    {
      "id": "ink",
      "label": "Text colour",
      "type": "color",
      "default": "{color.semantic.on-primary}"
    },
    {
      "id": "bg",
      "label": "Background",
      "type": "color",
      "default": "{color.semantic.primary}"
    }
  ]
}

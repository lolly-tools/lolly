{
  "id": "audiogram",
  "name": "Audiogram",
  "description": "Turn a voice clip or song into a branded video that actually moves with the sound - bars, spectrum, ring, ridgeline or scope, ready for social.",
  "a11yLabel": "Audiogram card for {{default title \"an audio clip\"}} with a waveform animated from the audio",
  "version": "2.7.2",
  "engineVersion": ">=1.150.0 <2.0.0",
  "status": "community",
  "category": "everyone",
  "tags": [
    "audio",
    "audiogram",
    "waveform",
    "spectrum",
    "podcast",
    "music",
    "voice",
    "video",
    "social",
    "quote",
    "visualizer"
  ],
  "isolate": true,
  "hooks": {
    "onInit": true,
    "onInput": true,
    "beforeExport": true
  },
  "examples": [
    {
      "label": "Podcast quote - bars",
      "values": {
        "title": "Slow is smooth, smooth is fast",
        "subtitle": "The Build Notes podcast · Ep. 41",
        "style": "bars"
      }
    },
    {
      "label": "Interview - captioned",
      "values": {
        "title": "In her own words",
        "subtitle": "Field notes · episode 12",
        "style": "wave",
        "transcript": "1\n00:00:00,200 --> 00:00:03,400\nWe started with one question.\n\n2\n00:00:03,600 --> 00:00:07,000\nWhat would you build if nothing had to scale?\n"
      }
    },
    {
      "label": "Broadcast - wave",
      "values": {
        "title": "Morning briefing",
        "subtitle": "Live weekdays · 06:00",
        "style": "wave"
      }
    },
    {
      "label": "Release - ring",
      "values": {
        "title": "New episode out now",
        "subtitle": "Listen anywhere",
        "style": "ring"
      }
    },
    {
      "label": "Music - spectrum",
      "values": {
        "title": "Tide Pool",
        "subtitle": "Out now everywhere",
        "style": "spectrum",
        "layout": "overlay"
      }
    },
    {
      "label": "Ridgeline",
      "values": {
        "title": "Signal",
        "subtitle": "A year of listening",
        "style": "ridge",
        "layout": "center"
      }
    },
    {
      "label": "MilkDrop revival",
      "values": {
        "title": "Turn it up",
        "subtitle": "MilkDrop, twenty years on",
        "style": "milkdrop",
        "layout": "overlay",
        "vizLook": "stock:geiss-thumb-drum"
      }
    }
  ],
  "render": {
    "width": 1080,
    "height": 1080,
    "formats": ["png", "webm", "mp4", "gif", "webp-anim", "html", "wav", "mp3", "m4a", "opus", "srt", "vtt", "apng"],
    "actions": [
      "copy",
      "download",
      "save"
    ],
    "video": {
      "wait": 0,
      "duration": 8
    },
    "capture": "audio",
    "convertPaths": false,
    "transcribe": {
      "source": "audio",
      "target": "transcript",
      "format": "srt",
      "auto": "autoCaption"
    }
  },
  "inputs": [
    {
      "id": "audio",
      "label": "Audio",
      "type": "asset",
      "assetType": "audio",
      "allowUpload": true,
      "help": "Pick a track from your library, upload a clip, or tap Record to speak one now. It's decoded on your device to drive the animation - the audio never leaves the browser. The animation and the exported video run the full length of the clip; very long clips (over about 10 minutes) still work but get a coarser animation. Leave empty for a placeholder waveform. To hear it in the export, choose \"This tool's audio\" as the Audio track in the download options."
    },
    {
      "id": "title",
      "label": "Title",
      "type": "text",
      "default": "Now playing",
      "help": "The headline on the card - an episode name or a pull-quote."
    },
    {
      "id": "subtitle",
      "label": "Subtitle",
      "type": "text",
      "default": "",
      "help": "A smaller line under the title - show name, guest, or where to listen."
    },
    {
      "id": "style",
      "label": "Visual style",
      "type": "select",
      "default": "bars",

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lolly.tools/schemas/rebrand-compiled-v1.schema.json",
  "title": "rebrand-compiled-v1",
  "description": "The accepted plan lowered to Design authored values, with lineage both ways and the report. Stage 5 of plan 274. The report property refers to rebrand-report-v1.schema.json, so register that schema first.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "source",
    "planRevision",
    "designSystem",
    "algorithms",
    "frames",
    "tray",
    "lineage",
    "report"
  ],
  "$defs": {
    "algorithmVersions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reader",
        "census",
        "plan"
      ],
      "properties": {
        "reader": {
          "type": "string",
          "maxLength": 64
        },
        "census": {
          "type": "string",
          "maxLength": 64
        },
        "plan": {
          "type": "string",
          "maxLength": 64
        },
        "compile": {
          "type": "string",
          "maxLength": 64
        }
      }
    },
    "archetypeId": {
      "enum": [
        "title",
        "section",
        "content",
        "two-column",
        "split",
        "visual",
        "full-image",
        "quote",
        "big-number",
        "main-point",
        "agenda",
        "table"
      ]
    },
    "archetypeRef": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,40}$",
      "description": "An archetype id: one of $defs/archetypeId, the twelve every master before the layout library carries, or from plan 275 on an archetype a master generated from the layout library under the library id (StructureIdV1). A reader meets an id its master does not carry by falling back and saying so. A build from before plan 275 refuses a file holding a library id with its own message."
    },
    "compiledFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceSlideId",
        "name",
        "width",
        "height",
        "archetype",
        "layers",
        "furnitureLayerIds",
        "placeholderLayerIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "sourceSlideId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "name": {
          "type": "string",
          "maxLength": 1024
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "archetype": {
          "$ref": "#/$defs/archetypeRef"
        },
        "masterId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "notes": {
          "type": "string",
          "maxLength": 1048576
        },
        "layers": {
          "type": "array",
          "maxItems": 20000,
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/designBoxRow"
              },
              {
                "type": "object",
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  "frame": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  }
                }
              },
              {
                "if": {
                  "not": {
                    "properties": {
                      "kind": {
                        "const": "frame"
                      }
                    },
                    "required": [
                      "kind"
                    ]
                  }
                },
                "then": {
                  "required": [
                    "frame"
                  ]
                }
              }
            ],
            "description": "A Design box row carrying its own layer id, because the furniture and placeholder lists, the tray and both lineage directions are keyed on layer ids. A row whose kind is frame is the frame's own Design row and sits in no other frame; every other row states the frame id it sits in."
          }
        },
        "furnitureLayerIds": {
          "type": "array",
          "maxItems": 20000,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "placeholderLayerIds": {
          "type": "array",
          "maxItems": 20000,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "continuation": {
          "type": "boolean"
        }
      }
    },
    "deckTheme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "remap"
      ],
      "description": "A deck theme (plan 275 section 6.2): a small token remap over the resolved design system for one project. The token hash beside it is taken before the theme.",
      "properties": {
        "id": {
          "$ref": "#/$defs/deckThemeId"
        },
        "mode": {
          "enum": [
            "light",
            "dark"
          ]
        },
        "remap": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to"
            ],
            "properties": {
              "from": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "to": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            }
          }
        },
        "lookId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "flipDark": {
          "type": "boolean"
        }
      }
    },
    "deckThemeId": {
      "enum": [
        "light",
        "dark",
        "brand",
        "look"
      ]
    },
    "designBoxRow": {
      "type": "object",
      "description": "One row of the Design boxes blocks input, in its declared field ids. The wire order lives in schemas/blocks-wire-order.json.",
      "maxProperties": 256,
      "propertyNames": {
        "maxLength": 128,
        "pattern": "^(?!__proto__$|constructor$|prototype$)[A-Za-z][A-Za-z0-9_.-]*$"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 1048576
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "designSystemSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tokenHash",
        "fontHashes",
        "assetHashes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "masterId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "masterVersion": {
          "type": "string",
          "maxLength": 64
        },
        "tokenHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "fontHashes": {
          "type": "object",
          "maxProperties": 512,
          "propertyNames": {
            "maxLength": 256,
            "pattern": "^(?!__proto__$|constructor$|prototype$)[A-Za-z0-9][A-Za-z0-9 ._:+/-]*$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 512
          }
        },
        "assetHashes": {
          "type": "object",
          "maxProperties": 4096,
          "propertyNames": {
            "maxLength": 256,
            "pattern": "^(?!__proto__$|constructor$|prototype$)[A-Za-z0-9][A-Za-z0-9 ._:+/-]*$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 512
          }
        },
        "presetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "presetVersion": {
          "type": "string",
          "maxLength": 64
        },
        "theme": {
          "$ref": "#/$defs/deckTheme"
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "forward",
        "backward"
      ],
      "properties": {
        "forward": {
          "type": "array",
          "maxItems": 200000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sourceObjectId",
              "layerIds"
            ],
            "properties": {
              "sourceObjectId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "layerIds": {
                "type": "array",
                "maxItems": 20000,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              }
            }
          },
          "description": "One entry per source object that reached the output. The ceiling of 200000 is the whole journey's, shared with the census and the report."
        },
        "backward": {
          "type": "array",
          "maxItems": 200000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "layerId",
              "sourceObjectIds"
            ],
            "properties": {
              "layerId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "sourceObjectIds": {
                "type": "array",
                "maxItems": 20000,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              },
              "derived": {
                "enum": [
                  "furniture",
                  "placeholder",
                  "continuation"
                ]
              }
            }
          },
          "description": "One entry per output layer. The ceiling of 200000 is the whole journey's, shared with the census and the report."
        }
      },
      "description": "Source to output and output to source, both directions, one to many and many to one."
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lineageId",
        "hash",
        "instanceId"
      ],
      "properties": {
        "lineageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "instanceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    }
  },
  "properties": {
    "version": {
      "const": 1
    },
    "source": {
      "$ref": "#/$defs/sourceRef"
    },
    "planRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "designSystem": {
      "$ref": "#/$defs/designSystemSnapshot"
    },
    "algorithms": {
      "$ref": "#/$defs/algorithmVersions"
    },
    "frames": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/compiledFrame"
      }
    },
    "tray": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceObjectId",
          "layer"
        ],
        "properties": {
          "sourceObjectId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "layer": {
            "allOf": [
              {
                "$ref": "#/$defs/designBoxRow"
              },
              {
                "type": "object",
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  }
                }
              }
            ],
            "description": "A Design box row with its own layer id. A tray layer sits in no frame, so it carries no frame id."
          }
        }
      }
    },
    "lineage": {
      "$ref": "#/$defs/lineage"
    },
    "report": {
      "$ref": "https://lolly.tools/schemas/rebrand-report-v1.schema.json"
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Brand vocabulary and proposed rules v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "label",
    "roles",
    "bindings",
    "rules"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "roles": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "resources"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "description": {
            "type": "string",
            "maxLength": 4000
          },
          "group": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "resources": {
            "type": "array",
            "maxItems": 256,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "path"
                  ],
                  "properties": {
                    "type": {
                      "const": "token"
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "id"
                  ],
                  "properties": {
                    "type": {
                      "const": "asset"
                    },
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "bindings": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "roleId",
          "consumer"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "roleId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "consumer": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "slot"
            ],
            "properties": {
              "tool": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "slot": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            }
          },
          "modes": {
            "type": "array",
            "maxItems": 256,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "kind",
          "roleIds",
          "parameters",
          "requirement",
          "origin",
          "review"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "roleIds": {
            "type": "array",
            "maxItems": 256,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          },
          "parameters": {
            "type": "object",
            "maxProperties": 128
          },
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "required": [],
            "properties": {
              "tools": {
                "type": "array",
                "maxItems": 256,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                }
              },
              "modes": {
                "type": "array",
                "maxItems": 256,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                }
              },
              "outputs": {
                "type": "array",
                "maxItems": 256,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                }
              }
            }
          },
          "requirement": {
            "enum": [
              "advisory",
              "required"
            ]
          },
          "origin": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "author"
                ],
                "properties": {
                  "kind": {
                    "const": "manual"
                  },
                  "author": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "reference"
                ],
                "properties": {
                  "kind": {
                    "const": "source"
                  },
                  "reference": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "locator": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  }
                }
              }
            ]
          },
          "review": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "state"
                ],
                "properties": {
                  "state": {
                    "const": "draft"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "state",
                  "authority"
                ],
                "properties": {
                  "state": {
                    "const": "approved"
                  },
                  "authority": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  }
                }
              }
            ]
          },
          "description": {
            "type": "string",
            "maxLength": 4000
          }
        }
      }
    },
    "guide": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "groups"
      ],
      "properties": {
        "groups": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "roleIds",
              "ruleIds"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "roleIds": {
                "type": "array",
                "maxItems": 256,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                }
              },
              "ruleIds": {
                "type": "array",
                "maxItems": 256,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                }
              },
              "description": {
                "type": "string",
                "maxLength": 4000
              }
            }
          }
        }
      }
    },
    "extensions": {
      "type": "object"
    }
  }
}

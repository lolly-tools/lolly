{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lolly.tools/schemas/text-document-v1.schema.json",
  "title": "Portable composed text document v1",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "stories": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/story"
      },
      "maxItems": 128,
      "minItems": 0
    },
    "styles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/style"
      },
      "maxItems": 256,
      "minItems": 0
    },
    "fonts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/font"
      },
      "maxItems": 512,
      "minItems": 0
    }
  },
  "required": [
    "version",
    "stories",
    "styles",
    "fonts"
  ],
  "additionalProperties": false,
  "$defs": {
    "character": {
      "type": "object",
      "properties": {
        "font": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "fallbackFonts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "maxItems": 16,
          "minItems": 0
        },
        "size": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 10000
        },
        "weight": {
          "type": "number",
          "minimum": 1,
          "maximum": 1000
        },
        "italic": {
          "type": "boolean"
        },
        "color": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "tracking": {
          "type": "number",
          "minimum": -1000,
          "maximum": 1000
        },
        "baselineShift": {
          "type": "number",
          "minimum": -10000,
          "maximum": 10000
        },
        "case": {
          "enum": [
            "none",
            "upper",
            "lower",
            "small-caps"
          ]
        },
        "underline": {
          "type": "boolean"
        },
        "strike": {
          "type": "boolean"
        },
        "features": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "pattern": "^[ -~]{4}$"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          }
        },
        "axes": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "pattern": "^[ -~]{4}$"
          },
          "additionalProperties": {
            "type": "number",
            "minimum": -1000000.0,
            "maximum": 1000000.0
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "paragraphStyle": {
      "type": "object",
      "properties": {
        "character": {
          "$ref": "#/$defs/character"
        },
        "direction": {
          "enum": [
            "auto",
            "ltr",
            "rtl"
          ]
        },
        "language": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8}){0,5}$"
        },
        "composition": {
          "enum": [
            "standard",
            "balanced",
            "best"
          ]
        },
        "align": {
          "enum": [
            "start",
            "center",
            "end",
            "justify"
          ]
        },
        "lastAlign": {
          "enum": [
            "start",
            "center",
            "end",
            "justify"
          ]
        },
        "lineHeight": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 20
        },
        "spaceBefore": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000
        },
        "spaceAfter": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000
        },
        "indentStart": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000
        },
        "indentEnd": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000
        },
        "firstIndent": {
          "type": "number",
          "minimum": -10000,
          "maximum": 10000
        },
        "wordSpacing": {
          "type": "object",
          "properties": {
            "min": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            },
            "ideal": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            },
            "max": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            }
          },
          "required": [
            "min",
            "ideal",
            "max"
          ],
          "additionalProperties": false
        },
        "shortLastLine": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "words": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "fraction": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "enabled",
            "words",
            "fraction"
          ],
          "additionalProperties": false
        },
        "keep": {
          "type": "object",
          "properties": {
            "startLines": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "endLines": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "together": {
              "type": "boolean"
            },
            "nextLines": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          },
          "required": [
            "startLines",
            "endLines",
            "together",
            "nextLines"
          ],
          "additionalProperties": false
        },
        "hyphenation": {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "off",
                "manual",
                "auto"
              ]
            },
            "minWord": {
              "type": "integer",
              "minimum": 2,
              "maximum": 100
            },
            "minBefore": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "minAfter": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "consecutive": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          },
          "required": [
            "mode",
            "minWord",
            "minBefore",
            "minAfter",
            "consecutive"
          ],
          "additionalProperties": false
        },
        "tabs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "position": {
                "type": "number",
                "minimum": 0,
                "maximum": 100000.0
              },
              "align": {
                "enum": [
                  "start",
                  "center",
                  "end",
                  "decimal"
                ]
              },
              "leader": {
                "type": "string",
                "maxLength": 32
              }
            },
            "required": [
              "position",
              "align"
            ],
            "additionalProperties": false
          },
          "maxItems": 128,
          "minItems": 0
        },
        "baselineGrid": {
          "type": "boolean"
        },
        "opticalMargin": {
          "type": "boolean"
        },
        "dropCap": {
          "type": "object",
          "properties": {
            "characters": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            },
            "lines": {
              "type": "integer",
              "minimum": 2,
              "maximum": 20
            },
            "gap": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000
            },
            "enabled": {
              "type": "boolean"
            }
          },
          "required": [
            "characters",
            "lines",
            "gap"
          ],
          "additionalProperties": false
        },
        "ruleBefore": {
          "$ref": "#/$defs/rule"
        },
        "ruleAfter": {
          "$ref": "#/$defs/rule"
        },
        "tokenLinks": {
          "type": "string",
          "maxLength": 32768
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "rule": {
      "type": "object",
      "properties": {
        "width": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 1000
        },
        "color": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "offset": {
          "type": "number",
          "minimum": -10000,
          "maximum": 10000
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "width",
        "color",
        "offset"
      ],
      "additionalProperties": false
    },
    "style": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "name": {
          "type": "string",
          "maxLength": 256
        },
        "kind": {
          "enum": [
            "character",
            "paragraph"
          ]
        },
        "basedOn": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "next": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "character": {
          "$ref": "#/$defs/character"
        },
        "paragraph": {
          "$ref": "#/$defs/paragraphStyle"
        }
      },
      "required": [
        "id",
        "name",
        "kind"
      ],
      "additionalProperties": false
    },
    "span": {
      "type": "object",
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        },
        "end": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        },
        "style": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "character": {
          "$ref": "#/$defs/character"
        },
        "noBreak": {
          "type": "boolean"
        },
        "literal": {
          "type": "boolean"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false
    },
    "paragraph": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        },
        "end": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        },
        "style": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "paragraph": {
          "$ref": "#/$defs/paragraphStyle"
        }
      },
      "required": [
        "id",
        "start",
        "end"
      ],
      "additionalProperties": false
    },
    "break": {
      "type": "object",
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        },
        "length": {
          "enum": [
            1,
            2
          ]
        },
        "kind": {
          "enum": [
            "paragraph",
            "soft"
          ]
        }
      },
      "required": [
        "start",
        "length",
        "kind"
      ],
      "additionalProperties": false
    },
    "inline": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        },
        "label": {
          "type": "string",
          "maxLength": 1024
        },
        "originalText": {
          "type": "string",
          "maxLength": 65536
        },
        "svg": {
          "type": "string",
          "maxLength": 2097152
        },
        "width": {
          "type": "number",
          "minimum": 0,
          "maximum": 100000.0
        },
        "ascent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100000.0
        },
        "descent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100000.0
        },
        "credits": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 1024
              },
              "url": {
                "type": "string",
                "maxLength": 2048
              },
              "license": {
                "type": "string",
                "maxLength": 2048
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": false
          },
          "maxItems": 256,
          "minItems": 0
        },
        "overflow": {
          "const": "visible"
        },
        "emojiSources": {
          "type": "array",
          "maxItems": 2048,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pack",
              "family",
              "style",
              "meaning",
              "label",
              "assetId",
              "source",
              "normalizer",
              "changes",
              "occurrences",
              "sourceChecksum",
              "artworkChecksum",
              "canonicalChecksum"
            ],
            "properties": {
              "pack": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "pin",
                  "checksum"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 512,
                    "pattern": "^[a-z0-9][a-z0-9-]*(/[a-z0-9][a-z0-9-]*)+$"
                  },
                  "pin": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "version"
                    ],
                    "properties": {
                      "version": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
                      }
                    }
                  },
                  "checksum": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  }
                }
              },
              "family": {
                "type": "string",
                "maxLength": 256
              },
              "style": {
                "type": "string",
                "maxLength": 256
              },
              "meaning": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "key"
                    ],
                    "properties": {
                      "kind": {
                        "const": "unicode"
                      },
                      "key": {
                        "type": "string",
                        "maxLength": 256,
                        "pattern": "^[0-9a-f]+(-[0-9a-f]+)*$"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "id"
                    ],
                    "properties": {
                      "kind": {
                        "const": "custom"
                      },
                      "id": {
                        "type": "string",
                        "maxLength": 512
                      }
                    }
                  }
                ]
              },
              "label": {
                "type": "string",
                "maxLength": 1024
              },
              "assetId": {
                "type": "string",
                "maxLength": 1024
              },
              "source": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "creator",
                  "sourceUrl",
                  "revision",
                  "license",
                  "licenseUrl",
                  "attribution",
                  "modifications"
                ],
                "properties": {
                  "creator": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "sourceUrl": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096,
                    "pattern": "^https?://"
                  },
                  "revision": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
                  },
                  "license": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "licenseUrl": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096,
                    "pattern": "^https?://"
                  },
                  "attribution": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 16384
                  },
                  "modifications": {
                    "type": "array",
                    "maxItems": 64,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    }
                  }
                }
              },
              "notices": {
                "type": "array",
                "maxItems": 64,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "text"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "maxLength": 256
                    },
                    "text": {
                      "type": "string",
                      "maxLength": 65536
                    }
                  }
                }
              },
              "normalizer": {
                "type": "string",
                "maxLength": 256
              },
              "changes": {
                "type": "array",
                "maxItems": 64,
                "items": {
                  "type": "string",
                  "maxLength": 4096
                }
              },
              "occurrences": {
                "type": "array",
                "maxItems": 65536,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "start",
                    "end"
                  ],
                  "properties": {
                    "start": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 65536
                    },
                    "end": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 65536
                    }
                  }
                }
              },
              "sourceChecksum": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "artworkChecksum": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "canonicalChecksum": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          }
        }
      },
      "required": [
        "id",
        "offset",
        "label",
        "originalText",
        "svg",
        "width",
        "ascent",
        "descent"
      ],
      "additionalProperties": false
    },
    "story": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740990
        },
        "source": {
          "type": "string",
          "maxLength": 65536
        },
        "paragraphs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/paragraph"
          },
          "maxItems": 4096,
          "minItems": 1
        },
        "breaks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/break"
          },
          "maxItems": 8192,
          "minItems": 0
        },
        "spans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/span"
          },
          "maxItems": 8192,
          "minItems": 0
        },
        "inlines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inline"
          },
          "maxItems": 2048,
          "minItems": 0
        },
        "frameIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "maxItems": 256,
          "minItems": 0
        },
        "defaultStyle": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        }
      },
      "required": [
        "version",
        "id",
        "revision",
        "source",
        "paragraphs",
        "breaks",
        "spans",
        "inlines",
        "frameIds"
      ],
      "additionalProperties": false
    },
    "font": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "family": {
          "type": "string",
          "maxLength": 256
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "faceIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1023
        },
        "source": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "asset"
                },
                "id": {
                  "type": "string",
                  "maxLength": 512
                }
              },
              "required": [
                "kind",
                "id"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "bundled"
                },
                "path": {
                  "type": "string",
                  "maxLength": 1024,
                  "pattern": "^/(fonts|catalog|tools)/"
                }
              },
              "required": [
                "kind",
                "path"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "embedded"
                },
                "base64": {
                  "type": "string",
                  "maxLength": 8388608,
                  "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                }
              },
              "required": [
                "kind",
                "base64"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "id",
        "family",
        "sha256",
        "faceIndex",
        "source"
      ],
      "additionalProperties": false
    }
  }
}

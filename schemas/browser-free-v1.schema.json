{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lolly.tools/schemas/browser-free-v1.schema.json",
  "title": "browser-free-v1",
  "description": "A tool's browser-free.json: the evidence that the Node shells' browser-free raster route (resvg, for PNG, BMP, JPEG XL, EXR, HDR and the HDR stills) draws the tool the way the browser tier does. Written by scripts/tool-browser-free.ts from measured cases, never by hand. The file is optional and only the Node hosts read it (toolAdmission in packages/node-shell/src/resvg-admission.ts); loading a tool never reads it, so no engine or app is affected. A record admits the tool only while its verdict is resvg and its tool version and digest match the tool's files; validate-catalog warns about a record that no longer does. Mirrors BrowserFreeRecordV1 in packages/node-shell/src/browser-free-record.ts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "tool", "verdict", "measured", "cases"],
  "properties": {
    "version": { "const": 1 },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$" },
        "version": { "type": "string", "minLength": 1, "maxLength": 40 },
        "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "sha256 over tool.json, template.html, styles.css and hooks.js (digestToolSources)." }
      }
    },
    "verdict": { "enum": ["resvg", "browser"], "description": "resvg: every drawn case was inside every band, so the route may draw the tool. browser: it may not." },
    "measured": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "profile", "webShell", "renderers", "bands"],
      "properties": {
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "profile": { "type": "string", "maxLength": 80 },
        "webShell": { "type": "string", "maxLength": 80, "description": "The commit the compared web shell was built from." },
        "renderers": {
          "type": "object",
          "additionalProperties": false,
          "required": ["resvg", "engine", "chromium"],
          "properties": {
            "resvg": { "type": "string", "maxLength": 40 },
            "engine": { "type": "string", "maxLength": 40 },
            "chromium": { "type": "string", "maxLength": 80 }
          }
        },
        "bands": {
          "type": "object",
          "additionalProperties": false,
          "required": ["threshold", "fillThreshold", "regionShare", "inkShare", "inkShift", "gradientLevels"],
          "properties": {
            "threshold": { "type": "number" },
            "fillThreshold": { "type": "number" },
            "regionShare": { "type": "number" },
            "inkShare": { "type": "number" },
            "inkShift": { "type": "number" },
            "gradientLevels": { "type": "number" }
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "args", "result"],
        "properties": {
          "name": { "type": "string", "maxLength": 120 },
          "args": { "type": "array", "maxItems": 40, "items": { "type": "string", "maxLength": 16000 } },
          "result": { "enum": ["inside", "outside", "refused", "error"] },
          "detail": { "type": "string", "maxLength": 2000 }
        }
      }
    }
  }
}

digraph programme_structure {
  rankdir=TB
  node [shape=box]
  brand [label="Your design system\ncolours, type, palettes", style=filled, fillcolor="#dcf3e6"]
  programme [label="Programme\ntools, assets, templates", style=filled, fillcolor="#dcf3e6"]
  company [label="Company\ndetails, logos, kit"]
  people [label="Its people\nsign in and make"]
  agents [label="Agent tokens\nwithin your limits"]
  files [label="Finished files\nrecord the company"]
  brand -> programme
  programme -> company
  company -> people
  company -> agents
  people -> files
  agents -> files
}

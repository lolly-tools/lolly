digraph what_reaches_a_partner {
  rankdir=TB
  node [shape=box]
  programme [label="Programme grants\ncollections, folders"]
  company [label="Company grants\nshared with it"]
  system [label="Your design system\ntokens, fonts, palettes"]
  gate [label="Licence gate\nwhen it is on"]
  held [label="Held back\nlisted on Licences"]
  partner [label="Person or agent\nin the company"]
  programme -> gate
  company -> gate
  gate -> held
  gate -> partner
  system -> partner
}

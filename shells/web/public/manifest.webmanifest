{
  "name": "Lolly",
  "short_name": "Lolly",
  "description": "Generate production-ready assets - QR codes, charts, graphics, PDFs and more - from simple inputs.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#fafaf8",
  "theme_color": "#0c322c",
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "categories": ["productivity", "design"],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "file_handlers": [
    {
      "action": "/",
      "launch_type": "single-client",
      "accept": {
        "application/vnd.lolly+zip": [".lolly"]
      }
    },
    {
      "action": "/",
      "launch_type": "single-client",
      "accept": {
        "application/x-penpot": [".penpot"],
        "application/x-figma": [".fig"],
        "application/vnd.adobe.indesign-idml-package": [".idml"],
        "application/illustrator": [".ai"],
        "image/svg+xml": [".svg"],
        "application/pdf": [".pdf"],
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [".xlsx"],
        "text/csv": [".csv"],
        "text/tab-separated-values": [".tsv"],
        "application/vnd.openxmlformats-officedocument.presentationml.presentation": [".pptx"],
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [".docx"],
        "image/vnd.adobe.photoshop": [".psd", ".psb"],
        "image/x-xcf": [".xcf"]
      }
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+lolly",
      "url": "/?deep-link=%s"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "application/vnd.lolly+zip",
            ".lolly",
            "image/*",
            "video/*",
            "audio/*",
            "text/*",
            "application/pdf",
            "application/json",
            "application/zip",
            ".penpot",
            ".fig",
            ".idml",
            ".ai",
            ".psd",
            ".xcf",
            ".xlsx",
            ".pptx",
            ".docx"
          ]
        }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "New QR code",
      "short_name": "QR code",
      "url": "/qr-code",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Batch mode",
      "short_name": "Batch",
      "url": "/#/batch",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "screenshots": [
    {
      "src": "/og.png",
      "sizes": "1200x630",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Lolly - generate production-ready assets from simple inputs"
    }
  ],
  "lang": "en"
}

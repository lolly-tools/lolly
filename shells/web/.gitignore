# Vendored on-device watermark ONNX models (tens of MB each) - Andy-run, never
# generated by a normal build. Adobe TrustMark decoders are downloaded by
# scripts/fetch-trustmark-models.ts (needs network); the Meta Content Seal
# (Pixel Seal) extractor is converted by scripts/convert-contentseal-onnx.py
# (needs torch + the videoseal checkpoint). Not committed for the same reason
# node_modules/ isn't: too large for git, and re-producible from a documented
# source. The web shell fetches each once at runtime and caches the bytes in
# IndexedDB (see shells/web/src/lib/{trustmark,contentseal}.ts), so end users
# never touch this directory.
public/models/
# Same story for the onnxruntime-web wasm/mjs runtime the models run on -
# copied from node_modules/onnxruntime-web/dist/ per fetch-trustmark-models.ts
# (trustmark.ts sets ort.env.wasm.wasmPaths = '/ort/').
public/ort/
# …and transformers.js's own PINNED onnxruntime-web build (a different version,
# not interchangeable with /ort/) - copied by scripts/copy-transformers-ort.ts
# for the Kokoro speech worker (lib/speech-kokoro-worker.ts sets wasmPaths = '/ort-hf/').
public/ort-hf/

# Claude Code local state (worktrees etc.) - never commit
.claude/

# Artist MilkDrop presets staged from node_modules by scripts/copy-viz-presets.ts.
# Third-party community works - depended on, never committed. See that script.
public/viz-presets/

# The rest of /info that build:info regenerates or copies (docs/build.ts):
# shots/ + audio/ are copied at build from the docs repo (committed there),
# the player bundle and the indexes are written per build, icon/founded-by
# are copied from the repo root. Source-only assets that only live here
# (mascots/, media/, fonts/, page images) STAY tracked.
public/info/shots/
public/info/audio/
# The landing's worked-example previews (plan 117 block 2) - copied per build out
# of the ACTIVE brand's catalog/previews/, which is where they are committed. Same
# rule as shots/: mirrored from a source of truth that lives elsewhere, and the
# copy here is per-profile, so committing it would freeze one brand's art into a
# build output that every other profile rewrites.
public/info/examples/
public/info/search-index.json
public/info/*/search-index.json
public/info/audio-index.json
public/info/docs-player*
public/info/manifest.json
public/info/docs-render-manifest.json
public/info/icon.svg
public/info/founded-by.svg
# Page seals (plans/105 section 7): one .c2pa Manifest Store per English page, signed by
# docs/build.ts over the page's final bytes. Derived from a page that is itself
# gitignored above - committing a credential for bytes the repo does not hold
# would be a record of nothing checkable. Every build re-creates the ones whose
# page (or whose signed components) changed and leaves the rest untouched.
public/info/*.c2pa

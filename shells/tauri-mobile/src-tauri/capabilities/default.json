{
  "identifier": "default",
  "description": "Default permissions for Lolly mobile",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "fs:allow-exists",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-remove",
    "fs:allow-mkdir",
    "fs:allow-read-dir",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$APPDATA/saved-state" },
        { "path": "$APPDATA/saved-state/**" },
        { "path": "$APPDATA/pack-store" },
        { "path": "$APPDATA/pack-store/**" },
        { "path": "$APPDATA/user-assets" },
        { "path": "$APPDATA/user-assets/**" },
        { "path": "$DOWNLOAD/Lolly" },
        { "path": "$DOWNLOAD/Lolly/**" },
        { "path": "$DOCUMENT/Lolly" },
        { "path": "$DOCUMENT/Lolly/**" }
      ]
    }
  ]
}

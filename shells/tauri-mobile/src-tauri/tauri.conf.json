{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lolly",
  "version": "1.0.7",
  "identifier": "tools.lolly.mobile",
  "build": {
    "beforeDevCommand": "pnpm run dev:frontend",
    "beforeBuildCommand": "pnpm run build:frontend:release",
    "devUrl": "http://localhost:5174",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lolly"
      }
    ],
    "security": {
      "csp": null,
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "lolly"
        ],
        "mimeType": "application/vnd.lolly+zip",
        "description": "Lolly bundle (session share or brand pack)",
        "name": "Lolly bundle",
        "role": "Editor",
        "rank": "Owner",
        "exportedType": {
          "identifier": "tools.lolly.pack",
          "conformsTo": [
            "public.data",
            "public.archive"
          ]
        },
        "androidIntentActionFilters": [
          "view"
        ]
      },
      {
        "ext": ["penpot"],
        "mimeType": "application/x-penpot",
        "description": "Penpot project",
        "name": "Penpot project",
        "role": "Editor",
        "rank": "Alternate",
        "androidIntentActionFilters": ["view"]
      },
      {
        "ext": ["fig"],
        "mimeType": "application/x-figma",
        "description": "Figma design file",
        "name": "Figma design file",
        "role": "Editor",
        "rank": "Alternate",
        "androidIntentActionFilters": ["view"]
      },
      {
        "ext": ["idml"],
        "mimeType": "application/vnd.adobe.indesign-idml-package",
        "description": "InDesign Markup document",
        "name": "InDesign Markup document",
        "role": "Editor",
        "rank": "Alternate",
        "androidIntentActionFilters": ["view"]
      },
      {
        "ext": ["ai"],
        "contentTypes": ["com.adobe.illustrator.ai-image"],
        "mimeType": "application/illustrator",
        "description": "Adobe Illustrator document",
        "name": "Adobe Illustrator document",
        "role": "Editor",
        "rank": "Alternate",
        "androidIntentActionFilters": ["view"]
      },
      {
        "ext": ["svg"],
        "contentTypes": ["public.svg-image"],
        "mimeType": "image/svg+xml",
        "description": "SVG document",
        "name": "SVG document",
        "role": "Editor",
        "rank": "Alternate",
        "androidIntentActionFilters": ["view"]
      },
      {
        "ext": ["pdf"],
        "contentTypes": ["com.adobe.pdf"],
        "mimeType": "application/pdf",
        "description": "PDF document",
        "name": "PDF document",
        "role": "Viewer",
        "rank": "Alternate",
        "androidIntentActionFilters": ["view"]
      },
      {
        "ext": ["xlsx"],
        "contentTypes": ["org.openxmlformats.spreadsheetml.sheet"],
        "mimeType": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
        "description": "Excel spreadsheet",
        "name": "Excel spreadsheet",
        "role": "Editor",
        "rank": "Alternate",
        "androidIntentActionFilters": ["view"]
      },
      {
        "ext": ["csv"],
        "contentTypes": ["public.comma-separated-values-text"],
        "mimeType": "text/csv",
        "description": "CSV table",
        "name": "CSV table",
        "role": "Editor",
        "rank": "Alternate",
        "androidIntentActionFilters": ["view"]
      },
      {
        "ext": ["tsv"],
        "contentTypes": ["public.tab-separated-values-text"],
        "mimeType": "text/tab-separated-values",
        "description": "Tab-separated table",
        "name": "Tab-separated table",
        "role": "Editor",
        "rank": "Alternate",
        "androidIntentActionFilters": ["view"]
      },
      {
        "ext": ["pptx"],
        "contentTypes": ["org.openxmlformats.presentationml.presentation"],
        "mimeType": "application/vnd.openxmlformats-officedocument.presentationml.presentation",
        "description": "PowerPoint presentation",
        "name": "PowerPoint presentation",
        "role": "Editor",
        "rank": "Alternate",
        "androidIntentActionFilters": ["view"]
      },
      {
        "ext": ["docx"],
        "contentTypes": ["org.openxmlformats.wordprocessingml.document"],
        "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "description": "Word document",
        "name": "Word document",
        "role": "Viewer",
        "rank": "Alternate",
        "androidIntentActionFilters": ["view"]
      },
      {
        "ext": ["psd", "psb"],
        "mimeType": "image/vnd.adobe.photoshop",
        "description": "Photoshop document",
        "name": "Photoshop document",
        "role": "Editor",
        "rank": "Alternate",
        "androidIntentActionFilters": ["view"]
      },
      {
        "ext": ["xcf"],
        "mimeType": "image/x-xcf",
        "description": "GIMP image",
        "name": "GIMP image",
        "role": "Editor",
        "rank": "Alternate",
        "androidIntentActionFilters": ["view"]
      }
    ],
    "iOS": {
      "minimumSystemVersion": "15.0",
      "developmentTeam": "2FCG2XLK6Y"
    }
  }
}

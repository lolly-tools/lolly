# Builder for the Debian/Ubuntu package.
#
# Deliberately carries NO node and NO cargo: the host's toolchain is bind-mounted
# in (see release/build-deb.sh), so the container only supplies the webkit2gtk /
# GTK development headers that a Tauri link needs. Ubuntu 24.04 matches the CI
# runner, so a local .deb and a CI .deb are built against the same libc/webkit.
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      libwebkit2gtk-4.1-dev \
      libgtk-3-dev \
      librsvg2-dev \
      libayatana-appindicator3-dev \
      libsoup-3.0-dev \
      libssl-dev \
      build-essential \
      pkg-config \
      patchelf \
      file \
      ca-certificates \
      curl \
      xz-utils \
    && rm -rf /var/lib/apt/lists/*

{
  "name": "@lolly/desktop",
  "version": "1.1.0",
  "license": "MPL-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:frontend": "VITE_MODELS_BASE=https://lolli.li vite",
    "build": "node ../../scripts/build-native.ts desktop build",
    "build:frontend": "node ../../scripts/copy-viz-presets.ts && pnpm -C ../.. run build:ort && pnpm -C ../.. run build:info && VITE_MODELS_BASE=https://lolli.li vite build && node -e \"const fs=require('node:fs');for(const f of fs.readdirSync('../web/src/locales'))if(f.endsWith('.json'))fs.rmSync('dist/info/'+f.slice(0,-5),{recursive:true,force:true})\"",
    "build:frontend:release": "pnpm -C ../.. run build:desktop:frontend:release",
    "build:quicklook": "sh scripts/build-macos-quicklook.sh",
    "build:cli-sidecar": "node ../../scripts/build-cli-sidecar.ts --install",
    "tauri": "node ../../scripts/tauri-cli.ts desktop",
    "build:profile": "LOLLY_EMBED_CATALOG=profile pnpm run build",
    "build:frontend:profile": "LOLLY_EMBED_CATALOG=profile pnpm run build:frontend",
    "build:frontend:profile:release": "LOLLY_EMBED_CATALOG=profile pnpm run build:frontend:release"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "2.5.2",
    "@tauri-apps/plugin-notification": "^2",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-updater": "2.13.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "vite": "^8.3.2"
  },
  "packageManager": "pnpm@11.26.0"
}

{
  "$description": "Synthetic design-brief fixture (plan 291 W3): a made-up brand with declared colour combinations and Design house rules, so public CI can test what the private SUSE pack carries.",
  "$themes": [
    { "name": "light", "selectedTokenSets": { "base": "enabled", "light": "enabled" } },
    { "name": "dark", "selectedTokenSets": { "base": "enabled", "dark": "enabled" } }
  ],
  "$extensions": {
    "com.suse.lolly": {
      "brandSystem": {
        "schemaVersion": 1,
        "id": "tidewater",
        "label": "Tidewater",
        "roles": [
          { "id": "typeface", "label": "Typeface", "resources": [{ "type": "token", "path": "font.brand" }] },
          { "id": "backgrounds", "label": "Backgrounds", "resources": [{ "type": "token", "path": "color.brand.navy" }, { "type": "token", "path": "color.brand.white" }] },
          { "id": "logo", "label": "Logo", "resources": [{ "type": "asset", "id": "tidewater/logo/positive" }, { "type": "asset", "id": "tidewater/logo/reverse" }] }
        ],
        "bindings": [],
        "rules": [
          { "id": "headline-weight", "label": "Headlines are Semibold", "kind": "text-weight", "roleIds": ["typeface"], "parameters": { "target": "headline", "weights": ["600"] }, "scope": { "tools": ["design"] }, "requirement": "required", "origin": { "kind": "manual", "author": "fixture" }, "review": { "state": "draft" } },
          { "id": "body-weight", "label": "Body text is Regular", "kind": "text-weight", "roleIds": ["typeface"], "parameters": { "target": "body", "weights": ["400"], "exemptRoles": ["number"] }, "scope": { "tools": ["design"] }, "requirement": "advisory", "origin": { "kind": "manual", "author": "fixture" }, "review": { "state": "draft" } },
          { "id": "headline-case", "label": "No capitals throughout", "kind": "text-case", "roleIds": [], "parameters": { "target": "headline", "forbid": "upper" }, "requirement": "required", "origin": { "kind": "manual", "author": "fixture" }, "review": { "state": "draft" } },
          { "id": "align-left", "label": "Text is left-aligned", "kind": "text-align", "roleIds": [], "parameters": { "align": "left", "exemptRoles": ["number"], "exemptFurniture": ["page-number*"], "exemptArchetypes": ["stats-*"], "exemptNumeric": true }, "requirement": "advisory", "origin": { "kind": "manual", "author": "fixture" }, "review": { "state": "draft" } },
          { "id": "pairings", "label": "Text colours follow the approved pairings", "kind": "color-pairing", "roleIds": ["backgrounds"], "parameters": { "source": "token-extension" }, "requirement": "required", "origin": { "kind": "manual", "author": "fixture" }, "review": { "state": "draft" } },
          { "id": "rounded-edges", "label": "No accent border on a rounded shape", "kind": "stroke-on-rounded", "roleIds": [], "parameters": { "neutral": ["{color.ramp.grey.7}", "{color.ramp.grey.2}"], "stripMax": 12 }, "requirement": "required", "origin": { "kind": "manual", "author": "fixture" }, "review": { "state": "draft" } },
          { "id": "dashes", "label": "Dashed means a drop target", "kind": "dash-reserved", "roleIds": [], "parameters": { "meaning": "drop-target" }, "requirement": "advisory", "origin": { "kind": "manual", "author": "fixture" }, "review": { "state": "draft" } },
          { "id": "logo-surface", "label": "Positive logo on light, reverse on dark and photography", "kind": "logo-surface", "roleIds": ["logo"], "parameters": { "light": ["tidewater/logo/positive"], "dark": ["tidewater/logo/reverse"], "photo": ["tidewater/logo/reverse"] }, "requirement": "advisory", "origin": { "kind": "manual", "author": "fixture" }, "review": { "state": "draft" } },
          { "id": "clear-space", "label": "Clear space around the logo", "kind": "tidewater.clear-space", "roleIds": ["logo"], "parameters": { "minimum": 0.5 }, "requirement": "required", "origin": { "kind": "manual", "author": "fixture" }, "review": { "state": "draft" } },
          { "id": "poster-only", "label": "A rule for another tool", "kind": "text-weight", "roleIds": [], "parameters": { "target": "text", "weights": ["900"] }, "scope": { "tools": ["brand-poster"] }, "requirement": "advisory", "origin": { "kind": "manual", "author": "fixture" }, "review": { "state": "draft" } }
        ]
      }
    }
  },
  "base": {
    "color": {
      "$type": "color",
      "brand": {
        "navy": { "$value": "#13294b", "$description": "Navy", "$extensions": { "com.suse.lolly": { "combinations": { "text": ["sand", "white"], "graphic": ["sand", "white", "reef"] } } } },
        "reef": { "$value": "#2fb8ac", "$description": "Reef", "$extensions": { "com.suse.lolly": { "combinations": { "text": ["navy"], "graphic": ["navy", "white"] } } } },
        "white": { "$value": "#ffffff", "$description": "White", "$extensions": { "com.suse.lolly": { "combinations": { "text": ["navy", "ink"], "graphic": ["navy", "ink", "reef"] } } } },
        "sand": { "$value": "#f3e9d2", "$description": "Sand" },
        "ink": { "$value": "#1b1b1b", "$description": "Ink" }
      },
      "ramp": {
        "grey": {
          "2": { "$value": "#3a3a3a" },
          "7": { "$value": "#d9d9d9" }
        }
      }
    },
    "font": {
      "$type": "fontFamily",
      "brand": { "$value": "Fixture Sans" },
      "mono": { "$value": "Fixture Mono" }
    },
    "asset": {
      "logo": {
        "positive": { "$value": "tidewater/logo/positive" },
        "reverse": { "$value": "tidewater/logo/reverse" }
      }
    }
  },
  "light": {
    "color": {
      "$type": "color",
      "semantic": {
        "primary": { "$value": "{color.brand.navy}" },
        "on-primary": { "$value": "{color.brand.white}" },
        "secondary": { "$value": "{color.brand.reef}" },
        "surface": { "$value": "{color.brand.white}" },
        "text": { "$value": "{color.brand.navy}" },
        "muted": { "$value": "{color.ramp.grey.2}" },
        "edge": { "$value": "{color.ramp.grey.7}" }
      }
    }
  },
  "dark": {
    "color": {
      "$type": "color",
      "semantic": {
        "primary": { "$value": "{color.brand.reef}" },
        "on-primary": { "$value": "{color.brand.navy}" },
        "secondary": { "$value": "{color.brand.sand}" },
        "surface": { "$value": "{color.brand.navy}" },
        "text": { "$value": "{color.brand.white}" },
        "muted": { "$value": "{color.ramp.grey.7}" },
        "edge": { "$value": "{color.ramp.grey.2}" }
      }
    }
  }
}

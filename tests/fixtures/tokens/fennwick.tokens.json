{
  "00 Basis/Farben": {
    "farbe": {
      "$type": "color",
      "moos": {
        "$value": "#3f6b4f",
        "$extensions": {
          "com.example.fennwick": { "druckfarbe": "Moos 57", "notiz": "{kein.verweis}" }
        }
      },
      "tinte": { "$value": "#16241c" },
      "papier": { "$value": "#f4f1ea" },
      "rost": { "$value": "#b5532a" }
    }
  },
  "00 Basis/Maße": {
    "maß": {
      "$type": "dimension",
      "basis": { "$value": { "value": 8, "unit": "px" } },
      "schrift": { "$value": { "value": 18, "unit": "px" } }
    },
    "schrift": {
      "familie": { "$type": "fontFamily", "$value": ["Fennwick Grotesk", "sans-serif"] }
    }
  },
  "10 Semantik/Gemeinsam": {
    "schrift": {
      "fließtext": {
        "$type": "typography",
        "$value": { "fontFamily": "{schrift.familie}", "fontSize": "{maß.schrift}", "fontWeight": 400, "lineHeight": 1.4 }
      }
    },
    "schaltfläche": {
      "$type": "color",
      "hintergrund": { "$value": "{farbe.moos}" },
      "beschriftung": { "$value": "{fläche.grund}" }
    },
    "zyklus": {
      "$type": "color",
      "eins": { "$value": "{zyklus.zwei}" },
      "zwei": { "$value": "{zyklus.drei}" },
      "drei": { "$value": "{zyklus.eins}" }
    },
    "verweis": {
      "$type": "color",
      "fehlt": { "$value": "{farbe.salbei}" }
    }
  },
  "10 Semantik/Hell": {
    "fläche": {
      "$type": "color",
      "grund": { "$value": "{farbe.papier}" }
    }
  },
  "10 Semantik/Dunkel": {
    "fläche": {
      "$type": "color",
      "grund": { "$value": "{farbe.tinte}" }
    },
    "schaltfläche": {
      "$type": "color",
      "hintergrund": { "$value": "#6f9c7f" }
    }
  },
  "20 Kontrast/Hoch": {
    "schaltfläche": {
      "$type": "color",
      "hintergrund": { "$value": "{farbe.tinte}" }
    }
  },
  "30 Marke/Junior": {
    "schrift": {
      "familie": { "$type": "fontFamily", "$value": ["Fennwick Rund", "sans-serif"] }
    }
  },
  "$themes": [
    {
      "id": "6a1c0e5f9b2d47a8c3e1f0d9b8a7c6e5d4f3a2b1",

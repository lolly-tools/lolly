            6,
            6
          ],
          "expect": {
            "C": 0,
            "M": 0,
            "Y": 0,
            "K": 0
          }
        },
        {
          "name": "Void 0/0/0/100",
          "rect": [
            30,
            30,
            340,
            140
          ],
          "expect": {
            "C": 0,
            "M": 0,
            "Y": 0,
            "K": 100
          }
        }
      ]

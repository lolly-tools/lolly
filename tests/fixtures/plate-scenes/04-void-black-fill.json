      "y": 0,
      "w": 400,
      "h": 200,
      "bg": "#ffffff"
    },
    {
      "id": "void",
      "kind": "box",
      "frame": "page",
      "x": 20,
      "y": 20,
      "w": 360,
      "h": 160,
      "bg": "#000000"
    }
  ],
  "structure": {
    "noDeviceRgbOps": true,
    "noSeparations": true
  },
  "passes": [

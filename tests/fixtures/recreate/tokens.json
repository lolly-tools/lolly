{
  "$description": "Synthetic design system for the recreation eval (plan 291 W10): a made-up brand set in the OFL faces SUSE and SUSE Mono from shells/web/public/fonts, so measure, check and export all use faces the repo ships. Its house rules stay in review state draft, so they report and never gate. It declares no logo and no logo-surface rule: a design system passed with --file never resolves asset ids (only the content profile's own catalog does), so a logo id here would name a mark that compose, package and check cannot find.",
  "$themes": [
    {
      "name": "light",
      "selectedTokenSets": {
        "base": "enabled",
        "light": "enabled"
      }
    },
    {
      "name": "dark",
      "selectedTokenSets": {
        "base": "enabled",
        "dark": "enabled"
      }
    }
  ],
  "$extensions": {
    "com.suse.lolly": {
      "brandSystem": {
        "schemaVersion": 1,
        "id": "harbourline",
        "label": "Harbourline",
        "roles": [
          {
            "id": "typeface",
            "label": "Typeface",
            "resources": [
              {
                "type": "token",
                "path": "font.brand"
              }
            ]
          },
          {
            "id": "backgrounds",
            "label": "Backgrounds",
            "resources": [
              {
                "type": "token",
                "path": "color.brand.navy"
              },
              {
                "type": "token",
                "path": "color.brand.white"
              }
            ]
          }
        ],
        "bindings": [],
        "rules": [
          {
            "id": "headline-weight",
            "label": "Headlines are Bold",
            "kind": "text-weight",
            "roleIds": [
              "typeface"
            ],
            "parameters": {
              "target": "headline",
              "weights": [
                "700"
              ]
            },
            "scope": {
              "tools": [
                "design"
              ]
            },
            "requirement": "required",
            "origin": {
              "kind": "manual",
              "author": "fixture"
            },
            "review": {
              "state": "draft"
            }
          },
          {
            "id": "body-weight",
            "label": "Body text is Regular",
            "kind": "text-weight",
            "roleIds": [
              "typeface"
            ],
            "parameters": {
              "target": "body",
              "weights": [
                "400"
              ],
              "exemptRoles": [
                "number"
              ]
            },
            "scope": {
              "tools": [
                "design"
              ]
            },
            "requirement": "advisory",
            "origin": {
              "kind": "manual",
              "author": "fixture"
            },
            "review": {
              "state": "draft"
            }
          },
          {
            "id": "headline-case",
            "label": "No capitals throughout",
            "kind": "text-case",
            "roleIds": [],
            "parameters": {
              "target": "headline",
              "forbid": "upper"
            },
            "requirement": "required",
            "origin": {
              "kind": "manual",
              "author": "fixture"
            },
            "review": {
              "state": "draft"
            }
          },
          {
            "id": "align-left",
            "label": "Text is left-aligned",
            "kind": "text-align",
            "roleIds": [],
            "parameters": {
              "align": "left",
              "exemptRoles": [
                "number"
              ],
              "exemptFurniture": [
                "page-number*"
              ],
              "exemptArchetypes": [
                "stats-*"
              ],
              "exemptNumeric": true
            },
            "requirement": "advisory",
            "origin": {
              "kind": "manual",
              "author": "fixture"
            },
            "review": {
              "state": "draft"
            }
          },
          {
            "id": "pairings",
            "label": "Text colours follow the approved pairings",
            "kind": "color-pairing",
            "roleIds": [
              "backgrounds"
            ],
            "parameters": {
              "source": "token-extension"
            },
            "requirement": "required",
            "origin": {
              "kind": "manual",
              "author": "fixture"
            },
            "review": {
              "state": "draft"
            }
          },
          {
            "id": "rounded-edges",
            "label": "No accent border on a rounded shape",
            "kind": "stroke-on-rounded",
            "roleIds": [],
            "parameters": {
              "neutral": [
                "{color.ramp.grey.7}",
                "{color.ramp.grey.2}"
              ],
              "stripMax": 12
            },
            "requirement": "required",
            "origin": {
              "kind": "manual",
              "author": "fixture"
            },
            "review": {
              "state": "draft"
            }
          },
          {
            "id": "dashes",
            "label": "Dashed means a drop target",
            "kind": "dash-reserved",
            "roleIds": [],
            "parameters": {
              "meaning": "drop-target"
            },
            "requirement": "advisory",
            "origin": {
              "kind": "manual",
              "author": "fixture"
            },
            "review": {
              "state": "draft"
            }
          }
        ]
      }
    }
  },
  "base": {
    "color": {
      "$type": "color",
      "brand": {
        "navy": {
          "$value": "#13294b",
          "$description": "Navy",
          "$extensions": {
            "com.suse.lolly": {
              "combinations": {
                "text": [
                  "sand",
                  "white"
                ],
                "graphic": [
                  "sand",
                  "white",
                  "reef"
                ]
              }
            }
          }
        },
        "reef": {
          "$value": "#2fb8ac",
          "$description": "Reef",
          "$extensions": {
            "com.suse.lolly": {
              "combinations": {
                "text": [
                  "navy"
                ],
                "graphic": [
                  "navy",
                  "white"
                ]
              }
            }
          }
        },
        "white": {
          "$value": "#ffffff",
          "$description": "White",
          "$extensions": {
            "com.suse.lolly": {
              "combinations": {
                "text": [
                  "navy",
                  "ink"
                ],
                "graphic": [
                  "navy",
                  "ink",
                  "reef"
                ]
              }
            }
          }
        },
        "sand": {
          "$value": "#f3e9d2",
          "$description": "Sand"
        },
        "ink": {
          "$value": "#1b1b1b",
          "$description": "Ink"
        }
      },
      "ramp": {
        "grey": {
          "2": {
            "$value": "#3a3a3a"
          },
          "7": {
            "$value": "#d9d9d9"
          }
        },
        "neutral": {
          "8": {
            "$value": "#eef1f4"
          }
        }
      }
    },
    "font": {
      "$type": "fontFamily",
      "brand": {
        "$value": "SUSE"
      },
      "mono": {
        "$value": "SUSE Mono"
      }
    }
  },
  "light": {
    "color": {
      "$type": "color",
      "semantic": {
        "primary": {
          "$value": "{color.brand.navy}"
        },
        "on-primary": {
          "$value": "{color.brand.white}"
        },
        "secondary": {
          "$value": "{color.brand.reef}"
        },
        "surface": {
          "$value": "{color.brand.white}"
        },
        "text": {
          "$value": "{color.brand.navy}"
        },
        "muted": {
          "$value": "{color.ramp.grey.2}"
        },
        "edge": {
          "$value": "{color.ramp.grey.7}"
        }
      }
    }
  },
  "dark": {
    "color": {
      "$type": "color",
      "semantic": {
        "primary": {
          "$value": "{color.brand.reef}"
        },
        "on-primary": {
          "$value": "{color.brand.navy}"
        },
        "secondary": {
          "$value": "{color.brand.sand}"
        },
        "surface": {
          "$value": "{color.brand.navy}"
        },
        "text": {
          "$value": "{color.brand.white}"
        },
        "muted": {
          "$value": "{color.ramp.grey.7}"
        },
        "edge": {
          "$value": "{color.ramp.grey.2}"
        }
      }
    }
  }
}

{
  "manifest_version": 3,
  "name": "Lolly URL Screenshot",
  "version": "0.2.1",
  "description": "Screenshot any URL from the Lolly web app, and read a page's markup, styles and icons, on your command in your browser.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "minimum_chrome_version": "111",
  "permissions": [
    "debugger",
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:5173/*",
        "https://lolly.tools/*",
        "https://*.lolly.tools/*"
      ],
      "js": [
        "inpage.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "http://localhost:5173/*",
        "https://lolly.tools/*",
        "https://*.lolly.tools/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}

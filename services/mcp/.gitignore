# Chromium for the Tier-B render path - installed via `npm run install:browser`
# (playwright-core → this package's scoped browsers dir). Hundreds of MB, machine-
# specific; never committed. Kept inside the package so it travels with the repo
# split (plans/77-mcp-server.md) yet stays out of git and the Vercel function bundle.
.browsers/
.DS_Store
node_modules/
# Dotenv hardening: the real secrets live in deploy/deploy.env (ignored by
# deploy/.gitignore), but ignore any dotenv at the package root too so a stray
# services/mcp/.env can never be committed. See plans/25-secrets-review.md.
.env*
!.env.example

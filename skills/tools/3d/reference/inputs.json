[
  {
    "id": "model",
    "label": "Model",
    "type": "select",
    "default": "duck",
    "help": "A bundled sample model. Upload your own below to override.",
    "options": [
      {
        "value": "duck",
        "label": "Duck"
      },
      {
        "value": "cat",
        "label": "Cat"
      }
    ]
  },
  {
    "id": "modelUpload",
    "label": "Upload a model",
    "type": "file",
    "accept": [
      ".glb",
      ".gltf",
      "model/gltf-binary",
      "model/gltf+json"
    ],
    "maxSize": 33554432,
    "help": "A .glb file (recommended) replaces the sample. It is read on your device and never uploaded."
  },
  {
    "id": "scene",
    "label": "Scene",
    "section": "Scene",
    "type": "select",
    "default": "soft-glow",
    "help": "A lighting + environment preset.",
    "options": [
      {
        "value": "soft-glow",
        "label": "Soft glow"
      },
      {
        "value": "plain",
        "label": "Plain"
      },
      {
        "value": "natural",
        "label": "Natural"
      },
      {
        "value": "bright-studio",
        "label": "Bright studio"
      },
      {
        "value": "serious-studio",
        "label": "Serious studio"
      },
      {
        "value": "fun-gradient",
        "label": "Fun gradient"
      },
      {
        "value": "suse-green",
        "label": "Green"
      }
    ]
  },
  {
    "id": "envIntensity",
    "section": "Scene",
    "label": "Light intensity",
    "type": "number",
    "display": "slider",
    "default": 1,
    "min": 0,
    "max": 3,
    "step": 0.05
  },
  {
    "id": "envRotation",
    "section": "Scene",
    "label": "Environment rotation",
    "type": "number",
    "display": "slider",
    "default": 0,
    "min": 0,
    "max": 360,
    "step": 1
  },
  {
    "id": "background",
    "section": "Rendering",
    "label": "Background",
    "type": "color",
    "default": "#eef1f4"
  },
  {
    "id": "bgColor2",
    "section": "Rendering",
    "label": "Gradient end",
    "type": "color",
    "default": "{color.semantic.secondary}",
    "showIf": {
      "scene": "fun-gradient"
    }
  },
  {
    "id": "transparentBg",
    "section": "Rendering",
    "label": "Transparent background",
    "type": "boolean",
    "default": true,
    "help": "Render on transparency (PNG/WebP keep the alpha)."
  },
  {
    "id": "exposure",
    "section": "Rendering",
    "label": "Exposure",
    "type": "number",
    "display": "slider",
    "default": 1,
    "min": 0.1,
    "max": 3,
    "step": 0.05
  },
  {
    "id": "shadows",
    "section": "Rendering",
    "label": "Contact shadow",
    "type": "boolean",
    "default": true
  },
  {
    "id": "camera",
    "label": "Camera pose",
    "section": "Camera and transform",
    "type": "vector",
    "help": "The base shot. A camera move (below) animates from here.",
    "fields": [
      {
        "id": "fov",
        "label": "Field of view",
        "symbol": "°",
        "min": 20,
        "max": 90,
        "step": 1,
        "default": 45
      },
      {
        "id": "rotation",
        "label": "Rotation",
        "symbol": "°",
        "min": 0,
        "max": 360,
        "step": 1,
        "default": 215
      },
      {
        "id": "tilt",
        "label": "Tilt",
        "symbol": "°",
        "min": -10,
        "max": 80,
        "step": 1,
        "default": 12
      },
      {
        "id": "zoom",
        "label": "Zoom",
        "symbol": "×",
        "min": 0.4,
        "max": 2.5,
        "step": 0.05,
        "default": 1
      },
      {
        "id": "pan",
        "label": "Pan",
        "symbol": "↔",
        "min": -1,
        "max": 1,
        "step": 0.05,
        "default": 0
      }
    ]
  },
  {
    "id": "modelRotate",
    "label": "Rotate model",
    "section": "Camera and transform",
    "type": "vector",
    "help": "Drag the canvas to orbit the model (⌘/Ctrl-drag rolls), or set the angle here in degrees about the model's centre.",
    "fields": [
      {
        "id": "pitch",
        "label": "Pitch",
        "symbol": "°",
        "min": -180,
        "max": 180,
        "step": 1,
        "default": 0
      },
      {
        "id": "yaw",
        "label": "Yaw",
        "symbol": "°",
        "min": -180,
        "max": 180,
        "step": 1,
        "default": 0
      },
      {
        "id": "tilt",
        "label": "Tilt",
        "symbol": "°",
        "min": -180,
        "max": 180,
        "step": 1,
        "default": 0
      }
    ]
  },
  {
    "id": "modelTranslate",
    "label": "Move model",
    "section": "Camera and transform",
    "type": "vector",
    "help": "Shift-drag the canvas to move the model. Offset from centre in model widths (positive Y lifts it off the ground).",
    "fields": [
      {
        "id": "x",
        "label": "X",
        "symbol": "X",
        "min": -2,
        "max": 2,
        "step": 0.05,
        "default": 0
      },
      {
        "id": "y",
        "label": "Y",
        "symbol": "Y",
        "min": -2,
        "max": 2,
        "step": 0.05,
        "default": 0
      },
      {
        "id": "z",
        "label": "Z",
        "symbol": "Z",
        "min": -2,
        "max": 2,
        "step": 0.05,
        "default": 0
      }
    ]
  },
  {
    "id": "modelScale",
    "label": "Scale model",
    "section": "Camera and transform",
    "type": "vector",
    "help": "Alt-drag the canvas to scale. Uniform size multiplier about the model's centre.",
    "fields": [
      {
        "id": "scale",
        "label": "Scale",
        "symbol": "×",
        "min": 0.1,
        "max": 4,
        "step": 0.05,
        "default": 1
      }
    ]
  },
  {
    "id": "cameraMove",
    "label": "Camera move",
    "section": "Animation",
    "type": "select",
    "default": "orbit",
    "help": "A camera animation, separate from any clip baked into the model.",
    "options": [
      {
        "value": "static",
        "label": "Static (no move)"
      },
      {
        "value": "orbit",
        "label": "Orbit 360°"
      },
      {
        "value": "arc",
        "label": "Arc (sweep)"
      },
      {
        "value": "dolly-in",
        "label": "Dolly in"
      },
      {
        "value": "dolly-out",
        "label": "Dolly out"
      },
      {
        "value": "push-in",
        "label": "Push in"
      },
      {
        "value": "custom",
        "label": "Custom keyframes"
      }
    ]
  },
  {
    "id": "duration",
    "section": "Animation",
    "label": "Loop seconds",
    "type": "number",
    "display": "slider",
    "default": 5,
    "min": 1,
    "max": 30,
    "step": 0.5,
    "help": "Seconds for one loop of the move. For a video, set the export Duration to match for a clean loop.",
    "showIf": {
      "cameraMove": [
        "orbit",
        "arc",
        "dolly-in",
        "dolly-out",
        "push-in",
        "custom"
      ]
    }
  },
  {
    "id": "loop",
    "section": "Animation",
    "label": "Loop",
    "type": "boolean",
    "default": true,
    "showIf": {
      "cameraMove": [
        "orbit",
        "arc",
        "dolly-in",
        "dolly-out",
        "push-in",
        "custom"
      ]
    }
  },
  {
    "id": "easing",
    "section": "Animation",
    "label": "Easing",
    "type": "select",
    "default": "ease-in-out",
    "showIf": {
      "cameraMove": [
        "arc",
        "dolly-in",
        "dolly-out",
        "push-in"
      ]
    },
    "options": [
      {
        "value": "linear",
        "label": "Linear"
      },
      {
        "value": "ease-in-out",
        "label": "Ease in-out"
      }
    ]
  },
  {
    "id": "cameraKeyframes",
    "label": "Keyframes",
    "section": "Animation",
    "type": "blocks",
    "showIf": {
      "cameraMove": "custom"
    },
    "help": "Each row is a camera pose at a time (seconds). Interpolated in order.",
    "fields": [
      {
        "id": "time",
        "label": "Time (s)",
        "type": "number",
        "default": 0,
        "min": 0,
        "max": 60,
        "step": 0.1
      },
      {
        "id": "fov",
        "label": "FOV",
        "type": "number",
        "default": 45,
        "min": 20,
        "max": 90,
        "step": 1
      },
      {
        "id": "rotation",
        "label": "Rotation",
        "type": "number",
        "default": 0,
        "min": -720,
        "max": 720,
        "step": 1
      },
      {
        "id": "zoom",
        "label": "Zoom",
        "type": "number",
        "default": 1,
        "min": 0.4,
        "max": 2.5,
        "step": 0.05
      },
      {
        "id": "pan",
        "label": "Pan",
        "type": "number",
        "default": 0,
        "min": -1,
        "max": 1,
        "step": 0.05
      },
      {
        "id": "tilt",
        "label": "Tilt",
        "type": "number",
        "default": 12,
        "min": -10,
        "max": 80,
        "step": 1
      },
      {
        "id": "easing",
        "label": "Easing",
        "type": "select",
        "default": "ease-in-out",
        "options": [
          {
            "value": "linear",
            "label": "Linear"
          },
          {
            "value": "ease-in-out",
            "label": "Ease in-out"
          }
        ]
      }
    ],
    "default": [
      {
        "time": 0,
        "fov": 55,
        "rotation": 0,
        "zoom": 1.4,
        "pan": 0,
        "tilt": 6,
        "easing": "ease-in-out"
      },
      {
        "time": 5,
        "fov": 40,
        "rotation": 120,
        "zoom": 1,
        "pan": 0,
        "tilt": 20,
        "easing": "ease-in-out"
      }
    ]
  },
  {
    "id": "playClip",
    "section": "Model motion",
    "label": "Play model animation",
    "type": "boolean",
    "default": true,
    "help": "Plays the model's own baked clip when it has one."
  },
  {
    "id": "clipIndex",
    "section": "Model motion",
    "label": "Clip",
    "type": "number",
    "default": 0,
    "min": 0,
    "max": 12,
    "step": 1,
    "showIf": {
      "playClip": true
    },
    "help": "Which of the model's baked clips to play, counting from zero."
  },
  {
    "id": "applyTint",
    "section": "Material",
    "label": "Recolour",
    "type": "boolean",
    "default": false
  },
  {
    "id": "tint",
    "section": "Material",
    "label": "Tint",
    "type": "color",
    "default": "{color.semantic.secondary}",
    "showIf": {
      "applyTint": true
    }
  }
]

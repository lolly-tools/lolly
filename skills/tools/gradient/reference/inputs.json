  {
    "id": "rows",
    "label": "Rows",
    "section": "Mesh grid",
    "type": "number",
    "display": "slider",
    "default": 3,
    "min": 2,
    "max": 5,
    "step": 1,
    "showIf": {
      "mode": [
        "subdivide",
        "mesh"
      ]
    },
    "help": "Mesh node rows. Changing the grid re-seeds node colours from the swatches."
  },
  {
    "id": "cols",
    "label": "Columns",
    "section": "Mesh grid",
    "type": "number",
    "display": "slider",
    "default": 3,
    "min": 2,
    "max": 5,
    "step": 1,
    "showIf": {
      "mode": [
        "subdivide",
        "mesh"
      ]
    }
  },
  {
    "id": "curvature",
    "label": "Curvature",
    "section": "Mesh grid",
    "type": "number",
    "display": "slider",
    "default": 55,
    "min": 0,
    "max": 100,
    "step": 1,
    "showIf": {
      "mode": [
        "subdivide",
        "mesh"
      ]
    },
    "help": "How much the grid lines bow between nodes. 0 is straight; 50 is a classic Catmull-Rom mesh. Drag a selected node's square handles to reshape individual tangents."
  },
  {
    "id": "detail",
    "label": "Detail",
    "section": "Mesh grid",
    "type": "number",
    "display": "slider",
    "default": 3,
    "min": 1,
    "max": 4,
    "step": 1,
    "showIf": {
      "mode": "subdivide"
    },
    "help": "Subdivision depth: each patch splits into 4 / 16 / 64 / 256 flat tiles. Low is a deliberate faceted, stained-glass look; high is smoother but a bigger SVG."
  },
  {
    "id": "meshData",
    "label": "Mesh data",
    "section": "Mesh grid",
    "type": "text",
    "default": "",
    "maxLength": 4000,
    "showIf": {
      "mode": [
        "subdivide",
        "mesh"
      ]
    },
    "help": "The mesh itself - written as you drag nodes, handles and colours on the canvas. Clear it (or press reset) to re-seed the grid from the colour swatches."
  },
  {
    "id": "spread",
    "label": "Spread",
    "section": "Texture & motion",
    "type": "number",
    "display": "slider",
    "default": 75,
    "min": 30,
    "max": 140,
    "step": 1,
    "showIf": {
      "mode": [
        "blend",
        "warp"
      ]
    },
    "help": "How far each colour reaches across the frame."
  },
  {
    "id": "blur",
    "label": "Extra blur",
    "section": "Texture & motion",
    "type": "number",
    "display": "slider",
    "default": 6,
    "min": 0,
    "max": 40,
    "step": 1,
    "showIf": {
      "mode": [
        "blend",
        "subdivide"
      ]
    },
    "help": "Melts the colours together. 0 keeps the SVG export filter-free."
  },
  {
    "id": "grain",
    "label": "Grain",
    "section": "Texture & motion",
    "type": "number",
    "display": "slider",
    "default": 50,
    "min": 0,
    "max": 100,
    "step": 1,
    "showIf": {
      "mode": [
        "blend",
        "subdivide"
      ]
    }
  },
  {
    "id": "grainBlend",
    "label": "Grain blend",
    "section": "Texture & motion",
    "type": "select",
    "default": "soft-light",
    "showIf": {
      "mode": [
        "blend",
        "subdivide"
      ]
    },
    "options": [
      {
        "value": "soft-light",
        "label": "Soft light (smooth)"
      },
      {
        "value": "overlay",
        "label": "Overlay (gritty)"
      },
      {
        "value": "luminosity",
        "label": "Luminosity (classic)"
      }
    ]
  },
  {
    "id": "animate",
    "label": "Drift",
    "section": "Texture & motion",
    "type": "boolean",
    "default": false,
    "showIf": {
      "mode": [
        "blend",
        "warp"
      ]
    },
    "help": "Slow, looping drift of the colour points. Export as WebM, MP4 or GIF for a live meeting background."
  },
  {
    "id": "distance",
    "label": "Float distance",
    "section": "Texture & motion",
    "type": "number",
    "display": "slider",
    "default": 100,
    "min": 0,
    "max": 200,
    "step": 5,
    "showIf": {
      "mode": [
        "blend",
        "warp"
      ],
      "animate": true
    },
    "help": "How far the colour points drift from their set position. 100% is the default orbit size; 0% freezes them in place."
  },
  {
    "id": "speed",
    "label": "Float speed",
    "section": "Texture & motion",
    "type": "number",
    "display": "slider",
    "default": 12,
    "min": 4,
    "max": 24,
    "step": 1,
    "showIf": {
      "mode": [
        "blend",
        "warp"
      ],
      "animate": true
    },
    "help": "Seconds per drift loop - higher is slower. A WebM, MP4 or GIF export captures one whole loop, unless you type your own length in the export bar. A very long loop is trimmed to what the export can hold."
  },
  {
    "id": "flowSpeed",
    "label": "Loop length",
    "section": "Waves",
    "type": "number",
    "display": "slider",
    "default": 20,
    "min": 4,
    "max": 60,
    "step": 1,
    "showIf": {
      "mode": "flow"
    },
    "help": "Seconds per wave loop - higher is slower. A WebM, MP4 or GIF export captures one whole loop, unless you type your own length in the export bar."
  },
  {
    "id": "waveScale",
    "label": "Scale",
    "section": "Waves",
    "type": "number",
    "display": "slider",
    "default": 120,
    "min": 30,
    "max": 300,
    "step": 5,
    "showIf": {
      "mode": "flow"
    },
    "help": "Zoom of the wave pattern - lower is bigger, softer shapes."
  },
  {
    "id": "waveAmp",
    "label": "Motion",
    "section": "Waves",
    "type": "number",
    "display": "slider",
    "default": 60,
    "min": 0,
    "max": 100,
    "step": 1,
    "showIf": {
      "mode": "flow"
    },
    "help": "How much the waves churn and travel over a loop."
  },
  {
    "id": "angle",
    "label": "Angle",
    "section": "Waves",
    "type": "number",
    "display": "slider",
    "default": 25,
    "min": 0,
    "max": 360,
    "step": 5,
    "showIf": {
      "mode": "flow"
    }
  },
  {
    "id": "seed",
    "label": "Seed",
    "section": "Waves",
    "type": "number",
    "default": 7,
    "min": 1,
    "max": 999,
    "step": 1,
    "showIf": {
      "mode": "flow"
    },
    "help": "Deterministic variation - the same seed always makes the same waves. The shuffle button picks a new one."
  }
]

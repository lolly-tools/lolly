[
  {
    "id": "locations",
    "label": "Places",
    "type": "blocks",
    "default": [
      {
        "place": "London, GB"
      },
      {
        "place": "Nuremberg, DE"
      },
      {
        "place": "Prague, CZ"
      },
      {
        "place": "Sofia, BG"
      },
      {
        "place": "San Francisco, US"
      },
      {
        "place": "Noosa, AU"
      }
    ],
    "help": "Type a city or IANA timezone in the first column; press Enter for the next row. The other columns are optional: add a country code for an ambiguous city (London, GB), and move rows to set the tour route. Coordinates and a timezone override the lookup.",
    "fields": [
      {
        "id": "label",
        "label": "Label",
        "type": "text",
        "default": ""
      },
      {
        "id": "place",
        "label": "City",
        "type": "text",
        "default": "",
        "placeholder": "London, GB / Europe/London"
      },
      {
        "id": "timezone",
        "label": "Timezone",
        "type": "text",
        "default": "",
        "placeholder": "Europe/London"
      },
      {
        "id": "annotation",
        "label": "Note",
        "type": "text",
        "default": ""
      },
      {
        "id": "color",
        "label": "Colour",
        "type": "color",
        "default": ""
      },
      {
        "id": "spread",
        "label": "Fill region",
        "type": "boolean",
        "default": false
      },
      {
        "id": "longitude",
        "label": "Longitude",
        "type": "text",
        "default": "",
        "placeholder": "-0.12"
      },
      {
        "id": "latitude",
        "label": "Latitude",
        "type": "text",
        "default": "",
        "placeholder": "51.51"
      }
    ],
    "tableColumns": [
      "place",
      "label",
      "annotation",
      "timezone",
      "color",
      "spread",
      "longitude",
      "latitude"
    ]
  },
  {
    "id": "heading",
    "label": "Headline",
    "type": "text",
    "default": "",
    "section": "Story"
  },
  {
    "id": "eyebrow",
    "label": "Overline",
    "help": "A short line above the headline, such as a series name.",
    "type": "text",
    "default": "",
    "section": "Story"
  },
  {
    "id": "annotation",
    "label": "Description",
    "type": "longtext",
    "default": "",
    "section": "Story"
  },
  {
    "id": "footer",
    "label": "Footer line",
    "help": "A closing line under the map, such as a call to action.",
    "type": "text",
    "default": "",
    "section": "Story"
  },
  {
    "id": "timeMode",
    "display": "segmented",
    "label": "Time",
    "type": "select",
    "default": "now",
    "section": "Time",
    "options": [
      {
        "value": "now",
        "label": "Live now"
      },
      {
        "value": "fixed",
        "label": "Scheduled moment"
      }
    ]
  },
  {
    "id": "eventTime",
    "label": "Scheduled date & time",
    "type": "datetime-local",
    "default": "",
    "section": "Time",
    "help": "Interpreted in the reference timezone, never the browser timezone."
  },
  {
    "id": "referenceZone",
    "label": "Reference timezone",
    "type": "text",
    "default": "",
    "section": "Time",
    "help": "Optional reference clock. IANA identifier, e.g. Europe/London. Scheduled times use UTC when blank."
  },
  {
    "id": "ambiguity",
    "label": "Repeated autumn hour",
    "type": "select",
    "default": "earlier",
    "section": "Time",
    "options": [
      {
        "value": "earlier",
        "label": "First occurrence"
      },
      {
        "value": "later",
        "label": "Second occurrence"
      }
    ]
  },
  {
    "id": "eventMinutes",
    "label": "Event duration (minutes)",
    "type": "number",
    "default": 60,
    "section": "Time",
    "min": 1,
    "max": 1440,
    "step": 1,
    "display": "slider"
  },
  {
    "id": "clockStyle",

    "options": [
      {
        "value": "24",
        "label": "24 hour"
      },
      {
        "value": "12",
        "label": "12 hour"
      }
    ]
  },
  {
    "id": "composition",
    "label": "Composition",
    "type": "select",
    "default": "artwork",
    "section": "Map",
    "options": [
      {
        "value": "artwork",
        "label": "Map and details"
      },
      {
        "value": "map",
        "label": "Map only"
      }

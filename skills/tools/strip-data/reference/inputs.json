[
  {
    "id": "source",
    "label": "Image, PDF or Office file",
    "type": "file",
    "accept": [
      "image/jpeg",
      "image/png",
      "image/svg+xml",
      "application/pdf",
      ".jpg",
      ".jpeg",
      ".png",
      ".svg",
      ".pdf",
      ".docx",
      ".pptx",
      ".xlsx",
      ".docm",
      ".pptm",
      ".xlsm",
      ".doc",
      ".ppt",
      ".xls",
      ".xlsb"
    ],
    "maxSize": 52428800,
    "help": "Images, PDFs and supported DOCX properties support metadata removal. Other Office content remains inspect-only. Your file stays on this device."
  },
  {
    "id": "properties",
    "label": "Document property choices",
    "type": "blocks",
    "default": [],
    "fields": [
      {
        "id": "id",
        "label": "Property",
        "type": "text"
      },
      {
        "id": "remove",
        "label": "Remove property",
        "type": "boolean",
        "default": false
      }
    ]
  }
]

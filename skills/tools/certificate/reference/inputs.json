  },
  {
    "id": "logoStyle",
    "label": "Logo version",
    "type": "select",
    "urlKey": "lv",
    "default": "auto",
    "section": "Issuer",
    "showIf": {
      "brandLogo": true
    },
    "help": "Automatic uses the full-colour logo on paper and the one-colour logo on a colour panel or a full-colour sheet. The light or dark version follows the background.",
    "options": [
      {
        "value": "auto",
        "label": "Automatic"
      },
      {
        "value": "colour",
        "label": "Full colour"
      },
      {
        "value": "mono",
        "label": "One colour"
      }
    ]
  },
  {
    "id": "seal",
    "label": "Seal",
    "type": "boolean",
    "urlKey": "se",
    "default": true,
    "section": "Issuer",
    "help": "A seal in the design system's colours. Its mark follows the Kind: a tick, a star or a heart."
  },
  {
    "id": "serial",
    "label": "Reference",
    "type": "text",
    "default": "",
    "maxLength": 60,
    "section": "Issuer",
    "placeholder": "No. 2026-0413",
    "help": "Optional small line at the foot of the sheet. Plain text, exactly as typed - the tool never makes one up."
  },
  {
    "id": "accent",
    "label": "Accent",
    "type": "color",
    "default": "",
    "section": "Colour",
    "help": "Leave empty to follow the design system and its colourway. Classic: the name, the frame and the seal. Minimal: the title, the bar above the title and the seal ring. Modern: the panel and the seal. Celebration: the seal, the bar under the name and the confetti."
  },
  {
    "id": "color",

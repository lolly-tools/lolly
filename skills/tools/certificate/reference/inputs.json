[
  {
    "id": "certKind",
    "label": "Kind",
    "type": "select",
    "urlKey": "k",
    "default": "completion",
    "help": "Sets the wording: the title, the line above what the certificate is for, and the mark on the seal.",
    "options": [
      {
        "value": "completion",
        "label": "Completion"
      },
      {
        "value": "achievement",
        "label": "Achievement"
      },
      {
        "value": "award",
        "label": "Award"
      },
      {
        "value": "appreciation",
        "label": "Appreciation"
      }
    ]
  },
  {
    "id": "firstname",
    "label": "First name",
    "type": "text",
    "default": "Ana",
    "maxLength": 60,
    "bindToProfile": "firstname"
  },
  {
    "id": "lastname",
    "label": "Last name",

[
  {
    "id": "eventName",
    "label": "Event name",
    "type": "text",
    "default": "",
    "placeholder": " "
  },
  {
    "id": "people",
    "label": "Team members",
    "type": "blocks",
    "fields": [
      {
        "id": "name",
        "label": "Name",
        "placeholder": "e.g. Ana Kovac"
      },
      {
        "id": "city",
        "label": "City",
        "placeholder": "e.g. Berlin"
      }
    ],
    "default": [
      {
        "name": "",
        "city": ""
      }
    ]
  },
  {
    "id": "titleWeight",
    "label": "Title weight",
    "type": "number",
    "display": "slider",
    "min": 100,
    "max": 900,
    "step": 100,
    "default": 500,
    "help": "Font weight of the event title (100 Thin to 900 Black)."
  },
  {
    "id": "city",
    "label": "Host city",
    "type": "text",
    "default": "Nuremberg",
    "placeholder": "e.g. Nuremberg",
    "help": "The city where the meeting originates - sets the time zone for the time below.",
    "notice": "City names are looked up at open-meteo.com to find their time zone. Only the name is sent, and each answer stays on your device for offline reuse."
  },
  {
    "id": "meetingTime",
    "label": "Meeting date & time",
    "type": "datetime-local",
    "default": "",
    "help": "Local date and time in the host city. Ignored while Live clock is on."
  },
  {
    "id": "liveClock",
    "label": "Live clock",
    "type": "boolean",
    "default": false,
    "help": "Show the current time everywhere and keep ticking - leave it open as a world-clock widget."
  },
  {
    "id": "theme",
    "label": "Theme",
    "type": "select",
    "default": "light",
    "options": [
      {
        "value": "dark",
        "label": "Dark"
      },
      {
        "value": "light",
        "label": "Light"
      },
      {
        "value": "green",
        "label": "Design system"
      }
    ]
  },
  {
    "id": "layout",
    "label": "Layout",
    "type": "select",
    "default": "landscape",
    "options": [
      {
        "value": "landscape",
        "label": "Landscape"
      },
      {
        "value": "portrait",
        "label": "Portrait"
      },
      {
        "value": "square",
        "label": "Square"
      }
    ]
  },
  {
    "id": "projection",

[
  {
    "id": "textWeight",
    "label": "Text weight",
    "type": "number",
    "display": "slider",
    "min": 100,
    "max": 900,
    "step": 100,
    "default": 600,
    "help": "Stroke weight of the heading, labels and arrows. Needs a variable design system font to show every step."
  },
  {
    "id": "size",
    "label": "Sign size",
    "type": "select",
    "default": "a3",
    "help": "Sets the sign proportions and the export print size. Fine-tune exact dimensions in the export bar.",
    "options": [
      {

        "label": "A2 portrait · 420 × 594 mm",
        "width": 420,
        "height": 594,
        "unit": "mm"
      },
      {
        "value": "a1",
        "label": "A1 portrait · 594 × 841 mm",
        "width": 594,
        "height": 841,
        "unit": "mm"
      },
      {
        "value": "a3land",
        "label": "A3 landscape · 420 × 297 mm",
        "width": 420,
        "height": 297,
        "unit": "mm"
      },
      {
        "value": "a2land",
        "label": "A2 landscape · 594 × 420 mm",
        "width": 594,
        "height": 420,
        "unit": "mm"
      },
      {
        "value": "18x24in",
        "label": "18 × 24 in poster · 457 × 610 mm",
        "width": 457.2,
        "height": 609.6,
        "unit": "mm"
      },
      {
        "value": "24x36in",
        "label": "24 × 36 in poster · 610 × 914 mm",
        "width": 609.6,
        "height": 914.4,
        "unit": "mm"
      }
    ]
  },
  {
    "id": "eventLogo",
    "label": "Event logo",
    "type": "asset",
    "assetType": "any",
    "allowUpload": true,
    "help": "Sits at the top of the sign. Leave empty for no logo."
  },
  {
    "id": "eventName",
    "label": "Event name",
    "type": "text",
    "default": "",
    "maxLength": 60,
    "help": "Shown under the logo. Leave empty to hide it."
  },
  {
    "id": "heading",
    "label": "Sign heading",
    "type": "text",
    "default": "",
    "maxLength": 48,
    "help": "Big title above the directions - e.g. a level, hall or 'Welcome'. Leave empty to hide it."
  },
  {
    "id": "directions",
    "label": "Directions",
    "type": "blocks",
    "help": "Each row is a destination with an arrow. Pick the arrow direction and whether it sits to the left or right of the label.",
    "fields": [
      {
        "id": "label",
        "label": "Destination",
        "type": "text",
        "placeholder": "e.g. Registration"
      },
      {
        "id": "image",
        "label": "Image (instead of text)",
        "type": "asset",
        "assetType": "any",
        "allowUpload": true,
        "help": "Shows a logo or sponsor mark in place of the destination text. The text above is used as the image's alt text and as the fallback when no image is set."
      },
      {
        "id": "arrow",
        "label": "Arrow",
        "type": "select",
        "default": "right",
        "options": [
          {
            "value": "up",
            "label": "↑ Up"
          },
          {
            "value": "up-right",
            "label": "↗ Up-right"
          },
          {
            "value": "right",
            "label": "→ Right"
          },
          {
            "value": "down-right",
            "label": "↘ Down-right"
          },
          {
            "value": "down",
            "label": "↓ Down"
          },
          {
            "value": "down-left",
            "label": "↙ Down-left"
          },
          {
            "value": "left",
            "label": "← Left"
          },
          {
            "value": "up-left",
            "label": "↖ Up-left"
          }
        ]
      },
      {
        "id": "side",
        "label": "Arrow side",
        "type": "select",
        "default": "left",
        "options": [
          {
            "value": "left",
            "label": "Arrow on left"
          },
          {
            "value": "right",
            "label": "Arrow on right"
          }
        ]
      },
      {
        "id": "color",
        "label": "Row colour",
        "type": "color",
        "default": ""
      }
    ],
    "default": [
      {
        "label": "Registration",
        "arrow": "left",
        "side": "left",
        "color": ""
      },
      {
        "label": "Keynote Hall",
        "arrow": "right",
        "side": "right",
        "color": ""
      },
      {
        "label": "Expo & Sponsors",
        "arrow": "up-right",
        "side": "right",
        "color": ""
      },
      {
        "label": "Restrooms",
        "arrow": "down",
        "side": "left",
        "color": ""
      }
    ]
  },
  {
    "id": "background",
    "label": "Background",
    "type": "color",
    "default": "{color.semantic.surface}"
  },
  {
    "id": "accent",
    "label": "Arrow colour",
    "type": "color",
    "default": "{color.semantic.secondary}",
    "help": "Default colour for arrows and rules. A row with its own colour overrides it."
  }
]

[
  {
    "id": "source",
    "label": "PDFs and images",
    "type": "file",
    "multiple": true,
    "accept": [
      "application/pdf",
      ".pdf",
      "image/png",
      ".png",
      "image/jpeg",
      ".jpg",
      ".jpeg",
      "image/webp",
      ".webp",
      "image/gif",
      ".gif",
      "image/avif",
      ".avif",
      "image/heic",
      ".heic",
      "image/heif",
      ".heif",
      "image/bmp",
      ".bmp",
      "image/tiff",
      ".tif",
      ".tiff"
    ],
    "maxSize": 104857600,
    "help": "Choose PDFs, images or both. Every page and image forms one draggable sequence and stays on this device."
  },
  {
    "id": "operation",
    "label": "Operation",
    "type": "select",
    "default": "reorder",
    "options": [
      {
        "value": "reorder",
        "label": "Reorder"
      },
      {
        "value": "rotate",
        "label": "Rotate"
      },
      {
        "value": "extract",
        "label": "Extract"
      },
      {
        "value": "delete",
        "label": "Delete"
      },
      {
        "value": "merge",
        "label": "Merge"
      },
      {
        "value": "split",
        "label": "Split"
      }
    ]
  },
  {
    "id": "pages",
    "label": "Pages",
    "type": "text",
    "default": "1-",
    "maxLength": 20000,
    "help": "1-based pages and ranges, for example 1-3,7,10-. Reorder accepts a new sequence such as 3,1-2. Each comma-separated range becomes a PDF when splitting."
  },
  {
    "id": "previewPage",
    "label": "First preview position",
    "type": "number",
    "default": 1,
    "min": 1,
    "step": 1,
    "help": "View any part of a long page sequence, 30 thumbnails at a time."
  },
  {
    "id": "rotation",
    "label": "Rotation",
    "type": "select",
    "default": "90",
    "showIf": {
      "operation": "rotate"
    },
    "options": [
      {
        "value": "90",
        "label": "90° clockwise"
      },
      {
        "value": "180",
        "label": "180°"
      },
      {
        "value": "270",
        "label": "270° clockwise"
      }
    ]
  },
  {
    "id": "imagePageSize",
    "label": "Image page size",
    "type": "select",
    "default": "image",
    "help": "How pages made from images are sized. A4 and US Letter fit each image inside the page, turned to match the image.",
    "options": [
      {
        "value": "image",
        "label": "Match each image"
      },
      {
        "value": "a4",
        "label": "A4"
      },
      {
        "value": "letter",
        "label": "US Letter"
      }
    ]
  },
  {
    "id": "imageMargin",
    "label": "Image margin (mm)",
    "type": "number",
    "default": 0,
    "min": 0,
    "max": 50,
    "step": 1,
    "showIf": {
      "imagePageSize": [
        "a4",
        "letter"
      ]
    },
    "help": "Space around each image on an A4 or US Letter page."
  }
]

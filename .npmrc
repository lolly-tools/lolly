# Fail `npm install` immediately with a clear "Unsupported engine" message
# (naming the required version) when Node is below the floor in package.json
# "engines" (>=22.18.0), instead of letting install proceed and then crashing
# mid-postinstall with a raw TypeScript syntax error - native type-stripping of
# the .ts scripts needs Node >=22.18 (or >=24). See INSTALL.md.
engine-strict=true

{
  "id": "signature",
  "name": "Signature",
  "description": "Sign with a finger, stylus or mouse and get a clean signature on transparency - SVG or PNG, no scanner, no photo of a bit of paper.",
  "a11yLabel": "Handwritten signature",
  "version": "1.0.0",
  "engineVersion": "^1.0.0",
  "status": "community",
  "category": "everyone",
  "tags": [
    "signature",
    "sign",
    "handwriting",
    "draw",
    "transparent",
    "svg"
  ],
  "render": {
    "width": 1200,
    "height": 400,
    "formats": [
      "svg",
      "penpot",
      "png",
      "webp",
      "avif",
      "pdf"
    ],
    "actions": [
      "copy",
      "download",
      "save"
    ],
    "transparentBg": true,
    "convertPaths": false
  },
  "isolate": true,
  "hooks": {
    "onInit": true,
    "onInput": true,
    "beforeExport": true
  },
  "inputs": [
    {
      "id": "color",
      "label": "Ink",
      "type": "color",
      "default": "",
      "urlKey": "c",
      "help": "The ink colour. Left empty it follows the theme's foreground, so the signature shows up in light and dark alike; pick a colour to pin it."
    },
    {
      "id": "penWidth",
      "label": "Pen width",
      "type": "number",
      "display": "slider",
      "default": 1,
      "min": 0.25,
      "max": 7,
      "step": 0.25,
      "urlKey": "pw",
      "help": "Stroke thickness, in the 1200 x 400 drawing frame."
    },
    {
      "id": "smoothing",
      "label": "Smoothing",
      "type": "number",
      "display": "slider",
      "default": 35,
      "min": 0,
      "max": 100,
      "step": 5,
      "urlKey": "sm",
      "help": "0 keeps the line exactly as recorded. Above 0 the corners are rounded off, which takes the jitter out of a mouse-drawn signature."
    },
    {
      "id": "trim",
      "label": "Trim to the ink",
      "type": "boolean",
      "default": true,
      "urlKey": "tr",
      "help": "Tighten the view to what you drew, plus a small margin, so the signature fills the frame instead of floating in the middle of it."
    },
    {
      "id": "strokes",
      "label": "Stroke data",
      "type": "longtext",
      "rows": 3,
      "default": "m4 13q23 0 39-3m-42 12q2 0 6-7q7-13 11-13c3 0-13 28-6 20c14-14 17-25 11-17s-5 19-7 21s-6 2-2-2l10-9s-5 11-1 7l13-17c-24 31-2 9 2 9s-3 4-5 6s2-1 3 0s-6 4-6 7s11-9 19-9",
      "urlKey": "d",
      "maxLength": 20000,
      "help": "The signature itself, as one SVG path per stroke. The pad writes this for you - every stroke you draw, undo or clear is one edit here, so it rides undo, share links and saves. Long signatures make long links: the pad drops points closer than a few units apart to keep them short, and past a few hundred strokes a link gets unwieldy."
    }
  ],
  "examples": [
    {
      "label": "Flowing script",
      "values": {
        "strokes": "M150,240L173,217L197,200L228,195L259,211L283,232L306,252L337,265L368,256L392,236L415,213L439,194L470,188L493,202L517,228L540,259L563,286L587,301L618,296L641,276L665,249L688,226L712,216L743,229L766,257L782,279L797,301L821,326L852,333L875,315L891,294L907,269L922,245L930,233 M180,318L278,326L377,333L475,338L574,339L672,337L770,331L869,322L967,312L984,310L1000,308 M812,150L814,152",
        "color": "#1f2937",
        "penWidth": 7,
        "smoothing": 45,
        "trim": true
      },
      "theme": "light"
    },
    {
      "label": "Printed initials",
      "values": {
        "strokes": "M420,300L428,282L437,264L445,246L454,228L462,210L470,192L479,174L487,156 M490,150L498,168L507,186L515,204L524,222L532,240L540,258L549,276L557,294 M452,240L528,240 M600,150L600,300 M600,152L688,148 M600,226L664,224 M400,332L432,334L464,337L496,338L528,340L560,340L592,340L624,338L656,337L688,334L720,332",
        "color": "#1d4ed8",
        "penWidth": 9,
        "smoothing": 10,
        "trim": true
      },
      "theme": "light"
    },
    {
      "label": "Marker, one stroke",
      "values": {
        "strokes": "M240,206L271,175L302,149L331,130L372,121L406,138L434,175L450,208L463,241L475,272L491,306L526,304L549,272L568,244L589,216L613,192L640,175L684,168L715,177L746,197L777,224L808,256L837,289L864,320L888,343L920,361L953,344L959,334",
        "color": "#111111",
        "penWidth": 18,
        "smoothing": 70,
        "trim": true
      },
      "theme": "light"
    }
  ]
}

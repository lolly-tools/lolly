#!/usr/bin/env sh
# Local vernacular gate before source publication. Main pushes run CI; production
# application releases use their reviewed target and qualified artifacts. A source
# push does not deploy infrastructure. Emergency bypass: git push --no-verify.
root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1
printf '→ pre-push: vernacular gate…\n'
pnpm --silent run check:code-comments || { printf '\n✗ code-comment vernacular failed - fix, or bypass with: git push --no-verify\n'; exit 1; }
node scripts/check-docs-vernacular.ts   || { printf '\n✗ docs vernacular failed - fix, or bypass with: git push --no-verify\n'; exit 1; }
printf '✓ vernacular clean\n'

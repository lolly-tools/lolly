#!/usr/bin/env bash
# loldev — one command for developing the lolly monorepo across its lolly-tools
# submodules. Install puts it on your PATH (see `loldev help`). Works from any cwd;
# operates on $LOLLY_ROOT (default ~/Build/lolly, override with the env var).
#
#   loldev gtg [-m "msg"] [--force] [--no-build]
#       "good to go" — typecheck + full test suite + build/validate the catalog
#       for EVERY live profile (gate, see SHIP_TARGETS in config.sh; the tests
#       include the privacy-claim guards in tests/no-trackers.test.ts), then
#       commit + push every
#       changed submodule to its own repo AND the parent, to the correct place.
#       No -m → empty commit message. First push after the history rewrite
#       needs --force (once).
#   loldev push [-m "msg"] [--force]   gtg without the catalog rebuild
#   loldev ship [-m "msg"] [--preview] gtg, THEN deploy EVERY SHIP_TARGETS project to
#                                      Vercel uniformly (prod; --preview = preview URLs)
#   loldev status | st                 what's dirty / ahead, per repo
#   loldev build                       build:catalog + validate:catalog
#   loldev previews [--preserve]       regenerate look/card thumbnails (slow, Playwright) — opt-in, run when a tool's look changes.
#                                      Overwrites every preview (now stamped: Imprint + C2PA); --preserve keeps existing, fills gaps only.
#   loldev og [--preserve]             rebuild ALL the per-tool + per-view OG share cards, for EVERY mounted profile (catalog/og/*
#                                      is committed per brand, so an active-profile-only run leaves the other brand stale — same
#                                      drift as build:catalog:all fixes). Playwright, opt-in. Overwrites every card (stamped:
#                                      Imprint + C2PA); --preserve keeps existing, fills gaps only. Active profile restored, its
#                                      stubs rebuilt last. (/info-page OG rebuilds with the docs site — build:info / `build:web`.)
#   loldev shots [--accept|--only=…]   capture + compare the docs screenshots (url-shot recipe links in docs/*.md → docs/shots/); also runs inside every gtg
#   loldev shots --rebuild             full refresh: rebuild the shell, re-shoot EVERY recipe, write every baseline (even
#                                      unchanged) and prune retired files. What you want after an engine/renderer change.
#   loldev verify [--clone]            full post-split build/run verification
#   loldev profile [name] [--copy]     show or switch the content profile (suse / lolly-start):
#                                      rebuilds the tools/ + catalog/ views from the packs
#   loldev pull | up                   pull parent + update all submodules + refresh the profile views
#   loldev dev                         run the web shell (npm run dev:web)
#   loldev cli -- <args>               run a tool headlessly (npm run cli)
#   loldev help

LOLLY_ROOT="${LOLLY_ROOT:-$HOME/Build/lolly}"
SUB="$LOLLY_ROOT/scripts/subrepo"
if [ ! -f "$SUB/config.sh" ]; then
  echo "loldev: can't find $SUB/config.sh — set LOLLY_ROOT to your lolly checkout." >&2; exit 1
fi
# shellcheck source=/dev/null
source "$SUB/config.sh"
set +e +u   # interactive resilience — keep going across submodules, handle errors inline
cd "$REPO_ROOT" || { echo "loldev: cannot cd $REPO_ROOT" >&2; exit 1; }

usage() { awk 'NR>1 && /^#/ {sub(/^# ?/,""); print; next} NR>1 {exit}' "${BASH_SOURCE[0]}"; }

# Submodules gtg must VISIT. Dirty is not enough: a submodule that was committed
# by hand (or by a previous half-finished gtg) but never pushed has a CLEAN status,
# so keying on `status --porcelain` alone skipped it — and the parent was then
# pushed anyway, publishing a pointer to a SHA that exists on nobody's remote.
# That breaks `git submodule update --init --recursive` for every clone, every CI
# run and every Vercel git build. Observed three times on 2026-07-30.
# `@{u}..HEAD` is local-only (no network); a submodule with no upstream configured
# is yielded too, so the push attempt reports the real reason rather than silence.
changed_submodules() {
  local p ahead
  while read -r p; do
    [ -n "$(git -C "$p" status --porcelain 2>/dev/null)" ] && { echo "$p"; continue; }
    ahead=$(git -C "$p" rev-list --count '@{u}..HEAD' 2>/dev/null)
    if [ -z "$ahead" ]; then
      # No upstream (or detached) — only interesting if it actually has commits.
      git -C "$p" rev-parse --verify -q HEAD >/dev/null 2>&1 && echo "$p"
    elif [ "$ahead" -gt 0 ]; then
      echo "$p"
    fi
  done < <(subrepo_paths)
}

GATE_TEST_LOG="${TMPDIR:-/tmp}/loldev-gate-test.log"

do_build() {
  phase "🔍" "Build gate"
  step "type-checking every project"
  npm run --silent typecheck || { err "typecheck failed — fix it, or run 'loldev push' to bypass the build gate"; return 1; }
  ok "typecheck passed"

  # The full node:test suite — including tests/no-trackers.test.ts, which is
  # where the privacy policy's checkable claims (no analytics SDK, no DoH
  # resolver, no CA issuance log) are actually enforced. A ship gate that skips
  # the tests is how a green deploy once carried 4 failing recorder tests; and
  # skipping the privacy guards specifically would let a deploy contradict the
  # published policy. Run BEFORE the catalog loop below switches profiles, while
  # the checkout still looks like the developer's own.
  step "running the test suite"
  # Keep the output. Discarding it meant a failed gate cost a full 46 s re-run of
  # `npm test` just to read WHICH test failed. PIPESTATUS keeps the suite's exit
  # status authoritative through the tee.
  npm run --silent test >"$GATE_TEST_LOG" 2>&1
  [ "${PIPESTATUS[0]:-$?}" -eq 0 ] || { err "tests failed — see $GATE_TEST_LOG (or re-run: npm test)"; return 1; }
  ok "tests passed"

  # build:catalog re-rolls catalog/previews/bundle.json (pure filesystem, no browser).
  # The heavy Playwright card/look render is a separate, opt-in `loldev previews`.
  # Every SHIP_TARGETS profile feeds a live site (bt=suse, lolly-start=lolly-start) —
  # validate each one's catalog, not just whichever profile happens to be checked
  # out locally, so a push can't silently break the site we're not developing in.
  local starting; starting="$(cat "$REPO_ROOT/.lolly-profile" 2>/dev/null)"
  local entry name id profile domain seen=()
  for entry in "${SHIP_TARGETS[@]}"; do
    IFS='|' read -r name id profile domain <<<"$entry"
    [[ " ${seen[*]:-} " == *" $profile "* ]] && continue   # dedupe shared profiles
    seen+=("$profile")
    step "building + validating the '$profile' catalog ($domain)"
    node scripts/use-profile.ts "$profile" >/dev/null 2>&1 \
      || { err "profile '$profile' isn't mounted here — can't validate $domain before push"; return 1; }
    npm run --silent build:catalog    || { err "build:catalog failed for profile '$profile'";    return 1; }
    npm run --silent validate:catalog || { err "validate:catalog failed for profile '$profile'"; return 1; }
    ok "'$profile' catalog built + validated"
  done
  # Restore the pre-gate profile. If none was set (fresh checkout / no
  # .lolly-profile), the loop above leaves the LAST-iterated SHIP_TARGET
  # (lolly-start) pinned locally — that is exactly the stale sticky state that
  # once leaked the blank brand into a lolly.tools deploy. Fall back to
  # $LOLLY_PROFILE, else profiles.json's default, so we never silently pin the
  # blank brand on someone who never chose one.
  local restore="$starting"
  [ -z "$restore" ] && restore="${LOLLY_PROFILE:-$(node -e 'process.stdout.write(require("./profiles.json").default||"")' 2>/dev/null)}"
  [ -n "$restore" ] && node scripts/use-profile.ts "$restore" >/dev/null 2>&1

  # Docs screenshots — capture the web shell (pinned to the neutral lolly-start
  # brand; the script switches + restores the profile itself) at every url-shot
  # recipe link written inline in docs/*.md and compare against the committed
  # docs/shots/ baselines (scripts/build-docs-shots.ts — Chromium + a local vite
  # build, so this only runs on a build machine, never on Vercel). Exit 2 = shots
  # changed: warn but keep going — the committed (still-valid) baselines ship;
  # promoting new pixels is a deliberate `npm run docs:shots -- --accept`. Any
  # other failure blocks the gate.
  step "docs screenshots (capture + compare, lolly-start brand)"
  npm run --silent docs:shots
  local shotrc=$?
  if [ "$shotrc" = 0 ]; then ok "docs screenshots verified"
  elif [ "$shotrc" = 2 ]; then warn "docs screenshots CHANGED — review, then promote with: npm run docs:shots -- --accept"
  else err "docs screenshot capture failed"; return 1
  fi
}

# Pretty end-of-run tally. Reads the PUSHED / FAILED / NOOP globals gtg fills in.
# $1 = elapsed seconds, $2 = headline emoji+verb ("✨ Good to go" / "🚀 Shipping").
gtg_summary() {
  local secs="$1" head="$2" n=${#PUSHED[@]} f=${#FAILED[@]} x
  echo
  rule
  if [ "$f" -eq 0 ]; then
    printf "  ${c_bold}${c_grn}%s${c_reset}  ${c_gray}·  %s repo(s) in %ss${c_reset}\n" "$head" "$n" "$secs"
  else
    printf "  ${c_bold}${c_red}✗  finished with %s failure(s)${c_reset}  ${c_gray}·  %ss${c_reset}\n" "$f" "$secs"
  fi
  for x in "${PUSHED[@]}"; do printf "     ${c_grn}⬆${c_reset}  ${c_white}%s${c_reset}\n" "$x"; done
  for x in "${NOOP[@]}";   do printf "     ${c_gray}·  %s — unchanged${c_reset}\n" "$x"; done
  for x in "${FAILED[@]}"; do printf "     ${c_red}✗  %s${c_reset}\n" "$x"; done
  rule
}

gtg() {
  local MSG="" FORCE=0 NOBUILD=0 title="loldev gtg" blurb="good to go · commit + push every changed repo"
  while [ $# -gt 0 ]; do
    case "$1" in
      -m|--message) shift; MSG="${1:-}" ;;
      -f|--force)   FORCE=1 ;;
      --no-build)   NOBUILD=1; title="loldev push"; blurb="fast lane · commit + push, no build gate" ;;
      *) warn "gtg: ignoring '$1'" ;;
    esac; shift
  done

  local start=$SECONDS
  PUSHED=(); FAILED=(); NOOP=()   # globals — read back in gtg_summary
  banner "🍭" "$title" "$blurb"

  if [ "$NOBUILD" = 1 ]; then
    phase "⏩" "Build gate"; info "skipped (push mode)"
  else
    do_build || { err "build failed — not pushing"; return 1; }
  fi

  # What `git add -A` below is about to sweep up, printed BEFORE it happens.
  # gtg stages the entire working tree, so anything a concurrent session (another
  # agent, another terminal, an editor's autosave) has in flight gets committed and
  # pushed under THIS run's message. That happened twice on 2026-07-30. A lock does
  # not help — the other writer is not gtg — but seeing the list does: an unexpected
  # path here is the cue to stop. Cheap, non-interactive, and it never blocks.
  show_sweep_scope() {
    local p n files
    phase "👀" "About to commit"
    for p in $(subrepo_paths) "."; do
      n=$(git -C "$p" status --porcelain 2>/dev/null | grep -cv '^ m ' )
      [ "${n:-0}" -eq 0 ] && continue
      files=$(git -C "$p" status --porcelain 2>/dev/null | grep -v '^ m ' \
              | awk '{print $NF}' | head -6 | tr '\n' ' ')
      printf "     %-26s %3s file(s)  %s%s\n" \
        "$([ "$p" = "." ] && echo "(parent)" || echo "$p")" "$n" "$files" \
        "$([ "$n" -gt 6 ] && echo '…')"
    done
  }
  show_sweep_scope

  # 1. each changed submodule → its own repo
  phase "📦" "Submodules"
  local any=0 p repo out
  while read -r p; do
    [ -z "$p" ] && continue
    any=1; repo="$ORG/$(repo_for_path "$p")"
    step "$p  →  $repo"
    git -C "$p" add -A
    # Commit if there is anything to commit — but PUSH REGARDLESS. These used to be
    # nested, so "nothing to commit" also meant "nothing pushed", which is half of
    # the unpushed-pointer bug above (the other half was never visiting the repo).
    git -C "$p" commit --allow-empty-message -m "$MSG" >/dev/null 2>&1
    if [ -z "$(git -C "$p" log '@{u}..HEAD' --oneline 2>/dev/null)" ] \
       && git -C "$p" rev-parse --abbrev-ref '@{u}' >/dev/null 2>&1; then
      warn "$p — already up to date"; NOOP+=("$p")
    elif out=$(git -C "$p" push 2>&1); then
      ok "pushed $p"; PUSHED+=("$p  →  $repo")
    else
      err "push failed: $p"; printf '%s\n' "$out" | sed "s/^/        ${c_red}│${c_reset} /"; FAILED+=("$p (push)")
    fi
    git add "$p"   # stage the pointer bump in the parent
  done < <(changed_submodules)
  [ "$any" = 0 ] && info "no submodule changes"

  # 2. parent (pointer bumps + parent-owned files) → lolly-tools/lolly
  phase "🌳" "Parent repo"
  git add -A
  if git diff --cached --quiet; then
    info "nothing new to commit"
  else
    git commit --allow-empty-message -m "$MSG" >/dev/null 2>&1 && ok "committed pointer bumps"
  fi
  step "push parent  →  $ORG/lolly"
  if [ "$FORCE" = 1 ]; then out=$(git push --force origin HEAD:main 2>&1); else out=$(git push origin HEAD:main 2>&1); fi
  if [ $? -eq 0 ]; then
    ok "parent pushed"; PUSHED+=("(parent)  →  $ORG/lolly")
  else
    printf '%s\n' "$out" | sed "s/^/        ${c_red}│${c_reset} /"
    err "parent push rejected — the FIRST push after the history rewrite needs:  loldev gtg --force"
    FAILED+=("(parent)")
  fi

  gtg_summary $((SECONDS - start)) "✨ Good to go!"
  [ "${#FAILED[@]}" -eq 0 ]   # exit status reflects success/failure
}

# --- Vercel deploy plumbing (used by ship()) --------------------------------
# All of these assume VERCEL_ORG_ID/VERCEL_PROJECT_ID are exported to scope the
# target project (ship() sets them per iteration). Tunables are env-overridable;
# each also carries a `${VAR:-default}` at its use site so an empty override under
# `set +u` can never zero an arithmetic/loop bound.
WAIT_READY_TIMEOUT="${LOLDEV_WAIT_READY_TIMEOUT:-900}"   # max s to wait for a build to reach READY
WAIT_READY_POLL="${LOLDEV_WAIT_READY_POLL:-15}"          # s between readyState polls
ALIAS_FLIP_TIMEOUT="${LOLDEV_ALIAS_FLIP_TIMEOUT:-120}"   # max s for the prod domain to repoint to our deployment
DEPLOY_UPLOAD_TRIES="${LOLDEV_DEPLOY_UPLOAD_TRIES:-3}"   # bounded upload retries (large-archive finalize-POST drop)

# Read one field from `vercel inspect <target> --json`. --json is machine-readable
# (the human table prints title-case '● Ready', NOT the API token READY, so never
# grep the human output). $1=deployment-url | https://domain   $2=field.
_inspect_field() {
  npx --yes vercel inspect "$1" --json 2>/dev/null | node -e '
    const f = process.argv[1]; let s = "";
    process.stdin.on("data", c => s += c).on("end", () => {
      try { process.stdout.write(String(JSON.parse(s)[f] ?? "")); } catch (e) {}
    });' "$2"
}
deployment_id()    { _inspect_field "$1" id; }          # id of a deployment URL
deployment_state() { _inspect_field "$1" readyState; }  # readyState of a deployment URL
domain_live_id()   { _inspect_field "https://$1" id; }  # id of the deployment a DOMAIN currently serves

# Newest PRODUCTION deployment URL for the scoped project (empty on none/error).
newest_prod_url() {
  npx --yes vercel ls --prod 2>/dev/null | grep -Eo 'https://[a-z0-9-]+\.vercel\.app' | head -1
}

# Poll a deployment URL to a terminal state. Prints ONLY the final token to stdout
# (progress to stderr, so `state=$(wait_ready ...)` captures a single clean token).
# Return: 0=READY, 1=ERROR/CANCELED, 2=timeout. Anything that is not an EXACT
# READY / ERROR / CANCELED token — QUEUED/INITIALIZING/BUILDING/UPLOADING, an empty
# read, a failed `vercel inspect`, an unrecognised token — is treated as "keep
# polling", so a transient inspect hiccup is never misread as a build failure (that
# would just move the original false-failure bug from the log stream to this poll).
wait_ready() {
  local url="$1" waited=0 st
  while [ "$waited" -lt "${WAIT_READY_TIMEOUT:-900}" ]; do
    st="$(deployment_state "$url")"
    case "$st" in
      READY)          printf READY;     return 0 ;;
      ERROR|CANCELED) printf '%s' "$st"; return 1 ;;
      *)              printf '    build state: %s (%ss/%ss)\n' "${st:-querying}" "$waited" "${WAIT_READY_TIMEOUT:-900}" >&2 ;;
    esac
    sleep "${WAIT_READY_POLL:-15}"; waited=$((waited + ${WAIT_READY_POLL:-15}))
  done
  printf timeout; return 2
}

# Post-deploy brand assertion. The brand a project actually builds is governed
# ENTIRELY by its Vercel LOLLY_PROFILE env — which this toolkit never sets and,
# until now, never checked. A missing/typo'd env silently ships the wrong brand
# to a live domain while ship() still prints a green banner (it once shipped the
# blank brand to lolly.tools). This reads the freshly-deployed domain's catalog
# and FAILS the ship if the live tool set doesn't match the set the target's
# declared profile is supposed to serve. Prod only — a preview deploy gets a
# throwaway URL and never updates the domain alias, so there's nothing to assert.
# $1=profile  $2=domain  $3=project id (for the hint).
verify_deploy() {
  local profile="$1" domain="$2" id="$3" expected actual got="" tries=0
  expected="$(node -e 'const p=require("./profiles.json").profiles[process.argv[1]];if(!p)process.exit(3);process.stdout.write(String((require("./"+p.catalog+"/tools/index.json").tools||[]).length))' "$profile" 2>/dev/null)"
  if [ -z "$expected" ]; then
    warn "verify: can't read the expected catalog for profile '$profile' — skipping brand assertion for $domain"
    return 0
  fi
  step "verifying $domain is serving the '$profile' brand (expecting $expected tools)"
  while [ "$tries" -lt 6 ]; do
    actual="$(curl -fsS --max-time 30 "https://$domain/catalog/tools/index.json" 2>/dev/null \
      | node -e 'let s="";process.stdin.on("data",c=>s+=c).on("end",()=>{try{process.stdout.write(String((JSON.parse(s).tools||[]).length))}catch(e){process.stdout.write("")}})' 2>/dev/null)"
    [ -n "$actual" ] && got="$actual"
    [ "$actual" = "$expected" ] && { ok "verify: $domain serving '$profile' — $actual tools live"; return 0; }
    tries=$((tries + 1)); sleep 5
  done
  # Never got a readable count. ship() only calls verify_deploy AFTER confirming the
  # domain already resolves to our READY deployment, so an unreadable catalog here is
  # a transient CDN/network blip, not a wrong brand — don't hard-fail a live deploy.
  if [ -z "$got" ]; then
    warn "verify: could not read $domain/catalog after $tries checks — deploy is live + READY, brand unconfirmed (transient?)"
    return 0
  fi
  err "verify: $domain shipped the WRONG brand — expected profile '$profile' ($expected tools) but the live catalog shows '$got'"
  err "  the deploy is live but built the wrong brand. Check this project's LOLLY_PROFILE env:"
  err "    VERCEL_ORG_ID=$VERCEL_TEAM_ID VERCEL_PROJECT_ID=$id npx vercel env ls"
  return 1
}

# ship = gtg (build + commit + push to GitHub) THEN deploy to Vercel — EVERY
# project in SHIP_TARGETS, uniformly (currently `bt`→lolly.tools/SUSE and
# `lolly-start`→lolly.art/blank brand), so `loldev ship` never leaves one site
# stale relative to the other. Uses `npx vercel` (CLI not installed globally) +
# cached auth (andyfitz); VERCEL_ORG_ID/VERCEL_PROJECT_ID env overrides pick the
# target project per deploy without touching the local `.vercel/` link (stays
# pointed at `bt`, e.g. for `vercel dev`). --archive=tgz tarballs the LOCAL tree
# for every target, so submodule content ships and Vercel compiles api/
# functions. The brand each target builds is PINNED per-deploy from SHIP_TARGETS
# via `--build-env LOLLY_PROFILE=<profile>` (repo = source of truth), so the right
# profile — and therefore the whole brand: palette, tokens, fonts, tools, catalog —
# always lands on the right domain regardless of dashboard/local state. Deploys use
# --no-wait so the CLI's flaky post-upload wait can never false-fail a good build:
# success is read from Vercel's own readyState, then BOUND to our deployment id
# promoting to the domain, and verify_deploy asserts the brand on it. A dropped upload
# (no deployment created) is retried; a build ERROR/timeout is a real, reported failure.
# --preview → preview URLs instead of prod (liveness checked directly, no domain alias).
ship() {
  local PREVIEW=0 gargs=() a
  for a in "$@"; do [ "$a" = "--preview" ] && PREVIEW=1 || gargs+=("$a"); done
  gtg "${gargs[@]}" || { err "gtg failed — not deploying"; return 1; }

  local tgt flags
  if [ "$PREVIEW" = 1 ]; then tgt="PREVIEW"; flags=(); else tgt="PRODUCTION"; flags=(--prod); fi

  local -a SHIPPED=() SFAILED=()
  local entry name id profile domain log rc url our_id state snap try rtry live waited line
  trap 'rm -f "${log:-}"' RETURN   # backstop if ship() returns/interrupts mid-upload
  for entry in "${SHIP_TARGETS[@]}"; do
    IFS='|' read -r name id profile domain <<<"$entry"
    phase "🚀" "Deploy → Vercel ($name → $domain, $profile · $tgt)"

    # Scope every vercel call this iteration to the target project via the env
    # overrides — never touches the local .vercel/ link (stays pointed at bt for
    # `vercel dev`). Cleared by the single unset after the loop.
    export VERCEL_ORG_ID="$VERCEL_TEAM_ID" VERCEL_PROJECT_ID="$id"

    # --- 1. upload + queue the build (bounded retry) ------------------------
    # --no-wait: the CLI creates + uploads the deployment, prints its *.vercel.app
    # URL, and exits WITHOUT holding open the build-log stream that drops on flaky
    # links. So this exit code reflects only the UPLOAD; the build's real outcome is
    # read from Vercel's own readyState in step 2 — the CLI's transport reliability no
    # longer decides success (THAT was the "fails despite a successful deploy" bug).
    # PIN the brand per-build from SHIP_TARGETS (repo = source of truth); the project
    # dashboard LOLLY_PROFILE stays as the fallback for git-integration auto-deploys.
    # node_modules and .git are NOT in the tarball — Vercel default-ignores both and
    # .vercelignore lists node_modules too — so there is no node_modules parking ritual.
    url=""; rc=0
    snap="$(newest_prod_url)"
    for (( try=1; try<="${DEPLOY_UPLOAD_TRIES:-3}"; try++ )); do
      step "tarballing + queuing on Vercel (LOLLY_PROFILE=$profile · upload $try/${DEPLOY_UPLOAD_TRIES:-3})"
      log="$(mktemp -t loldev-ship.XXXXXX)"
      npx --yes vercel deploy "${flags[@]}" --archive=tgz --no-wait \
        --build-env "LOLLY_PROFILE=$profile" --yes 2>&1 | tee "$log"
      rc=${PIPESTATUS[0]}
      # The deployment URL is the *.vercel.app host on stdout — NEVER the vercel.com
      # Inspect dashboard link (which `vercel inspect` cannot resolve). Restrict the match.
      url="$(grep -Eo 'https://[a-z0-9-]+\.vercel\.app' "$log" | tail -1)"
      rm -f "$log"
      [ -n "$url" ] && break
      # No URL printed — a large-archive finalize-POST likely dropped before creating
      # the deployment. Give a just-queued deploy a few seconds to surface (ls is
      # eventually consistent), adopt it if one appeared, else retry the upload. A
      # rare concurrent git-integration deploy could be adopted here; the step-3 prod
      # identity + brand gate below still validates whatever is live, so it is safe.
      warn "no deployment URL (exit $rc) — checking whether one was created…"
      for (( rtry=1; rtry<=5; rtry++ )); do
        url="$(newest_prod_url)"
        [ -n "$url" ] && [ "$url" != "$snap" ] && break
        url=""; sleep 6
      done
      [ -n "$url" ] && { warn "adopted $url (stdout lost; a new deployment exists)"; break; }
      warn "no deployment created — retrying the upload"
    done

    if [ -z "$url" ]; then
      err "vercel deploy created no deployment: $name (last exit $rc)"
      SFAILED+=("$name → $domain (upload failed)"); continue
    fi
    our_id="$(deployment_id "$url")"

    # --- 2. wait for the SERVER to finish the build -------------------------
    step "waiting for $name to build ($url · readyState ≤$(( ${WAIT_READY_TIMEOUT:-900} / 60 ))m)"
    state="$(wait_ready "$url")"; rc=$?
    if [ "$rc" -eq 1 ]; then
      err "vercel build FAILED: $name — deployment $state"
      err "  logs:  VERCEL_ORG_ID=$VERCEL_TEAM_ID VERCEL_PROJECT_ID=$id npx vercel inspect $url --logs"
      SFAILED+=("$name → $domain (build $state)"); continue
    fi
    if [ "$rc" -ne 0 ]; then
      # Timeout with NO confirmed READY. Fail CLOSED — do NOT "rescue" via the domain
      # brand check: on a same-brand redeploy the PREVIOUS deployment already serves
      # the right brand, so a brand match here would falsely pass a stuck/slow build.
      err "vercel build did not reach READY within ${WAIT_READY_TIMEOUT:-900}s: $name (last: ${state:-unknown})"
      err "  raise LOLDEV_WAIT_READY_TIMEOUT or re-check:  npx vercel inspect $url"
      SFAILED+=("$name → $domain (build timeout)"); continue
    fi
    ok "$name build READY ($our_id)"

    # --- 3. success is authoritative on OUR deployment ----------------------
    if [ "$PREVIEW" = 1 ]; then
      # No domain alias to assert — READY plus a 200 from the deployment URL is success.
      if curl -fsI --max-time 30 "$url" >/dev/null 2>&1; then SHIPPED+=("$name → $url")
      else SFAILED+=("$name → $url (READY but not serving)"); fi
      continue
    fi
    # Prod: a --prod build auto-promotes to the domain once READY. WAIT for the domain
    # to actually resolve to OUR deployment id before trusting the brand check —
    # otherwise verify_deploy could read the PREVIOUS same-brand deployment and pass
    # while ours hasn't gone live. This is what binds success to deployment identity
    # (a blocking `vercel deploy` used to give this for free; --no-wait does not).
    waited=0; live=""
    while [ "$waited" -lt "${ALIAS_FLIP_TIMEOUT:-120}" ]; do
      live="$(domain_live_id "$domain")"
      [ "$live" = "$our_id" ] && break
      sleep 6; waited=$((waited + 6))
    done
    if [ "$live" != "$our_id" ]; then
      err "$domain did not promote to our deployment within ${ALIAS_FLIP_TIMEOUT:-120}s (ours=$our_id, live=${live:-none})"
      SFAILED+=("$name → $domain (built READY but never promoted)"); continue
    fi
    # The domain now serves OUR deployment — assert the brand it built is correct.
    if verify_deploy "$profile" "$domain" "$id"; then
      line="$domain"; [ -n "$url" ] && line="$line  ·  $url"
      SHIPPED+=("$line")
    else
      SFAILED+=("$name → $domain (deployed, but the WRONG brand is live)")
    fi
  done
  unset VERCEL_ORG_ID VERCEL_PROJECT_ID

  echo
  rule
  if [ "${#SFAILED[@]}" -eq 0 ]; then
    printf "  ${c_bold}${c_grn}🎉  Shipped!${c_reset}  ${c_gray}·  %s site(s) live on Vercel${c_reset}\n" "${#SHIP_TARGETS[@]}"
  else
    printf "  ${c_bold}${c_red}✗  %s/%s site(s) failed to deploy${c_reset}\n" "${#SFAILED[@]}" "${#SHIP_TARGETS[@]}"
  fi
  for line in "${SHIPPED[@]}"; do printf "     ${c_cyan}🌐  %s${c_reset}\n" "$line"; done
  for line in "${SFAILED[@]}"; do printf "     ${c_red}✗  %s${c_reset}\n" "$line"; done
  rule
  [ "${#SFAILED[@]}" -eq 0 ]
}

cmd="${1:-help}"; [ $# -gt 0 ] && shift
case "$cmd" in
  gtg)          gtg "$@" ;;
  push)         gtg --no-build "$@" ;;
  ship)         ship "$@" ;;
  status|st)    bash "$SUB/status.sh" ;;
  build)        do_build ;;
  validate)     npm run validate:catalog ;;
  previews)     case " $* " in *" --preserve "*) export LOLLY_PRESERVE=1 ;; esac; npm run previews ;;
  og)           case " $* " in *" --preserve "*) export LOLLY_PRESERVE=1 ;; esac; npm run og:all ;;
  shots)        npm run docs:shots -- "$@" ;;
  verify)       bash "$SUB/verify.sh" "$@" ;;
  profile|brand) node scripts/use-profile.ts "$@" ;;
  pull|up)      git pull --ff-only origin main && git submodule update --init --recursive \
                  && node scripts/use-profile.ts --auto \
                  && ok "synced parent + submodules + profile views" ;;
  dev)          npm run dev:web ;;
  cli)          npm run cli -- "$@" ;;
  help|-h|--help) usage ;;
  *)            err "unknown command: $cmd"; echo; usage; exit 2 ;;
esac

{
  "id": "text-helper",
  "name": "Text",
  "description": "Find, edit, understand and transform text. Browse brand characters and emoji, work with code and logs, or create ASCII lettering.",
  "version": "2.0.0",
  "engineVersion": "^1.191.0",
  "status": "official",
  "category": "utility",
  "privacy": "on-device",
  "tags": [
    "privacy",
    "json",
    "yaml",
    "helm",
    "kubernetes",
    "jwt",
    "base64",
    "url",
    "hash",
    "sha256",
    "developer",
    "format",
    "decode",
    "text",
    "de-identify",
    "anonymise",
    "anonymize",
    "redact",
    "pii",
    "characters",
    "emoji",
    "ascii",
    "logs",
    "synopsis",
    "syntax",
    "code",
    "rewrite"
  ],
  "a11yLabel": "Text - characters, editing, analysis and conversions",
  "render": {
    "width": 1100,
    "height": 820,
    "formats": [
      "html"
    ],
    "export": false,
    "layout": "canvas",
    "urlSync": false,
    "sidebar": false
  },
  "inputs": [
    {
      "id": "body",
      "type": "longtext",
      "label": "Text",
      "default": ""
    },
    {
      "id": "operation",
      "type": "text",
      "label": "Action",
      "default": "identity"
    },
    {
      "id": "settings",
      "type": "longtext",
      "label": "Action options (JSON)",
      "default": "{}"
    },
    {
      "id": "source",
      "type": "longtext",
      "label": "Source information (JSON)",
      "default": "{}"
    },
    {
      "id": "language",
      "type": "text",
      "label": "Syntax language",
      "default": "auto"
    },
    {
      "id": "characterRecents",
      "type": "longtext",
      "label": "Recent characters",
      "default": "[]"
    },
    {
      "id": "workspaceMode",
      "type": "text",
      "label": "Workspace mode",
      "default": ""
    }
  ],
  "requires": [
    "textTools"
  ],
  "hooks": {
    "onInit": true,
    "onInput": true,
    "exportFile": true
  }
}

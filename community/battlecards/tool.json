{
  "id": "battlecards",
  "name": "Battlecards",
  "description": "Turn any table into a deck of cards - one card per row, ready as a multi-page PDF. Paste straight from your spreadsheet, doc, or chat.",
  "a11yLabel": "Battlecards: {{default title \"Battlecards\"}} - one card per table row",
  "version": "1.4.0",
  "engineVersion": "^1.82.0",
  "status": "community",
  "category": "everyone",
  "tags": ["battlecard", "sales", "competitive", "table", "cards", "pdf", "pages", "batch"],
  "render": {
    "width": 1200,
    "height": 900,
    "formats": ["pdf", "svg", "penpot", "pdf-cmyk", "emf", "png", "webp", "avif", "jpeg", "tiff", "cmyk-tiff"],
    "actions": ["copy", "download", "save"],
    "paged": true,
    "filmstrip": "bottom",
    "paginate": { "source": "data" },
    "transparentBg": false
  },
  "hooks": { "onInit": true, "onInput": true },
  "inputs": [
    {
      "id": "data",
      "label": "Table",
      "type": "table",
      "urlKey": "t",
      "help": "One card per row. The first column is each card's title; the other column headings become its field labels. Cells take markdown - **bold**, *italic*, # headings, - bullet and 1. numbered lists, [links](url) and ![images](url). Paste a table copied from a spreadsheet, Notion, Slack or Markdown - or click any text on the card to edit it in place (it bakes back to markdown here). An optional Icon column puts a small image on each card: click the top-right corner of a card to pick one from the catalog. The Copy button hands the finished table back to your spreadsheet."
    },
    {
      "id": "title",
      "label": "Deck title",
      "type": "text",
      "default": "Battlecards",
      "maxLength": 80
    },
    {
      "id": "orientation",
      "display": "segmented",
      "label": "Orientation",
      "type": "select",
      "default": "landscape",
      "options": [
        { "value": "landscape", "label": "Landscape", "width": 1200, "height": 900, "unit": "px" },
        { "value": "portrait", "label": "Portrait", "width": 900, "height": 1200, "unit": "px" }
      ],
      "help": "The card layout adapts: fields flow as a grid in landscape and stack in portrait."
    },
    {
      "id": "accent",
      "label": "Accent",
      "type": "color",
      "default": "{color.semantic.primary}"
    },
    {
      "id": "bg",
      "label": "Background",
      "type": "color",
      "default": "{color.semantic.surface}"
    },
    {
      "id": "ink",
      "label": "Text colour",
      "type": "color",
      "default": "{color.semantic.text}"
    },
    {
      "id": "footer",
      "label": "Footer note",
      "type": "text",
      "default": "",
      "placeholder": "Internal use only · Q3 2026",
      "maxLength": 120
    },
    {
      "id": "ground",
      "label": "Colour treatment",
      "type": "select",
      "default": "tint",
      "options": [
        {"value": "tint", "label": "Brand tint"},
        {"value": "lead", "label": "Lead colour"},
        {"value": "ink", "label": "Ink"},
        {"value": "surface", "label": "Surface"}
      ],
      "help": "Follows this piece’s design system and colourway. Surface uses your background and text colours.",
      "section": "Treatment"
    },
    {
      "id": "density",
      "label": "Spacing",
      "type": "select",
      "default": "auto",
      "options": [
        {"value": "auto", "label": "Fit content"},
        {"value": "compact", "label": "Compact"},
        {"value": "comfortable", "label": "Comfortable"},
        {"value": "spacious", "label": "Spacious"}
      ],
      "section": "Treatment"
    },
    {
      "id": "layout",
      "label": "Layout",
      "type": "select",
      "default": "auto",
      "options": [
        {"value": "auto", "label": "Responsive"},
        {"value": "grid", "label": "Grid"},
        {"value": "stack", "label": "Stack"},
        {"value": "editorial", "label": "Editorial"}
      ],
      "section": "Treatment"
    }
  ]
}

{
  "id": "backdrop",
  "name": "Backdrop",
  "description": "Living backdrops from your design system's colours: sixteen GPU effects - flowing silk, prismatic blooms, liquid contours, metaballs, god rays and more. Tune, freeze the exact moment you want, and export stills or motion loops for heroes, walls and meeting backgrounds.",
  "a11yLabel": "Animated {{effect}} backdrop",
  "version": "1.1.2",
  "engineVersion": "^1.0.0",
  "status": "official",
  "singleInstance": true,
  "category": "everyone",
  "tags": [
    "backdrop",
    "background",
    "wallpaper",
    "hero",
    "animated",
    "generative",
    "brand"
  ],
  "examples": [
    {
      "label": "Lava lamp",
      "values": {
        "effect": "metaballs",
        "count": 4,
        "intensity": 55,
        "density": 45
      }
    },
    {
      "label": "Cathedral rays",
      "values": {
        "effect": "god-rays",
        "count": 4,
        "intensity": 60,
        "density": 45
      }
    },
    {
      "label": "Neural drift",
      "values": {
        "effect": "neuro-noise",
        "intensity": 50,
        "density": 40,
        "speed": 80
      }
    },
    {
      "label": "Smoke halo",
      "values": {
        "effect": "smoke-ring",
        "count": 2,
        "intensity": 55,
        "density": 40,
        "speed": 80
      }
    },
    {
      "label": "Velvet warp",
      "values": {
        "effect": "warp",
        "count": 4,
        "intensity": 45,
        "density": 65
      }
    },
    {
      "label": "Liquid silk",
      "values": {
        "effect": "silk-flow",
        "count": 3,
        "intensity": 60,
        "density": 45,
        "speed": 70
      }
    },
    {
      "label": "Prismatic bloom",
      "values": {
        "effect": "prism-bloom",
        "count": 4,
        "intensity": 60,
        "density": 55,
        "speed": 65
      }
    },
    {
      "label": "Mercury contours",
      "values": {
        "effect": "liquid-contours",
        "count": 3,
        "intensity": 65,
        "density": 40,
        "speed": 70
      }
    }
  ],
  "render": {
    "sectionIcons": {
      "Character": "shapes",
      "Motion": "animate"
    },
    "width": 1600,
    "height": 900,
    "formats": [
      "png",
      "jpg",
      "webp",
      "avif",
      "webm",
      "mp4",
      "gif",
      "tiff",
      "webp-anim"
    ],
    "actions": [
      "copy",
      "download",
      "save"
    ],
    "video": {
      "wait": 0,
      "duration": 8
    }
  },
  "inputs": [

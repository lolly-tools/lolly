{
  "id": "voice-recorder",
  "galleryArt": "icon",
  "name": "Voice Recorder",
  "description": "Record a voice note with a live level meter and gentle coaching, then save it as MP3.",
  "a11yLabel": "Voice recorder - level {{default dbText \"idle\"}}",
  "version": "1.1.3",
  "engineVersion": "^1.17.0",
  "status": "experimental",
  "category": "utility",
  "tags": ["audio", "voice", "record", "recording", "microphone", "voiceover", "podcast", "mp3", "meter", "levels"],
  "featured": {
    "order": 7,
    "blurb": "Record a clean voice note with live level coaching"
  },
  "capabilities": ["microphone"],
  "render": {
    "width": 1080,
    "height": 1080,
    "formats": ["png", "svg", "penpot", "mp3", "wav", "m4a", "opus"],
    "capture": "audio",
    "actions": ["download", "save"],
    "printMarks": false,
    "convertPaths": false
  },
  "inputs": [
    { "id": "title", "label": "Name", "type": "text", "default": "Voice note", "maxLength": 60, "help": "Shown on the recording card and used for the saved file." },
    {
      "id": "targetLevel", "label": "Target level", "type": "select", "default": "normal",
      "help": "What counts as 'just right' for the coaching prompts.",
      "options": [
        { "value": "soft", "label": "Soft · close mic" },
        { "value": "normal", "label": "Normal · speech" },
        { "value": "loud", "label": "Loud · room" }
      ]
    },
    { "id": "showTips", "label": "Coaching tips", "type": "boolean", "default": true, "help": "Live prompts like 'get closer' or 'ease off'." },
    {
      "id": "theme", "label": "Card style", "type": "select", "display": "segmented", "default": "dark",
      "options": [
        { "value": "dark", "label": "Dark" },
        { "value": "light", "label": "Light" }
      ]
    },
    { "id": "accent", "label": "Accent", "type": "color", "default": "", "help": "Leave it empty to follow the primary colour from the design system." }
  ],
  "hooks": { "onInit": true, "onLevel": true }
}

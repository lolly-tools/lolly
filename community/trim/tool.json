{
  "id": "trim",
  "name": "Trim",
  "description": "Cut, turn or shrink an audio or video clip, take a poster frame or contact sheet, mute it or extract its audio on your device.",
  "version": "1.1.0",
  "engineVersion": "^1.0.0",
  "status": "official",
  "category": "utility",
  "privacy": "on-device",
  "tags": ["video", "audio", "trim", "cut", "clip", "mp4", "webm", "gif", "extract audio", "mute", "rotate", "poster frame", "thumbnail", "contact sheet", "compress video", "share"],
  "a11yLabel": "Media trimmer for {{fileName}}",
  "render": { "width": 860, "height": 620, "formats": ["mp4", "webm", "gif", "m4a", "opus", "wav", "jpg", "png"], "export": false, "layout": "canvas", "actions": [] },
  "hooks": { "onInit": true, "onInput": true, "exportFile": true },
  "inputs": [
    { "id": "source", "label": "Audio or video", "type": "file", "accept": ["audio/*", "video/*", ".mp4", ".mov", ".webm", ".mkv", ".wav", ".mp3", ".m4a", ".ogg", ".opus"], "maxSize": 1073741824, "help": "Read and converted locally. Large files can take a while when an exact cut needs re-encoding." },
    { "id": "make", "label": "Make", "type": "select", "default": "clip", "options": [
      { "value": "clip", "label": "Clip" }, { "value": "poster", "label": "Poster frame" }, { "value": "sheet", "label": "Contact sheet" }
    ], "help": "A poster frame is the picture at the start point. A contact sheet spreads frames across the range." },
    { "id": "start", "label": "Start (seconds)", "type": "number", "default": 0, "min": 0, "step": 0.01 },
    { "id": "end", "label": "End (seconds)", "type": "number", "default": 0, "min": 0, "step": 0.01, "help": "0 means the end of the file." },
    { "id": "cut", "label": "Cut", "type": "select", "default": "exact", "options": [
      { "value": "exact", "label": "Exact · re-encodes the picture when needed" }, { "value": "keyframe", "label": "Fast · starts at the key frame before" }
    ], "help": "A copy can only begin on a key frame. A fast cut keeps the original packets and may start a little early." },
    { "id": "container", "label": "Container", "type": "select", "default": "keep", "options": [
      { "value": "keep", "label": "Keep source container" }, { "value": "mp4", "label": "MP4" },
      { "value": "webm", "label": "WebM" }, { "value": "gif", "label": "GIF · up to 15 seconds" }
    ]},
    { "id": "mute", "label": "Remove audio", "type": "boolean", "default": false },
    { "id": "audioOnly", "label": "Extract audio", "type": "select", "default": "off", "options": [
      { "value": "off", "label": "No" }, { "value": "m4a", "label": "M4A" },
      { "value": "opus", "label": "Opus" }, { "value": "wav", "label": "WAV" }
    ]},
    { "id": "rotate", "label": "Rotate", "type": "select", "default": "0", "options": [
      { "value": "0", "label": "No turn" }, { "value": "90", "label": "90° clockwise" },
      { "value": "180", "label": "180°" }, { "value": "270", "label": "90° anticlockwise" }
    ], "help": "MP4 and MOV turn with an orientation setting and keep the picture as it is. Other formats redraw the picture." },
    { "id": "shareSize", "label": "Sharing size", "type": "select", "default": "original", "options": [
      { "value": "original", "label": "Original size" }, { "value": "1080", "label": "1080p" },
      { "value": "720", "label": "720p" }, { "value": "480", "label": "480p" }
    ], "help": "Re-encodes to a smaller picture. Never enlarges." },
    { "id": "maxMB", "label": "Size limit (MB)", "type": "number", "default": 0, "min": 0, "step": 1, "help": "0 means no limit. A limit re-encodes the clip at a bitrate meant to fit and reports whether it did." },
    { "id": "frames", "label": "Frames", "type": "select", "default": "12", "options": [
      { "value": "6", "label": "6" }, { "value": "9", "label": "9" }, { "value": "12", "label": "12" },
      { "value": "16", "label": "16" }, { "value": "25", "label": "25" }
    ]},
    { "id": "imageFormat", "label": "Image format", "type": "select", "default": "jpeg", "options": [
      { "value": "jpeg", "label": "JPEG" }, { "value": "png", "label": "PNG" }
    ]}
  ]
}

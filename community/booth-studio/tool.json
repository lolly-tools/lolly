{
  "id": "booth-studio",
  "name": "Booth",
  "version": "0.3.1",
  "engineVersion": "^1.0.0",
  "status": "experimental",
  "singleInstance": true,
  "category": "event",
  "description": "Dress a 3D event booth with sponsor artwork. Click any panel to drop an image on it, pick a booth design, and render a still or a turntable for a sponsor pitch.",
  "a11yLabel": "3D mockup of {{default design \"a corner L\"}} event booth dressed with sponsor artwork",
  "tags": [
    "booth",
    "event",
    "sponsor",
    "3d",
    "mockup",
    "stand",
    "exhibition"
  ],
  "render": {
    "width": 1600,
    "height": 1000,
    "formats": ["png", "jpg", "webp", "webm", "mp4", "gif", "avif", "tiff", "webp-anim"],
    "actions": [
      "copy",
      "download",
      "save"
    ],
    "convertPaths": false,
    "video": {
      "wait": 2,
      "duration": 6
    }
  },
  "isolate": true,
  "hooks": {
    "onInit": true,
    "onInput": true
  },
  "inputs": [
    {
      "id": "design",
      "label": "Booth design",
      "section": "Booth",
      "type": "select",
      "default": "corner",
      "help": "The stand shape. Your panel artwork carries across designs - a back wall stays a back wall.",
      "options": [
        {
          "value": "inline",
          "label": "Inline 3×3 - back wall + counter"
        },
        {
          "value": "corner",
          "label": "Corner L - two open sides"
        },
        {
          "value": "island",
          "label": "Island - three walls, overhead header + tower"
        },
        {
          "value": "kiosk",
          "label": "Kiosk - totem + counter"
        }
      ]
    },
    {
      "id": "structure",
      "label": "Frame finish",
      "section": "Booth",
      "type": "color",
      "default": "#7d858e",
      "help": "The extrusion and counter body colour."
    },
    {
      "id": "panelBase",
      "label": "Empty panel colour",
      "section": "Booth",
      "type": "color",
      "default": "{color.semantic.muted}",
      "help": "Shown on panels with no artwork, and as the letterbox behind artwork set to Fit whole."
    },
    {
      "id": "backWall",
      "label": "Back wall",
      "section": "Panels",
      "type": "asset",
      "assetType": "any",
      "allowUpload": true,
      "showIf": {
        "design": [
          "inline",
          "corner",
          "island"
        ]
      },
      "help": "The hero graphic. Click the panel on the canvas to set it."
    },
    {
      "id": "backWallFit",
      "label": "Back wall fit",
      "section": "Panels",
      "type": "select",
      "default": "cover",
      "attachTo": "backWall",
      "display": "icon-toggle",
      "showIf": {
        "design": [
          "inline",
          "corner",
          "island"
        ]
      },
      "options": [
        {
          "value": "cover",
          "label": "Fill panel (crop)",
          "icon": "fitCover"
        },
        {
          "value": "contain",
          "label": "Fit whole (letterbox)",
          "icon": "fitContain"
        }
      ]
    },
    {
      "id": "backWallFraming",
      "label": "Back wall position",
      "section": "Panels",
      "framingFor": "backWall",
      "showIf": {"design": ["inline", "corner", "island"]},
      "help": "Move and zoom the artwork inside this panel. Same numbers, same ranges, as every other image slot.",
      "type": "vector",
      "fields": [
        { "id": "zoom", "label": "Zoom", "symbol": "+", "min": 100, "max": 400, "step": 1, "default": 100 },
        { "id": "x",    "label": "X",    "min": 0,   "max": 100, "step": 1, "default": 50  },
        { "id": "y",    "label": "Y",    "min": 0,   "max": 100, "step": 1, "default": 50  }
      ]
    },
    {
      "id": "leftWing",
      "label": "Left wing",
      "section": "Panels",
      "type": "asset",
      "assetType": "any",
      "allowUpload": true,
      "showIf": {
        "design": [
          "corner",
          "island"
        ]
      }
    },
    {
      "id": "leftWingFit",
      "label": "Left wing fit",
      "section": "Panels",
      "type": "select",
      "default": "cover",
      "attachTo": "leftWing",
      "display": "icon-toggle",
      "showIf": {
        "design": [
          "corner",
          "island"
        ]
      },
      "options": [
        {
          "value": "cover",
          "label": "Fill panel (crop)",
          "icon": "fitCover"
        },
        {
          "value": "contain",
          "label": "Fit whole (letterbox)",
          "icon": "fitContain"
        }
      ]
    },
    {
      "id": "leftWingFraming",
      "label": "Left wing position",
      "section": "Panels",
      "framingFor": "leftWing",
      "showIf": {"design": ["corner", "island"]},
      "help": "Move and zoom the artwork inside this panel. Same numbers, same ranges, as every other image slot.",
      "type": "vector",
      "fields": [
        { "id": "zoom", "label": "Zoom", "symbol": "+", "min": 100, "max": 400, "step": 1, "default": 100 },
        { "id": "x",    "label": "X",    "min": 0,   "max": 100, "step": 1, "default": 50  },
        { "id": "y",    "label": "Y",    "min": 0,   "max": 100, "step": 1, "default": 50  }
      ]
    },
    {
      "id": "rightWing",
      "label": "Right wing",
      "section": "Panels",
      "type": "asset",
      "assetType": "any",
      "allowUpload": true,
      "showIf": {
        "design": [
          "island"
        ]
      }
    },
    {
      "id": "rightWingFit",
      "label": "Right wing fit",
      "section": "Panels",
      "type": "select",
      "default": "cover",
      "attachTo": "rightWing",
      "display": "icon-toggle",
      "showIf": {
        "design": [
          "island"
        ]
      },
      "options": [
        {
          "value": "cover",
          "label": "Fill panel (crop)",
          "icon": "fitCover"
        },
        {
          "value": "contain",
          "label": "Fit whole (letterbox)",
          "icon": "fitContain"
        }
      ]
    },
    {
      "id": "rightWingFraming",
      "label": "Right wing position",
      "section": "Panels",
      "framingFor": "rightWing",
      "showIf": {"design": ["island"]},
      "help": "Move and zoom the artwork inside this panel. Same numbers, same ranges, as every other image slot.",
      "type": "vector",
      "fields": [
        { "id": "zoom", "label": "Zoom", "symbol": "+", "min": 100, "max": 400, "step": 1, "default": 100 },
        { "id": "x",    "label": "X",    "min": 0,   "max": 100, "step": 1, "default": 50  },
        { "id": "y",    "label": "Y",    "min": 0,   "max": 100, "step": 1, "default": 50  }
      ]
    },
    {
      "id": "header",
      "label": "Header / fascia",
      "section": "Panels",
      "type": "asset",
      "assetType": "any",
      "allowUpload": true,
      "showIf": {
        "design": [
          "inline",
          "corner",
          "island"
        ]
      },
      "help": "The overhead band. Usually a wordmark."
    },
    {
      "id": "headerFit",
      "label": "Header fit",
      "section": "Panels",
      "type": "select",
      "default": "contain",
      "attachTo": "header",
      "display": "icon-toggle",
      "showIf": {
        "design": [
          "inline",
          "corner",
          "island"
        ]
      },
      "options": [
        {
          "value": "cover",

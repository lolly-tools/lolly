    {
      "id": "counter",
      "label": "Counter front",
      "section": "Panels",
      "type": "asset",
      "assetType": "any",
      "allowUpload": true
    },
    {
      "id": "counterFit",
      "label": "Counter front fit",
      "section": "Panels",
      "type": "select",
      "default": "contain",
      "attachTo": "counter",
      "display": "icon-toggle",
      "options": [
        {
          "value": "cover",
          "label": "Fill panel (crop)",
          "icon": "fitCover"
        },
        {
          "value": "contain",
          "label": "Fit whole (letterbox)",
          "icon": "fitContain"
        }
      ]
    },
    {
      "id": "counterFraming",
      "label": "Counter front position",
      "section": "Panels",
      "framingFor": "counter",
      "help": "Move and zoom the artwork inside this panel. Same numbers, same ranges, as every other image slot.",
      "type": "vector",
      "fields": [
        { "id": "zoom", "label": "Zoom", "symbol": "+", "min": 100, "max": 400, "step": 1, "default": 100 },
        { "id": "x",    "label": "X",    "min": 0,   "max": 100, "step": 1, "default": 50  },
        { "id": "y",    "label": "Y",    "min": 0,   "max": 100, "step": 1, "default": 50  }
      ]
    },
    {
      "id": "tower",
      "label": "Tower / totem",
      "section": "Panels",
      "type": "asset",
      "assetType": "any",
      "allowUpload": true,
      "showIf": {
        "design": [
          "island",
          "kiosk"
        ]
      }
    },
    {
      "id": "towerFit",
      "label": "Tower fit",
      "section": "Panels",
      "type": "select",
      "default": "contain",
      "attachTo": "tower",
      "display": "icon-toggle",
      "showIf": {
        "design": [
          "island",
          "kiosk"
        ]
      },
      "options": [
        {
          "value": "cover",
          "label": "Fill panel (crop)",
          "icon": "fitCover"
        },
        {
          "value": "contain",
          "label": "Fit whole (letterbox)",
          "icon": "fitContain"
        }
      ]
    },
    {
      "id": "towerFraming",
      "label": "Tower position",
      "section": "Panels",
      "framingFor": "tower",
      "showIf": {"design": ["island", "kiosk"]},
      "help": "Move and zoom the artwork inside this panel. Same numbers, same ranges, as every other image slot.",
      "type": "vector",
      "fields": [
        { "id": "zoom", "label": "Zoom", "symbol": "+", "min": 100, "max": 400, "step": 1, "default": 100 },
        { "id": "x",    "label": "X",    "min": 0,   "max": 100, "step": 1, "default": 50  },
        { "id": "y",    "label": "Y",    "min": 0,   "max": 100, "step": 1, "default": 50  }
      ]
    },
    {
      "id": "screen",
      "label": "Screen",
      "section": "Panels",
      "type": "asset",
      "assetType": "any",
      "allowUpload": true,
      "showIf": {
        "design": [
          "inline",
          "corner",
          "island"
        ]
      },
      "help": "Content on the wall-mounted monitor."
    },
    {
      "id": "screenFit",
      "label": "Screen fit",
      "section": "Panels",
      "type": "select",
      "default": "cover",
      "attachTo": "screen",
      "display": "icon-toggle",
      "showIf": {
        "design": [
          "inline",
          "corner",
          "island"
        ]
      },
      "options": [
        {
          "value": "cover",
          "label": "Fill panel (crop)",
          "icon": "fitCover"
        },
        {
          "value": "contain",
          "label": "Fit whole (letterbox)",
          "icon": "fitContain"
        }
      ]
    },
    {
      "id": "screenFraming",
      "label": "Screen position",
      "section": "Panels",
      "framingFor": "screen",
      "showIf": {"design": ["inline", "corner", "island"]},
      "help": "Move and zoom the artwork inside this panel. Same numbers, same ranges, as every other image slot.",
      "type": "vector",
      "fields": [
        { "id": "zoom", "label": "Zoom", "symbol": "+", "min": 100, "max": 400, "step": 1, "default": 100 },
        { "id": "x",    "label": "X",    "min": 0,   "max": 100, "step": 1, "default": 50  },
        { "id": "y",    "label": "Y",    "min": 0,   "max": 100, "step": 1, "default": 50  }
      ]
    },
    {
      "id": "floor",
      "label": "Floor decal",
      "section": "Panels",
      "type": "asset",
      "assetType": "any",
      "allowUpload": true,
      "showIf": {
        "design": [
          "inline",
          "corner",
          "island"
        ]
      }
    },
    {
      "id": "floorFit",
      "label": "Floor decal fit",
      "section": "Panels",
      "type": "select",
      "default": "cover",
      "attachTo": "floor",
      "display": "icon-toggle",
      "showIf": {
        "design": [
          "inline",
          "corner",
          "island"
        ]
      },
      "options": [
        {
          "value": "cover",
          "label": "Fill panel (crop)",
          "icon": "fitCover"
        },
        {
          "value": "contain",
          "label": "Fit whole (letterbox)",
          "icon": "fitContain"
        }
      ]
    },
    {
      "id": "floorFraming",
      "label": "Floor decal position",
      "section": "Panels",
      "framingFor": "floor",
      "showIf": {"design": ["inline", "corner", "island"]},
      "help": "Move and zoom the artwork inside this panel. Same numbers, same ranges, as every other image slot.",
      "type": "vector",
      "fields": [
        { "id": "zoom", "label": "Zoom", "symbol": "+", "min": 100, "max": 400, "step": 1, "default": 100 },
        { "id": "x",    "label": "X",    "min": 0,   "max": 100, "step": 1, "default": 50  },
        { "id": "y",    "label": "Y",    "min": 0,   "max": 100, "step": 1, "default": 50  }
      ]
    },
    {
      "id": "padding",
      "label": "Letterbox padding",
      "section": "Panels",
      "type": "number",
      "display": "slider",
      "default": 6,
      "min": 0,
      "max": 25,
      "step": 1,
      "help": "Breathing room around any panel set to Fit whole, as a percent of the panel's short edge."
    },
    {
      "id": "bgImage",
      "label": "Background content",
      "section": "Background",
      "type": "asset",
      "assetType": "any",
      "allowUpload": true,
      "help": "An image, a video, or a Lolly tool link (paste one in the picker) behind the stand - a hall photo, a stage shot, a keynote loop. Blend and blur it below so it sets a scene without competing with the artwork."
    },
    {
      "id": "bgImageFit",
      "label": "Background fit",
      "section": "Background",
      "type": "select",
      "default": "cover",
      "attachTo": "bgImage",
      "display": "icon-toggle",
      "options": [
        {
          "value": "cover",
          "label": "Fill frame (crop)",
          "icon": "fitCover"
        },
        {
          "value": "contain",
          "label": "Fit whole (letterbox)",
          "icon": "fitContain"
        }
      ]
    },
    {
      "id": "bgBlur",
      "label": "Bokeh blur",
      "section": "Background",
      "type": "number",
      "display": "slider",
      "default": 12,
      "min": 0,
      "max": 60,
      "step": 1,
      "help": "Throws the background out of focus, like a long lens would. Defaults on: a sharp background fights the stand for attention."
    },
    {
      "id": "bgOpacity",
      "label": "Opacity",
      "section": "Background",
      "type": "number",
      "display": "slider",
      "default": 0.7,
      "min": 0,
      "max": 1,
      "step": 0.01
    },
    {
      "id": "bgBlend",
      "label": "Blend mode",
      "section": "Background",
      "type": "select",
      "default": "source-over",
      "help": "How the content mixes with the backdrop colour below it.",
      "options": [
        {
          "value": "source-over",
          "label": "Normal"
        },
        {
          "value": "multiply",
          "label": "Multiply"
        },
        {
          "value": "screen",
          "label": "Screen"
        },
        {
          "value": "overlay",
          "label": "Overlay"
        },
        {
          "value": "soft-light",
          "label": "Soft light"
        },
        {
          "value": "lighten",
          "label": "Lighten"
        },
        {
          "value": "darken",
          "label": "Darken"
        },
        {
          "value": "color-dodge",
          "label": "Colour dodge"
        },
        {
          "value": "difference",
          "label": "Difference"
        },
        {
          "value": "luminosity",
          "label": "Luminosity"
        }
      ]
    },
    {
      "id": "bgPosition",
      "label": "Position",
      "section": "Background",
      "framingFor": "bgImage",
      "help": "Which part of the backdrop stays in frame, how far in it is zoomed, and whether it is straightened. Drag it on the canvas, or set the numbers here.",
      "type": "vector",
      "fields": [
        { "id": "x",      "label": "Horizontal", "symbol": "\u2194", "min": 0, "max": 100, "step": 1, "default": 50 },
        { "id": "y",      "label": "Vertical",   "symbol": "\u2195", "min": 0, "max": 100, "step": 1, "default": 50 },
        { "id": "zoom",   "label": "Zoom",       "symbol": "+", "min": 100,  "max": 400, "step": 1,   "default": 100 },
        { "id": "rotate", "label": "Rotate",     "min": -180, "max": 180, "step": 0.5, "default": 0 }
      ]
    },
    {
      "id": "gradientBg",
      "label": "Gradient background",
      "section": "Background",
      "type": "boolean",
      "default": true
    },
    {
      "id": "bgColor2",
      "label": "Gradient top",
      "section": "Background",
      "type": "color",
      "default": "#cfd6dc"
    },
    {
      "id": "background",
      "label": "Background",
      "section": "Background",
      "type": "color",
      "default": "#eef1f4",
      "help": "The bottom of the backdrop. Deliberately neutral - the brand colour belongs on the panels, and a brand-coloured hall behind brand-coloured panels reads as mud."
    },
    {
      "id": "transparentBg",
      "label": "Transparent background",
      "section": "Background",
      "type": "boolean",
      "default": true,
      "help": "Render on transparency (PNG/WebP keep the alpha). Overrides the background colour."
    },
    {
      "id": "scene",
      "label": "Hall lighting",
      "section": "Look",
      "type": "select",
      "default": "expo",
      "options": [
        {
          "value": "expo",
          "label": "Expo hall"
        },
        {
          "value": "bright",
          "label": "Bright studio"
        },
        {
          "value": "evening",
          "label": "Evening reception"
        },
        {
          "value": "keynote",
          "label": "Keynote stage"
        }
      ]
    },
    {
      "id": "exposure",
      "label": "Exposure",
      "section": "Look",
      "type": "number",
      "display": "slider",
      "default": 1,
      "min": 0.1,
      "max": 3,
      "step": 0.05
    },
    {
      "id": "shadows",
      "label": "Contact shadow",
      "section": "Look",
      "type": "boolean",
      "default": true
    },
    {
      "id": "people",
      "label": "Show a person for scale",
      "section": "Look",
      "type": "boolean",
      "default": true,
      "help": "A 1.76 m silhouette beside the stand - it sells how big the stand actually is."
    },
    {
      "id": "camera",
      "label": "Camera",
      "section": "Camera",
      "type": "vector",
      "help": "The base shot. A camera move (below) animates from here.",
      "fields": [
        {
          "id": "fov",
          "label": "Field of view",
          "symbol": "°",
          "min": 20,
          "max": 90,
          "step": 1,
          "default": 38
        },
        {
          "id": "rotation",
          "label": "Rotation",
          "symbol": "°",
          "min": 0,
          "max": 360,
          "step": 1,
          "default": 32
        },
        {
          "id": "tilt",
          "label": "Tilt",
          "symbol": "°",
          "min": -5,
          "max": 70,
          "step": 1,
          "default": 8
        },
        {
          "id": "zoom",
          "label": "Zoom",
          "symbol": "×",
          "min": 0.4,
          "max": 2.5,
          "step": 0.05,
          "default": 1
        },
        {
          "id": "pan",
          "label": "Pan",
          "symbol": "",
          "min": -1,
          "max": 1,
          "step": 0.05,
          "default": 0
        }
      ]
    },
    {
      "id": "cameraMove",
      "label": "Camera move",
      "section": "Animation",
      "type": "select",
      "default": "static",
      "help": "Applies to video and animated exports. Stills always render the base pose.",
      "options": [
        {
          "value": "static",
          "label": "Static (no move)"
        },
        {
          "value": "orbit",
          "label": "Orbit 360°"
        },
        {
          "value": "arc",
          "label": "Arc (sweep past the stand)"
        },
        {
          "value": "push-in",
          "label": "Push in"
        },
        {
          "value": "reveal",
          "label": "Reveal (rise + settle)"
        }
      ]
    },
    {
      "id": "duration",
      "label": "Loop seconds",
      "section": "Animation",
      "type": "number",
      "display": "slider",
      "default": 6,
      "min": 1,
      "max": 30,
      "step": 0.5,
      "help": "Seconds for one loop of the move. Match the export Duration for a clean loop.",
      "showIf": {
        "cameraMove": [
          "orbit",
          "arc",
          "push-in",
          "reveal"
        ]
      }
    },
    {
      "id": "easing",
      "label": "Easing",
      "section": "Animation",
      "type": "select",
      "default": "ease-in-out",
      "showIf": {
        "cameraMove": [
          "arc",
          "push-in",
          "reveal"
        ]
      },
      "options": [
        {
          "value": "linear",
          "label": "Linear"
        },
        {

{
  "id": "strip-data",
  "name": "Strip Hidden Data",
  "description": "Remove selected DOCX properties or image and PDF metadata, and inspect other Office hidden content, on your device.",
  "version": "1.2.0",
  "engineVersion": "^1.252.0",
  "status": "official",
  "category": "utility",
  "privacy": "on-device",
  "tags": ["privacy", "exif", "metadata", "gps", "image", "photo", "strip", "clean", "jpeg", "png", "svg", "vector", "pdf", "document", "office", "docx", "pptx", "xlsx", "inkscape", "illustrator"],
  "a11yLabel": "Hidden-data report for {{fileName}}",
  "render": {
    "width": 760,
    "height": 620,
    "formats": ["jpg", "png", "svg", "penpot", "pdf"],
    "export": false,
    "layout": "canvas",
    "actions": []
  },
  "hooks": {
    "onInit": true,
    "onInput": true,
    "exportFile": true
  },
  "inputs": [
    {
      "id": "source",
      "label": "Image, PDF or Office file",
      "type": "file",
      "accept": ["image/jpeg", "image/png", "image/svg+xml", "application/pdf", ".jpg", ".jpeg", ".png", ".svg", ".pdf", ".docx", ".pptx", ".xlsx", ".docm", ".pptm", ".xlsm", ".doc", ".ppt", ".xls", ".xlsb"],
      "maxSize": 52428800,
      "help": "Images, PDFs and supported DOCX properties support metadata removal. Other Office content remains inspect-only. Your file stays on this device."
    },
    {
      "id": "properties",
      "label": "Document property choices",
      "type": "blocks",
      "default": [],
      "fields": [
        { "id": "id", "label": "Property", "type": "text" },
        { "id": "remove", "label": "Remove property", "type": "boolean", "default": false }
      ]
    }
  ]
}

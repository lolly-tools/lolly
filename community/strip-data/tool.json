{
  "id": "strip-data",
  "name": "Strip Hidden Data",
  "description": "Inspect Office hidden content, or remove image and PDF metadata, on your device.",
  "version": "1.1.0",
  "engineVersion": "^1.251.0",
  "status": "official",
  "category": "utility",
  "privacy": "on-device",
  "tags": ["privacy", "exif", "metadata", "gps", "image", "photo", "strip", "clean", "jpeg", "png", "svg", "vector", "pdf", "document", "office", "docx", "pptx", "xlsx", "inkscape", "illustrator"],
  "a11yLabel": "Hidden-data report for {{fileName}}",
  "render": {
    "width": 760,
    "height": 620,
    "formats": ["jpg", "png", "svg", "penpot", "pdf"],
    "export": false,
    "layout": "canvas",
    "actions": []
  },
  "hooks": {
    "onInit": true,
    "onInput": true,
    "exportFile": true
  },
  "inputs": [
    {
      "id": "source",
      "label": "Image, PDF or Office file",
      "type": "file",
      "accept": ["image/jpeg", "image/png", "image/svg+xml", "application/pdf", ".jpg", ".jpeg", ".png", ".svg", ".pdf", ".docx", ".pptx", ".xlsx", ".docm", ".pptm", ".xlsm", ".doc", ".ppt", ".xls", ".xlsb"],
      "maxSize": 52428800,
      "help": "Images and PDFs support metadata removal. Office files up to 32 MiB support read-only inspection. Your file stays on this device."
    }
  ]
}

{
  "id": "strip-data",
  "name": "Strip Hidden Data",
  "description": "Remove metadata from images, audio and PDFs, and selected DOCX properties, and inspect other Office hidden content, on your device.",
  "version": "1.5.0",
  "engineVersion": "^1.264.0",
  "status": "official",
  "category": "utility",
  "privacy": "on-device",
  "tags": ["privacy", "exif", "metadata", "gps", "image", "photo", "strip", "clean", "jpeg", "png", "svg", "vector", "pdf", "document", "office", "docx", "pptx", "xlsx", "inkscape", "illustrator", "audio", "music", "m4a", "wav", "mp3", "flac", "opus", "id3", "tags", "c2pa", "content credentials"],
  "a11yLabel": "Hidden-data report for {{fileName}}",
  "render": {
    "width": 760,
    "height": 620,
    "formats": ["jpg", "png", "svg", "penpot", "pdf"],
    "export": false,
    "layout": "canvas",
    "actions": []
  },
  "hooks": {
    "onInit": true,
    "onInput": true,
    "exportFile": true
  },
  "inputs": [
    {
      "id": "source",
      "label": "Image, audio, PDF or Office file",
      "type": "file",
      "accept": ["image/jpeg", "image/png", "image/svg+xml", "application/pdf", ".jpg", ".jpeg", ".png", ".svg", ".pdf", ".docx", ".pptx", ".xlsx", ".docm", ".pptm", ".xlsm", ".doc", ".ppt", ".xls", ".xlsb", "audio/mp4", "audio/x-m4a", "audio/wav", "audio/x-wav", "audio/mpeg", "audio/flac", "audio/x-flac", "audio/ogg", "audio/opus", ".m4a", ".wav", ".mp3", ".flac", ".opus", ".ogg"],
      "maxSize": 52428800,
      "help": "Images, audio, PDFs and supported DOCX properties support metadata removal. Audio keeps its sound unchanged. Other Office content remains inspect-only. Your file stays on this device."
    },
    {
      "id": "properties",
      "label": "Document property choices",
      "type": "blocks",
      "default": [],
      "fields": [
        { "id": "id", "label": "Property", "type": "text" },
        { "id": "remove", "label": "Remove property", "type": "boolean", "default": false }
      ]
    }
  ]
}

    },
    {
      "id": "cols",
      "label": "Columns",
      "section": "Mesh grid",
      "type": "number",
      "display": "slider",
      "default": 3,
      "min": 2,
      "max": 5,
      "step": 1,
      "showIf": {
        "mode": [
          "subdivide",
          "mesh"
        ]
      }
    },
    {
      "id": "curvature",
      "label": "Curvature",
      "section": "Mesh grid",
      "type": "number",
      "display": "slider",
      "default": 55,
      "min": 0,
      "max": 100,
      "step": 1,
      "showIf": {
        "mode": [
          "subdivide",
          "mesh"
        ]
      },
      "help": "How much the grid lines bow between nodes. 0 is straight; 50 is a classic Catmull-Rom mesh. Drag a selected node's square handles to reshape individual tangents."
    },
    {
      "id": "detail",
      "label": "Detail",
      "section": "Mesh grid",
      "type": "number",
      "display": "slider",
      "default": 3,
      "min": 1,
      "max": 4,
      "step": 1,
      "showIf": {
        "mode": "subdivide"
      },
      "help": "Subdivision depth: each patch splits into 4 / 16 / 64 / 256 flat tiles. Low is a deliberate faceted, stained-glass look; high is smoother but a bigger SVG."
    },
    {
      "id": "meshData",
      "label": "Mesh data",
      "section": "Mesh grid",
      "type": "text",
      "default": "",
      "maxLength": 4000,
      "showIf": {
        "mode": [
          "subdivide",
          "mesh"
        ]
      },
      "help": "The mesh itself - written as you drag nodes, handles and colours on the canvas. Clear it (or press reset) to re-seed the grid from the colour swatches."
    },
    {
      "id": "spread",
      "label": "Spread",
      "section": "Texture & motion",
      "type": "number",
      "display": "slider",
      "default": 75,

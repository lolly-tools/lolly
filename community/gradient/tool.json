{
  "id": "gradient",
  "name": "Gradient",
  "description": "Five ways to build a gradient from your brand swatches: soft radial Blend, a real Coons-patch mesh as crisp SVG (Subdivide) or a smooth raster (Mesh), freeform Warp points, and the animated Flow waves. Drag everything right on the canvas; export stills or join-free video loops.",
  "a11yLabel": "Mesh gradient blending {{count}} colours",
  "version": "1.2.1",
  "engineVersion": "^1.0.0",
  "status": "official",
  "category": "everyone",
  "tags": [
    "gradient",
    "mesh",
    "background",
    "wallpaper",
    "hero",
    "brand",
    "coons",
    "warp",
    "animated"
  ],
  "examples": [
    {
      "label": "Sunset haze",
      "values": {
        "count": 3,
        "color1": "#ff9a8b",
        "color2": "#f2a65a",
        "color3": "#ffd3bd",
        "blend": "screen",
        "spread": 95,
        "blur": 10,
        "grain": 30
      }
    },
    {
      "label": "Aurora night",
      "values": {
        "count": 4,
        "color1": "#22d3ee",
        "color2": "#a78bfa",
        "color3": "#10b981",
        "color4": "#0b1021",
        "blend": "screen",
        "spread": 110,
        "blur": 8,
        "grain": 60
      }
    },
    {
      "label": "Silk flow",
      "values": {
        "mode": "flow",
        "count": 4,
        "color1": "#0ea5e9",
        "color2": "#a78bfa",
        "color3": "#f472b6",
        "color4": "#0b1021",
        "flowSpeed": 24,
        "waveScale": 100,
        "waveAmp": 70,
        "angle": 35,
        "seed": 12
      }
    },
    {
      "label": "Stained glass",
      "values": {
        "mode": "subdivide",
        "count": 4,
        "color1": "#0ea5e9",
        "color2": "#1e3a8a",
        "color3": "#f2a65a",
        "color4": "#0f766e",
        "rows": 4,
        "cols": 4,
        "curvature": 70,
        "detail": 1,
        "grain": 0
      }
    },
    {
      "label": "Studio mesh",
      "values": {
        "mode": "mesh",
        "count": 4,
        "color1": "#6d5bd8",
        "color2": "#e0679f",
        "color3": "#2fb6a3",
        "color4": "#f6f1e7",
        "rows": 3,
        "cols": 3,
        "curvature": 60
      }
    },
    {
      "label": "Freeform pool",
      "values": {
        "mode": "warp",
        "count": 5,
        "color1": "#f472b6",
        "color2": "#60a5fa",
        "color3": "#facc15",
        "color4": "#34d399",
        "color5": "#f97316",
        "spread": 95
      }
    },
    {
      "label": "Paper grain",
      "values": {
        "count": 2,
        "color1": "#f5efe6",
        "color2": "#e2e8f0",
        "blend": "normal",
        "spread": 140,
        "blur": 20,
        "grain": 100,
        "grainBlend": "overlay"
      }
    },
    {
      "label": "Live backdrop",
      "values": {
        "count": 4,
        "color1": "#eef2f7",
        "color2": "#cfe0f5",
        "color3": "#dcd6f7",
        "color4": "#f7e6d8",
        "blend": "normal",
        "spread": 110,
        "blur": 16,
        "grain": 25,
        "animate": true,
        "speed": 16,
        "distance": 80
      }
    }
  ],
  "render": {
    "width": 1600,
    "height": 900,
    "formats": ["svg", "penpot", "png", "jpg", "webp", "avif", "webm", "mp4", "gif", "pdf", "tiff", "webp-anim"],
    "actions": [
      "copy",
      "download",
      "save"
    ],
    "video": {
      "wait": 0,
      "duration": 12
    }
  },
  "inputs": [
    {
      "id": "mode",
      "label": "Method",
      "type": "select",
      "default": "blend",
      "help": "How the gradient is built. Blend and Subdivide export crisp SVG; Mesh, Warp and Flow render smooth raster finishes - Flow (and a drifting Blend or Warp) exports as a join-free video loop.",
      "options": [
        {
          "value": "blend",
          "label": "Blend",
          "badge": "vector",
          "formats": [
            "svg",
            "png",
            "jpg",
            "webp",
            "avif",
            "webm",
            "mp4",
            "gif"
          ]
        },
        {
          "value": "subdivide",
          "label": "Subdivide",
          "badge": "vector",
          "formats": [
            "svg",
            "png",
            "jpg",
            "webp",
            "avif"
          ]
        },
        {
          "value": "mesh",
          "label": "Mesh",
          "badge": "raster",
          "formats": [
            "png",
            "jpg",
            "webp",
            "avif"
          ]
        },
        {
          "value": "warp",
          "label": "Warp",
          "badge": "raster",
          "formats": [
            "png",
            "jpg",
            "webp",
            "avif",
            "webm",
            "mp4",
            "gif"
          ]
        },
        {
          "value": "flow",
          "label": "Flow",
          "badge": "raster",
          "formats": [
            "png",
            "jpg",
            "webp",
            "avif",
            "webm",
            "mp4",
            "gif"
          ]
        }
      ]
    },
    {
      "id": "blend",
      "label": "Blend mode",
      "type": "select",
      "default": "hard-light",
      "help": "How the colour points mix into each other.",
      "showIf": {
        "mode": "blend"
      },
      "options": [
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "multiply",
          "label": "Multiply"
        },
        {
          "value": "screen",
          "label": "Screen"
        },
        {
          "value": "overlay",
          "label": "Overlay"
        },
        {
          "value": "soft-light",
          "label": "Soft light"
        },
        {
          "value": "hard-light",
          "label": "Hard light"
        },
        {
          "value": "lighten",
          "label": "Lighten"
        },
        {
          "value": "darken",
          "label": "Darken"
        },
        {
          "value": "luminosity",
          "label": "Luminosity"
        }
      ]
    },
    {
      "id": "count",
      "label": "Colour points",
      "type": "number",
      "display": "slider",
      "default": 5,
      "min": 2,
      "max": 6,
      "step": 1
    },
    {
      "id": "color1",
      "label": "Colour 1 (base)",
      "type": "color",
      "default": "{color.semantic.primary}"
    },
    {
      "id": "pos1",
      "label": "Position 1",
      "type": "vector",
      "help": "Drag the dot on the canvas, or set X / Y here (% of the frame).",
      "showIf": {
        "mode": [
          "blend",
          "warp"
        ]
      },
      "fields": [
        {
          "id": "x",
          "label": "X",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 14
        },
        {
          "id": "y",
          "label": "Y",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 20
        }
      ]
    },
    {
      "id": "color2",
      "label": "Colour 2",
      "type": "color",
      "default": "{color.semantic.secondary}"
    },
    {
      "id": "pos2",
      "label": "Position 2",
      "type": "vector",
      "showIf": {
        "mode": [
          "blend",
          "warp"
        ]
      },
      "fields": [
        {
          "id": "x",
          "label": "X",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 85
        },
        {
          "id": "y",
          "label": "Y",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 18
        }
      ]
    },
    {
      "id": "color3",
      "label": "Colour 3",
      "type": "color",
      "default": "{color.spectrum.teal}",
      "showIf": {
        "count": [
          3,
          4,
          5,
          6
        ]
      }
    },
    {
      "id": "pos3",
      "label": "Position 3",
      "type": "vector",
      "showIf": {
        "mode": [
          "blend",
          "warp"
        ],
        "count": [
          3,
          4,
          5,
          6
        ]
      },
      "fields": [
        {
          "id": "x",
          "label": "X",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 80
        },
        {
          "id": "y",
          "label": "Y",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 82
        }
      ]
    },
    {
      "id": "color4",
      "label": "Colour 4",
      "type": "color",
      "default": "{color.semantic.surface}",
      "showIf": {
        "count": [
          4,
          5,
          6
        ]
      }
    },
    {
      "id": "pos4",
      "label": "Position 4",
      "type": "vector",
      "showIf": {
        "mode": [
          "blend",
          "warp"
        ],
        "count": [
          4,
          5,
          6
        ]
      },
      "fields": [
        {
          "id": "x",
          "label": "X",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 18
        },
        {
          "id": "y",
          "label": "Y",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 78
        }
      ]
    },
    {
      "id": "color5",
      "label": "Colour 5",
      "type": "color",
      "default": "#f2a65a",
      "showIf": {
        "count": [
          5,
          6
        ]
      }
    },
    {
      "id": "pos5",
      "label": "Position 5",
      "type": "vector",
      "showIf": {
        "mode": [
          "blend",
          "warp"
        ],
        "count": [
          5,
          6
        ]
      },
      "fields": [
        {
          "id": "x",
          "label": "X",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 52
        },
        {
          "id": "y",
          "label": "Y",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 10
        }
      ]
    },
    {
      "id": "color6",
      "label": "Colour 6",
      "type": "color",
      "default": "#5b8def",
      "showIf": {
        "count": [
          6
        ]
      }
    },
    {
      "id": "pos6",
      "label": "Position 6",
      "type": "vector",
      "showIf": {
        "mode": [
          "blend",
          "warp"
        ],
        "count": [
          6
        ]
      },
      "fields": [
        {
          "id": "x",
          "label": "X",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 50
        },
        {
          "id": "y",
          "label": "Y",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 88
        }
      ]
    },
    {
      "id": "rows",
      "label": "Rows",
      "section": "Mesh grid",
      "type": "number",
      "display": "slider",
      "default": 3,
      "min": 2,
      "max": 5,
      "step": 1,
      "showIf": {
        "mode": [
          "subdivide",
          "mesh"
        ]
      },
      "help": "Mesh node rows. Changing the grid re-seeds node colours from the swatches."
    },
    {
      "id": "cols",
      "label": "Columns",
      "section": "Mesh grid",
      "type": "number",
      "display": "slider",
      "default": 3,
      "min": 2,
      "max": 5,
      "step": 1,
      "showIf": {
        "mode": [
          "subdivide",
          "mesh"
        ]
      }
    },
    {
      "id": "curvature",
      "label": "Curvature",
      "section": "Mesh grid",
      "type": "number",
      "display": "slider",
      "default": 55,
      "min": 0,
      "max": 100,
      "step": 1,
      "showIf": {
        "mode": [
          "subdivide",
          "mesh"
        ]
      },
      "help": "How much the grid lines bow between nodes. 0 is straight; 50 is a classic Catmull-Rom mesh. Drag a selected node's square handles to reshape individual tangents."
    },
    {
      "id": "detail",
      "label": "Detail",
      "section": "Mesh grid",
      "type": "number",
      "display": "slider",
      "default": 3,
      "min": 1,
      "max": 4,
      "step": 1,
      "showIf": {
        "mode": "subdivide"
      },
      "help": "Subdivision depth: each patch splits into 4 / 16 / 64 / 256 flat tiles. Low is a deliberate faceted, stained-glass look; high is smoother but a bigger SVG."
    },
    {
      "id": "meshData",
      "label": "Mesh data",
      "section": "Mesh grid",
      "type": "text",
      "default": "",
      "maxLength": 4000,
      "showIf": {
        "mode": [
          "subdivide",
          "mesh"
        ]
      },
      "help": "The mesh itself - written as you drag nodes, handles and colours on the canvas. Clear it (or press reset) to re-seed the grid from the colour swatches."
    },
    {
      "id": "spread",
      "label": "Spread",
      "section": "Texture & Motion",
      "type": "number",
      "display": "slider",
      "default": 75,
      "min": 30,
      "max": 140,
      "step": 1,
      "showIf": {
        "mode": [
          "blend",
          "warp"
        ]
      },
      "help": "How far each colour reaches across the frame."
    },
    {
      "id": "blur",
      "label": "Extra blur",
      "section": "Texture & Motion",
      "type": "number",
      "display": "slider",
      "default": 6,
      "min": 0,
      "max": 40,
      "step": 1,
      "showIf": {
        "mode": [
          "blend",
          "subdivide"
        ]
      },
      "help": "Melts the colours together. 0 keeps the SVG export filter-free."
    },
    {
      "id": "grain",
      "label": "Grain",
      "section": "Texture & Motion",
      "type": "number",
      "display": "slider",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 1,
      "showIf": {
        "mode": [
          "blend",
          "subdivide"
        ]
      }
    },
    {
      "id": "grainBlend",
      "label": "Grain blend",
      "section": "Texture & Motion",
      "type": "select",
      "default": "soft-light",
      "showIf": {
        "mode": [
          "blend",
          "subdivide"
        ]
      },
      "options": [
        {
          "value": "soft-light",
          "label": "Soft light (smooth)"
        },
        {
          "value": "overlay",
          "label": "Overlay (gritty)"
        },
        {
          "value": "luminosity",
          "label": "Luminosity (classic)"
        }
      ]
    },
    {
      "id": "animate",
      "label": "Drift",
      "section": "Texture & Motion",
      "type": "boolean",
      "default": false,
      "showIf": {
        "mode": [
          "blend",
          "warp"
        ]
      },
      "help": "Slow, looping drift of the colour points. Export as WebM, MP4 or GIF for a live meeting background."
    },
    {
      "id": "distance",
      "label": "Float distance",
      "section": "Texture & Motion",
      "type": "number",
      "display": "slider",
      "default": 100,
      "min": 0,
      "max": 200,
      "step": 5,
      "showIf": {
        "mode": [
          "blend",
          "warp"
        ],
        "animate": true
      },
      "help": "How far the colour points drift from their set position. 100% is the default orbit size; 0% freezes them in place."
    },
    {
      "id": "speed",
      "label": "Float speed",
      "section": "Texture & Motion",
      "type": "number",
      "display": "slider",
      "default": 12,
      "min": 4,
      "max": 24,
      "step": 1,
      "showIf": {
        "mode": [
          "blend",
          "warp"
        ],
        "animate": true
      },
      "help": "Seconds per drift loop - higher is slower. A WebM, MP4 or GIF export captures one whole loop, unless you type your own length in the export bar. A very long loop is trimmed to what the export can hold."
    },
    {
      "id": "flowSpeed",
      "label": "Loop length",
      "section": "Waves",
      "type": "number",
      "display": "slider",
      "default": 20,
      "min": 4,
      "max": 60,
      "step": 1,
      "showIf": {
        "mode": "flow"
      },
      "help": "Seconds per wave loop - higher is slower. A WebM, MP4 or GIF export captures one whole loop, unless you type your own length in the export bar."
    },
    {
      "id": "waveScale",
      "label": "Wave scale",
      "section": "Waves",
      "type": "number",
      "display": "slider",
      "default": 120,
      "min": 30,
      "max": 300,
      "step": 5,
      "showIf": {
        "mode": "flow"
      },
      "help": "Zoom of the wave pattern - lower is bigger, softer shapes."
    },
    {
      "id": "waveAmp",
      "label": "Wave motion",
      "section": "Waves",
      "type": "number",
      "display": "slider",
      "default": 60,
      "min": 0,
      "max": 100,
      "step": 1,
      "showIf": {
        "mode": "flow"
      },
      "help": "How much the waves churn and travel over a loop."
    },
    {
      "id": "angle",
      "label": "Angle",
      "section": "Waves",
      "type": "number",
      "display": "slider",
      "default": 25,
      "min": 0,
      "max": 360,
      "step": 5,
      "showIf": {
        "mode": "flow"
      }
    },
    {
      "id": "seed",
      "label": "Wave seed",
      "section": "Waves",
      "type": "number",
      "default": 7,
      "min": 1,
      "max": 999,
      "step": 1,
      "showIf": {
        "mode": "flow"
      },
      "help": "Deterministic variation - the same seed always makes the same waves. The shuffle button picks a new one."
    }
  ],
  "isolate": true,
  "hooks": {
    "onInit": true,
    "onInput": true,
    "beforeExport": true,
    "afterExport": true
  }
}

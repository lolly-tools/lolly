      "max": 40,
      "step": 1,
      "showIf": {
        "mode": [
          "blend",
          "subdivide"
        ]
      },
      "help": "Melts the colours together. 0 keeps the SVG export filter-free."
    },
    {
      "id": "grain",
      "label": "Grain",
      "section": "Texture & motion",
      "type": "number",
      "display": "slider",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 1,
      "showIf": {
        "mode": [
          "blend",
          "subdivide"

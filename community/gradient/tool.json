    "width": 1600,
    "height": 900,
    "formats": [
      "svg",
      "penpot",
      "png",
      "jpg",
      "webp",
      "avif",
      "webm",
      "mp4",
      "gif",
      "pdf",
      "tiff",
      "webp-anim"

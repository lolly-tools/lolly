  "render": {
    "sectionIcons": {
      "Colour": "palette",
      "Mesh grid": "grid",
      "Texture & motion": "animate",
      "Waves": "waves",
      "Method": "sliders",
      "Position": "move",
      "Motion": "animate",
      "Field": "shapes"

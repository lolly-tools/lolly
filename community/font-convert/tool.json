{
  "id": "font-convert",
  "name": "Convert Font",
  "description": "Convert a font between TrueType, OpenType and WOFF - on your device.",
  "version": "1.0.0",
  "engineVersion": "^1.0.0",
  "status": "official",
  "category": "utility",
  "privacy": "on-device",
  "tags": ["font", "ttf", "otf", "woff", "webfont", "convert", "truetype", "opentype", "typography", "sfnt"],
  "a11yLabel": "Font conversion for {{fileName}}",
  "render": {
    "width": 760,
    "height": 560,
    "formats": ["ttf", "otf", "woff"],
    "export": false,
    "layout": "canvas",
    "actions": []
  },
  "hooks": {
    "onInit": true,
    "onInput": true,
    "exportFile": true
  },
  "inputs": [
    {
      "id": "source",
      "label": "Font file",
      "type": "file",
      "accept": ["font/ttf", "font/otf", "font/woff", ".ttf", ".otf", ".woff", ".ttc"],
      "maxSize": 52428800,
      "help": "A TrueType (.ttf), OpenType (.otf) or WOFF font. It's read in your browser and never leaves your device."
    },
    {
      "id": "target",
      "label": "Convert to",
      "type": "select",
      "default": "woff",
      "options": [
        { "value": "ttf", "label": "TrueType (.ttf)" },
        { "value": "otf", "label": "OpenType (.otf)" },
        { "value": "woff", "label": "Web font (.woff)" }
      ],
      "help": "The container to convert into. The glyph outlines are unchanged; only the wrapper differs. WOFF2 is read but not written yet."
    }
  ]
}

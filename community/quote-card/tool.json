{
  "id": "quote-card",
  "name": "Quote",
  "description": "A quotation in the active design system: a speaker card, a pull quote, a citation with its source, big type, a marker on the key phrase, with optional motion that carries into Design.",
  "a11yLabel": "Quotation from {{name}}: {{quote}}",
  "version": "1.1.0",
  "engineVersion": "^1.0.0",
  "status": "community",
  "category": "everyone",
  "tags": [
    "quote",
    "quotation",
    "testimonial",
    "pull quote",
    "social",
    "speaker",
    "citation",
    "motion"
  ],
  "render": {
    "width": 1600,
    "height": 1200,
    "formats": [
      "png",
      "jpg",
      "webp",
      "svg",
      "penpot",
      "pdf",
      "avif",
      "tiff",
      "mp4",
      "webm",
      "gif",
      "apng",
      "webp-anim"
    ],
    "actions": [
      "copy",
      "download",
      "save"
    ],
    "filenameFrom": [
      "name"
    ],
    "transparentBg": false,
    "video": {
      "wait": 0,
      "duration": 6
    },
    "followsCanvasSize": true
  },
  "isolate": true,
  "inputs": [
    {
      "id": "quote",
      "label": "Quote",
      "type": "longtext",
      "required": true,
      "default": "The best tools disappear, so the work can speak."
    },
    {
      "id": "phrase",
      "label": "Phrase to emphasise",
      "type": "text",
      "default": "",
      "help": "Copy a few words from the quote. Marker draws across them; other layouts set them in a stronger colour."
    },
    {
      "id": "name",
      "label": "Name",
      "type": "text",
      "default": "Maya Lindqvist"
    },
    {
      "id": "role",
      "label": "Role",
      "type": "text",
      "default": "Head of Product, Northline Studio"
    },
    {
      "id": "headshot",
      "label": "Picture",
      "type": "asset",
      "assetType": "image",
      "allowUpload": true,
      "help": "A portrait or a character. Leave it empty for a words-only card."
    },
    {
      "id": "ground",
      "label": "Ground",
      "type": "select",
      "default": "lead",
      "display": "segmented",
      "options": [
        {
          "value": "lead",
          "label": "Lead colour"
        },
        {
          "value": "ink",
          "label": "Ink"
        },
        {
          "value": "paper",
          "label": "Paper"
        }
      ]
    },
    {
      "id": "layout",
      "label": "Layout",
      "type": "select",
      "default": "beside",
      "options": [
        {
          "value": "beside",
          "label": "Beside a picture"
        },
        {
          "value": "centred",
          "label": "Words only"
        },
        {
          "value": "type",
          "label": "Big type"
        },
        {
          "value": "glyph",
          "label": "Big quotation mark"
        },
        {
          "value": "pull",
          "label": "Pull quote"
        },
        {
          "value": "citation",
          "label": "Citation"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "marker",
          "label": "Marker"
        }
      ]
    },
    {
      "id": "source",
      "label": "Source",
      "type": "text",
      "default": "",
      "section": "Source",
      "help": "The book, paper, talk or article it comes from. Leave a field empty and it leaves nothing behind."
    },
    {
      "id": "publication",
      "label": "Publication",
      "type": "text",
      "default": "",
      "section": "Source"
    },
    {
      "id": "date",
      "label": "Date",
      "type": "text",
      "default": "",
      "section": "Source",
      "placeholder": "1843"
    },
    {
      "id": "link",
      "label": "Link",
      "type": "url",
      "default": "",
      "section": "Source"
    },
    {
      "id": "motion",
      "label": "Motion",
      "type": "select",
      "default": "none",
      "help": "Video, GIF and SVG play the motion. Placed in Design, the picture plays on the timeline. PNG, PDF and other stills always show the finished card.",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "word",
          "label": "Word by word"
        },
        {
          "value": "line",
          "label": "Line by line"
        },
        {
          "value": "sweep",
          "label": "Marker sweep"
        },
        {
          "value": "draw",
          "label": "Graphic first"
        }
      ]
    }
  ],
  "hooks": {
    "onInit": true,
    "onInput": true
  }
}

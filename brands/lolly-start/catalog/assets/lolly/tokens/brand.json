{
  "$description": "Lolly starter tokens - a deliberately minimal cut of the SUSE palette: one green brand ramp (Pine → Jungle → Mint) over a quiet Fog neutral base, and nothing else. A new brand grows by ADDING colours in the #/start Design System studio, not by clearing out a big preset palette. Layered DTCG: a shared 'base' set of two ramps (primary + neutral) with per-theme semantic slots that alias into them, plus the default logo slots (asset.logo.*) pointing at the shipped Lolly marks. $values are hex, like the SUSE pack; the engine's colorToHex reads either hex or oklch. Replace the lot via the #/start wizard or 'npm run ingest:brand'.",
  "$metadata": {
    "tokenSetOrder": [
      "base",
      "light",
      "dark"
    ]
  },
  "$themes": [
    {
      "name": "light",
      "selectedTokenSets": {
        "base": "enabled",
        "light": "enabled"
      }
    },
    {
      "name": "dark",
      "selectedTokenSets": {
        "base": "enabled",
        "dark": "enabled"
      }
    }
  ],
  "base": {
    "color": {
      "$type": "color",
      "ramp": {
        "primary": {
          "$description": "The SUSE green ramp, dark (1) to light (9): Pine → Jungle → Mint. Step 4 is Jungle (the light-theme primary), step 6 is Mint (the dark-theme primary), step 1 is Pine (the on-primary ink).",
          "1": {
            "$value": "#0c322c",
            "$description": "Pine"
          },
          "2": {
            "$value": "#025937"
          },
          "3": {

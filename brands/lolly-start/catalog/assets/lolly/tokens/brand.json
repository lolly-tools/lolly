          },
          "5": {
            "$value": "#999999"
          },
          "6": {
            "$value": "#bababa"
          },
          "7": {
            "$value": "#dcdbdc"
          },
          "8": {
            "$value": "#efefef"
          },
          "9": {
            "$value": "#ffffff"
          }
        }
      }
    },
    "font": {
      "$type": "fontFamily",
      "brand": {
        "$value": "SUSE",
        "$description": "UI & body - SUSE, the platform's default face. Shell-served from the web shell's public/fonts/ (not this catalog), so it resolves on every profile without the pack shipping font binaries. SIL OFL 1.1 - see this pack's README for the licence finding. Replace it by adding your own face in the #/start Type room."
      },
      "mono": {
        "$value": "SUSE Mono",
        "$description": "Code, readouts & data - SUSE Mono, also shell-served and the platform's default mono on every profile. SIL OFL 1.1."
      }
    },
    "asset": {
      "logo": {
        "$description": "The blank starter's default logo marks - the Lolly swirl, shipped in this pack's catalog (lolly/logo/*). The mark is square, so horizontal and vertical share one file per treatment. Upload your own in the #/start Brand studio to override any slot.",

            "$value": "#eafaf4"
          },
          "9": {
            "$value": "#f5fefb"
          }
        },
        "neutral": {
          "$description": "SUSE Fog - quiet true grays for surfaces, text and hairlines. Dark (1) to light (9); the themes invert it so ink and paper swap.",
          "1": {
            "$value": "#1d1d1d"
          },
          "2": {
            "$value": "#3e3e3e"
          },
          "3": {
            "$value": "#525252"
          },
          "4": {

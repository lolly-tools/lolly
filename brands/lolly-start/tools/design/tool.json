{
  "id": "design",
  "name": "Design",
  "description": "An open canvas for free arrangement - text, images, shapes and live renders from your other Lolly tools, all held to your brand.",
  "version": "1.13.0",
  "engineVersion": "^1.12.0",
  "status": "community",
  "category": "designer",
  "tags": [
    "canvas",
    "layout",
    "wysiwyg",
    "editor",
    "poster",
    "compose",
    "design",
    "free-form",
    "import",
    "figma",
    "penpot",
    "pdf",
    "ai",
    "illustrator",
    "idml",
    "indesign",
    "adobe"
  ],
  "featured": {
    "order": 1,
    "blurb": "Free-form layouts on an open canvas"
  },
  "render": {
    "width": 1920,
    "height": 1080,
    "formats": [
      "png",
      "svg",
      "pdf",
      "pdf-cmyk",
      "cmyk-tiff",
      "jpg",
      "webp",
      "mp4",
      "webm",
      "gif",
      "apng",
      "wav",
      "mp3",
      "m4a",
      "opus",
      "pptx"
    ],
    "actions": [
      "copy",
      "download",
      "save",
      "share"
    ],
    "layout": "editor",
    "transparentBg": true,
    "video": {
      "wait": 0,
      "duration": 12
    }
  },
  "hooks": {
    "onInit": true,
    "onInput": true,
    "beforeExport": true
  },
  "examples": [

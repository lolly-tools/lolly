          "max": 300
        },
        {
          "id": "shadowBlur",
          "type": "number",
          "label": "Shadow blur",
          "default": 10,
          "min": 0,
          "max": 300
        },
        {
          "id": "imgpos",
          "type": "select",
          "label": "Image position",
          "default": "center",
          "help": "Which edge or corner the image is anchored to - where a contained image sits inside the box, or which part of a cover-cropped image stays in frame. Honoured on screen and in PNG/SVG/PDF export.",
          "options": [
            {
              "value": "left top",
              "label": "Top left"
            },
            {
              "value": "center top",
              "label": "Top"
            },
            {
              "value": "right top",
              "label": "Top right"
            },
            {
              "value": "left center",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Centre"
            },
            {
              "value": "right center",
              "label": "Right"
            },
            {
              "value": "left bottom",
              "label": "Bottom left"
            },
            {
              "value": "center bottom",
              "label": "Bottom"
            },
            {
              "value": "right bottom",
              "label": "Bottom right"
            }
          ]
        },
        {
          "id": "fitText",
          "type": "boolean",
          "label": "Shrink text to fit",
          "default": false,
          "help": "Automatically shrink the text so it fits inside the box (shrink-only - never larger than the set size). Off by default, so the box grows to the text instead."
        },
        {
          "id": "path",
          "type": "text",
          "default": "",
          "showFor": [],
          "help": "A vector path box's authored path (nodes, handles and spline kind), encoded by host.geom.encodeAuthored. Written by the pen tool and read by the hook; showFor:[] keeps it out of the sidebar because it is machine-written, never typed. Coordinates are fractions of the box frame, so move/resize/rotate act on it through x/y/w/h/rot."
        },
        {
          "id": "stroke",
          "type": "color",
          "label": "Stroke",
          "default": "",
          "showFor": [
            "path",
            "box",
            "image",
            "frame"
          ]
        },
        {

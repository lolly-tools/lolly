  "inputs": [
    {
      "id": "background",
      "type": "color",
      "label": "Canvas background",
      "default": "{color.semantic.surface}"
    },
    {
      "id": "customCss",
      "type": "longtext",
      "label": "Custom CSS",
      "rows": 8,
      "default": "",
      "help": "Advanced (plan 112): CSS applied to the whole document - editor, export, and presentation. Scoped to the canvas, so @keyframes work at the top level. `@import` and `</style` are stripped for safety. Target `.lolly-box`, a frame with `[data-frame-id=\"…\"]`, or a present-mode state such as `.pr-active`."
    },
    {
      "id": "transition",
      "type": "select",
      "label": "Slide transition",
      "default": "slide",
      "options": [
        { "value": "slide", "label": "Slide" },
        { "value": "fade", "label": "Fade" },
        { "value": "morph", "label": "Morph" }
      ],
      "help": "How slides change in presentation mode (plan 112 M5). Morph animates matching boxes - same text, the same image, or a shared match key - from one slide to the next."
    },
    {
      "id": "boxes",
      "type": "blocks",
      "label": "Boxes",
      "labelledFields": true,
      "addMenu": {
        "field": "kind",
        "label": "Add box"
      },
      "canvas": {
        "idField": "id",
        "xField": "x",
        "yField": "y",
        "wField": "w",
        "hField": "h",
        "rotationField": "rot",
        "shapeField": "shape",
        "radiusField": "radius",
        "fillField": "bg",
        "gradField": "grad",
        "opacityField": "opacity",
        "imageField": "image",
        "imgPosField": "imgpos",
        "textField": "text",
        "textColorField": "fg",
        "fontSizeField": "fontSize",
        "alignField": "align",
        "valignField": "valign",
        "weightField": "weight",
        "fontField": "font",
        "lineHeightField": "lineHeight",
        "trackingField": "tracking",
        "ligaturesField": "ligatures",
        "alternatesField": "alternates",
        "padField": "pad",
        "fitTextField": "fitText",
        "fitField": "fit",
        "blendField": "blend",
        "groupField": "group",
        "clipField": "clip",
        "pathField": "path",
        "headStartField": "headStart",
        "headEndField": "headEnd",
        "bindStartField": "bindStart",
        "bindEndField": "bindEnd",
        "routeField": "route",
        "pathLayerClass": "lolly-connectors",
        "strokeDashArrayField": "strokeDashArray",
        "dashFitField": "dashFit",
        "shadowField": "shadow",
        "shadowColorField": "shadowColor",
        "shadowXField": "shadowX",
        "shadowYField": "shadowY",
        "shadowBlurField": "shadowBlur",
        "startField": "start",
        "durField": "dur",
        "clipInField": "clipIn",
        "speedField": "speed",
        "enterField": "enter",
        "exitField": "exit",
        "enterMsField": "enterMs",
        "exitMsField": "exitMs",
        "enterEaseField": "enterEase",
        "exitEaseField": "exitEase",
        "muteField": "mute",
        "linkField": "linkOf",
        "laneField": "lane",
        "zField": "z",
        "kfField": "kf",
        "frameField": "frame",
        "orderField": "order",
        "clipChildrenField": "clipChildren",
        "frameKind": "frame",
        "minSize": 8,
        "import": {
          "formats": [
            "svg",
            "penpot",
            "pdf",
            "ai",
            "idml"
          ]
        },
        "addKinds": [
          {
            "id": "box",
            "label": "Box",
            "seed": {
              "kind": "box",
              "bg": "",
              "shape": "rounded",
              "text": ""
            }
          },
          {
            "id": "circle",
            "label": "Circle",
            "seed": {
              "kind": "box",
              "bg": "",
              "shape": "circle",
              "text": "",
              "w": 480,
              "h": 480
            }
          },
          {
            "id": "text",
            "label": "Text",
            "seed": {
              "kind": "text",
              "bg": "",
              "shape": "rect",
              "text": "Text",
              "fg": "#11141f",
              "fontSize": 64,
              "valign": "top",
              "font": "sans",
              "lineHeight": 1.12
            }
          },
          {
            "id": "image",
            "label": "Image",
            "seed": {
              "kind": "image",
              "bg": "",
              "shape": "rounded",
              "fit": "contain",
              "text": ""
            }
          },
          {
            "id": "lottie",
            "label": "Animation",
            "seed": {
              "kind": "image",
              "bg": "",
              "shape": "rounded",
              "fit": "contain",
              "text": ""
            }
          },
          {
            "id": "video",
            "label": "Video",
            "seed": {
              "kind": "image",
              "bg": "",
              "shape": "rounded",
              "fit": "contain",
              "text": ""
            }
          },
          {
            "id": "path",
            "label": "Path",
            "seed": {
              "kind": "path",
              "shape": "rect",
              "bg": "",
              "stroke": "#11141f",
              "strokeW": 4,
              "fillRule": "nonzero",
              "text": "",
              "w": 400,
              "h": 400,
              "path": "1!catmull-rom!1_.5!0_1!.5_.5!1_0!.5"
            }
          },
          {
            "id": "audio",
            "label": "Audio",
            "seed": {
              "kind": "audio"
            }
          },
          {
            "id": "clip",
            "label": "Clip",
            "seed": {
              "kind": "image",
              "lane": "seq",
              "fit": "cover"
            }
          },
          {
            "id": "card",
            "label": "Card",
            "seed": {
              "kind": "box",
              "lane": "seq",
              "dur": 2.5,
              "bg": "#14181d",
              "text": ""
            }
          },
          {
            "id": "camera",
            "label": "Camera",
            "seed": {
              "kind": "camera"
            }
          },
          {
            "id": "frame",
            "label": "Artboard",
            "seed": {
              "kind": "frame",
              "bg": "#fafbfe",
              "shape": "rect",
              "stroke": "#dfe3ec",
              "strokeW": 2
            }
          }
        ]
      },

        {
          "id": "alternates",
          "type": "boolean",
          "label": "Stylistic alternates",
          "default": false,
          "help": "OpenType stylistic alternates (salt), where the font provides them."
        },
        {
          "id": "group",
          "type": "text",
          "label": "Group",
          "default": ""
        },
        {
          "id": "clip",
          "type": "text",
          "label": "Clip to",

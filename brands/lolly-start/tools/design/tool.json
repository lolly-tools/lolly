          {
            "id": "quote",
            "kind": "text",
            "x": 200,
            "y": 280,
            "w": 1520,
            "h": 420,
            "rot": 0,
            "shape": "rect",
            "text": "“The best way to predict the future is to design it.”",
            "fg": "var(--brand-on-primary, #ffffff)",

            "weight": "700",
            "font": "sans",
            "lineHeight": 1.1
          }
        ]
      }
    },
    {
      "label": "Quote cutaway",
      "values": {
        "boxes": [
          {
            "id": "bg",
            "kind": "box",
            "x": 0,
            "y": 0,
            "w": 1920,
            "h": 1080,
            "rot": 0,
            "shape": "rect",
            "bg": "var(--brand-primary, #1e293b)",
            "order": 0

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:web && npm run build:mcp-fn && npm run build:ca-fn",
  "outputDirectory": "shells/web/dist",
  "functions": {
    "api/mcp/**": {
      "maxDuration": 60,
      "includeFiles": "{tools/**,catalog/assets/**,catalog/fonts/**,catalog/tools/**,catalog/previews/*.svg,catalog/previews/*.json}",
      "regions": ["fra1"]
    },
    "api/ca/**": {
      "regions": ["fra1"]
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self' blob: data: https://www.googleapis.com https://fonts.googleapis.com https://fonts.gstatic.com https://api.somafm.com https://registry.color.org https://www.color.org https://geocoding-api.open-meteo.com; img-src 'self' data: blob:; media-src 'self' blob: data: https://*.somafm.com; font-src 'self' data: blob:; worker-src 'self' blob:; child-src 'self' blob:; frame-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'self'"
        },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "credentialless" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), display-capture=(self), geolocation=()"
        }
      ]
    },
    {
      "source": "/info/(.*)\\.c2pa",
      "headers": [
        { "key": "Content-Type", "value": "application/c2pa" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/t/layout-studio",
      "destination": "/design",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www\\.lolly\\.tools" }],
      "destination": "https://lolly.tools/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www\\.lolly\\.art" }],
      "destination": "https://lolly.art/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": ".*lolly\\.(ad|bot|codes|design|free|gallery|graphics|ing|ink|is|media|sh|style|to|work)" }],
      "destination": "https://lolly.tools/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/t/:id", "destination": "/t/:id.html" },
    { "source": "/design", "destination": "/t/design.html" },
    { "source": "/tools", "destination": "/view/tools.html" },
    { "source": "/utilities", "destination": "/view/utilities.html" },
    { "source": "/u", "destination": "/view/utilities.html" },
    { "source": "/d", "destination": "/view/d.html" },
    { "source": "/v", "destination": "/view/v.html" },
    { "source": "/verify", "destination": "/view/v.html" },
    { "source": "/valid", "destination": "/view/v.html" },
    { "source": "/c", "destination": "/view/c.html" },
    { "source": "/p", "destination": "/view/p.html" },
    { "source": "/start", "destination": "/view/start.html" },
    { "source": "/lab", "destination": "/view/lab.html" },
    { "source": "/pro", "destination": "/view/pro.html" },
    { "source": "/pdf", "destination": "/view/pdf.html" },
    { "source": "/profile", "destination": "/view/profile.html" },
    { "source": "/docs", "destination": "/info/index.html" },
    { "source": "/docs/:slug([a-z0-9-]+)", "destination": "/info/:slug.html" },
    { "source": "/tool/:file([a-z0-9-]+\\.[a-z0-9-]+)", "destination": "/api/mcp/[...path]" },
    { "source": "/api/ca/:path*", "destination": "/api/ca/[...path]" },
    { "source": "/api/mcp", "destination": "/api/mcp/[...path]" },
    { "source": "/api/mcp/:path*", "destination": "/api/mcp/[...path]" },
    { "source": "/.well-known/oauth-authorization-server", "destination": "/api/mcp/[...path]" },
    { "source": "/.well-known/oauth-authorization-server/:path*", "destination": "/api/mcp/[...path]" },
    { "source": "/.well-known/oauth-protected-resource", "destination": "/api/mcp/[...path]" },
    { "source": "/.well-known/oauth-protected-resource/:path*", "destination": "/api/mcp/[...path]" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}

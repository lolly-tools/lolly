{
  "name": "lolly",
  "version": "0.1.0",
  "private": true,
  "description": "Constraint-first, template-driven asset generation. Brand packs are swappable profiles (SUSE, lolly-start, …).",
  "license": "MPL-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "workspaces": [
    "packages/core",
    "packages/node-shell",
    "packages/docs-render",
    "packages/audio-dock",
    "engine",
    "shells/web",
    "shells/cli",
    "shells/tui",
    "services/ca",
    "services/mcp"
  ],
  "scripts": {
    "preinstall": "node scripts/check-bootstrap.ts",
    "postinstall": "node scripts/use-profile.ts --auto",
    "profile": "node scripts/use-profile.ts",
    "profile:suse": "node scripts/use-profile.ts suse",
    "profile:start": "node scripts/use-profile.ts lolly-start",
    "ingest:brand": "node scripts/ingest-brand.ts",
    "ingest:boilerplate": "node scripts/ingest-epub.ts",
    "compose:deck": "node scripts/compose-deck.ts",
    "models:vendor": "node scripts/vendor-models.ts",
    "translate": "node scripts/translate.ts",
    "dev:web": "node scripts/dev-web.ts",
    "build:ort": "node scripts/copy-ort.ts && node scripts/copy-transformers-ort.ts",
    "build:web": "npm run build:ort && npm run build:info && node scripts/build-tool-og.ts && node scripts/build-view-og.ts && npm --workspace shells/web run build",
    "build:web:release": "node scripts/build-release-web.ts web",
    "build:desktop:frontend:release": "node scripts/build-release-web.ts tauri-desktop",
    "build:mobile:frontend:release": "node scripts/build-release-web.ts tauri-mobile",
    "build:info": "node docs/build.ts",
    "test": "node scripts/run-test-suite.ts all",
    "test:unit:engine": "node scripts/run-test-suite.ts unit:engine",
    "test:unit:web": "node scripts/run-test-suite.ts unit:web",
    "test:contracts": "node scripts/run-test-suite.ts contracts",
    "test:security": "node scripts/run-test-suite.ts security",
    "test:tools": "node scripts/run-test-suite.ts tools",
    "test:browser": "node scripts/run-test-suite.ts browser",
    "test:tauri": "node scripts/run-test-suite.ts tauri && cargo test --manifest-path shells/tauri-desktop/src-tauri/Cargo.toml remote_fetch --lib && cargo test --manifest-path shells/tauri-mobile/src-tauri/Cargo.toml remote_fetch --lib",
    "test:conformance": "node scripts/run-test-suite.ts conformance",
    "test:shards": "node scripts/run-test-suite.ts all --list",
    "check:skip-identities": "node scripts/check-skip-identities.ts",
    "test:fuzz:regression": "node --import ./tests/css-stub.mjs --test tests/fuzz-regression.test.ts",
    "test:fuzz:soak": "node tests/fuzz/run.ts",
    "typecheck": "tsc -p packages/core && tsc -p packages/node-shell && tsc -p engine && tsc -p shells/web && tsc -p shells/web/tsconfig.tests.json && tsc -p shells/cli && tsc -p shells/tui && tsc -p shells/tauri-shared && tsc -p tests && tsc -p scripts && tsc -p services/mcp && npm run typecheck:tauri",
    "typecheck:tauri": "node scripts/typecheck-tauri.ts",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "lint:changed": "node scripts/check-changed-lint.ts",
    "lint:baseline": "node scripts/check-changed-lint.ts --write",
    "format": "biome format --write",
    "pack:engine": "node scripts/pack-engine.ts",
    "pack:core": "node scripts/pack-core.ts",
    "pack:cli": "node scripts/pack-cli.ts",
    "build:cli-sidecar": "node scripts/build-cli-sidecar.ts",
    "gen:chrome-tokens": "node scripts/gen-chrome-tokens.ts",
    "build:catalog": "node scripts/build-catalog-index.ts && node scripts/checksum-assets.ts && node scripts/build-preview-bundle.ts",
    "build:pack": "node scripts/build-instance-pack.ts",
    "build:catalog:all": "node scripts/build-catalog-all.ts",
    "build:readme-tools": "node scripts/build-readme-tools.ts",
    "validate:catalog": "node scripts/validate-catalog.ts",
    "build:engine-modules": "node scripts/gen-engine-modules.ts",
    "check:engine-modules": "node scripts/gen-engine-modules.ts --check",
    "check:engine-purity": "node scripts/check-engine-purity.ts",
    "check:docs-nav": "node scripts/check-docs-nav.ts",
    "check:code-comments": "node scripts/check-code-comment-vernacular.ts",
    "build:web-src-readme": "node scripts/gen-web-src-readme.ts",
    "check:web-src-readme": "node scripts/gen-web-src-readme.ts --check",
    "index:plans": "node scripts/index-plans.ts",
    "validate:catalog:all": "node scripts/build-catalog-all.ts --check",
    "sync:shared": "node scripts/sync-shared-hooks.ts",
    "check:bundle": "node scripts/check-bundle-budget.ts",
    "check:docs-size": "node scripts/check-docs-size-budget.ts",
    "check:mcp": "node scripts/check-mcp-live.ts",
    "check:first-load": "node scripts/check-first-load.ts",
    "check:blank-previews": "node scripts/check-blank-previews.ts",
    "docs:shots": "node scripts/build-docs-shots.ts",
    "previews": "node scripts/build-previews.ts && node scripts/optimize-preview-webp.ts && node scripts/build-preview-bundle.ts",
    "previews:animated": "node scripts/build-animated-previews.ts",
    "previews:motion-probe": "node scripts/probe-motion.ts",
    "icons": "node scripts/build-app-icons.ts && node scripts/gen-shutter-mark.ts",
    "og:base": "node scripts/build-og-base.ts",
    "og": "node scripts/build-tool-og.ts && node scripts/build-view-og.ts",
    "og:all": "node scripts/build-og-all.ts",
    "voice": "node scripts/build-voice-clips.ts",
    "cards:svg": "node scripts/build-svg-card.ts",
    "cards:html": "node scripts/build-html-card.ts",
    "ca:dev": "node scripts/run-private-ca.ts server",
    "sign:credentials:catalog": "node scripts/run-private-ca.ts sign-catalog",
    "sign:signature-logos": "node scripts/run-private-ca.ts sign-logos",
    "optimize:previews": "node scripts/optimize-previews.ts",
    "optimize:assets": "node scripts/optimize-assets.ts",
    "optimize:thumbnails": "node scripts/build-thumbnails.ts",
    "optimize:preview-png": "node scripts/optimize-preview-png.ts",
    "optimize:preview-webp": "node scripts/optimize-preview-webp.ts",
    "build:cargo-licenses": "node scripts/build-cargo-licenses.ts",
    "check:cargo-licenses": "node scripts/check-cargo-licenses.ts",
    "check:workflow-pins": "node --test tests/workflow-pins.test.ts",
    "check:maintainability": "node scripts/check-maintainability-budget.ts",
    "maintainability:baseline": "node scripts/check-maintainability-budget.ts --write",
    "check:locale-markup": "node scripts/validate-locale-markup.ts",
    "check:parser-assurance": "node scripts/check-parser-assurance.ts",
    "build:parser-inventory": "node scripts/build-parser-inventory.ts",
    "check:parser-inventory": "node scripts/build-parser-inventory.ts --check",
    "audit:all": "node scripts/audit-all.ts",
    "secrets:scan": "node scripts/scan-secrets.ts",
    "secrets:scan:staged": "node scripts/scan-secrets.ts --staged",
    "secrets:scan:checkout": "node scripts/scan-secrets.ts --checkout",
    "build:sbom": "node scripts/build-sbom.ts",
    "build:licenses": "node scripts/build-licenses.ts",
    "build:release-checklist": "node scripts/release-checklist.ts --write",
    "check:release-checklist": "node scripts/release-checklist.ts --check",
    "doctor": "node scripts/doctor.ts",
    "build:host-v1-api": "node scripts/check-host-v1-api.ts --write",
    "check:host-v1-api": "node scripts/check-host-v1-api.ts --check",
    "cli": "node shells/cli/bin/lolly.ts",
    "install:browser": "node shells/cli/bin/lolly.ts install-browser",
    "smoke": "node shells/cli/bin/lolly.ts smoke",
    "tui": "npm --workspace shells/tui run start",
    "mcp": "node services/mcp/bin/lolly-mcp.ts",
    "mcp:http": "node services/mcp/src/http.ts",
    "mcp:test": "node --test \"services/mcp/test/**/*.test.ts\"",
    "mcp:inspect": "mcp-inspector node services/mcp/bin/lolly-mcp.ts",
    "mcp:inspect:cli": "mcp-inspector --cli node services/mcp/bin/lolly-mcp.ts",
    "mcp:install-browser": "node services/mcp/scripts/install-browser.ts",
    "build:mcp-fn": "node scripts/build-mcp-fn.ts",
    "build:three": "node scripts/build-three-bundle.ts",
    "build:chart-three": "node scripts/build-chart-three.ts",
    "build:chart-plot": "node scripts/build-chart-plot.ts",
    "build:ca-fn": "node scripts/build-ca-fn.ts",
    "build:penpot-fn": "node scripts/build-penpot-fn.ts",
    "dev:desktop": "cd shells/tauri-desktop && npm run dev",
    "build:desktop": "cd shells/tauri-desktop && npm run build",
    "dev:android": "cd shells/tauri-mobile && npm run dev:android",
    "dev:ios": "cd shells/tauri-mobile && npm run dev:ios",
    "build:android": "cd shells/tauri-mobile && npm run build:android",
    "build:ios": "cd shells/tauri-mobile && npm run build:ios"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "playwright-core": "^1.62.1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@biomejs/biome": "^2.5.11",
    "@observablehq/plot": "0.6.17",
    "@types/node": "^26.4.0",
    "esbuild": "^0.28.2",
    "onnxruntime-node": "^1.29.0",
    "playwright": "^1.62.1",
    "sharp": "^0.35.4",
    "svgo": "^4.1.0",
    "three": "0.185.1"
  },
  "overrides": {
    "adm-zip": "^0.6.0",
    "shell-quote": "^1.9.0",
    "ip-address": "^10.3.1",
    "nanoid": "^3.3.17",
    "@huggingface/transformers": {
      "sharp": "$sharp",
      "onnxruntime-node": "$onnxruntime-node"
    }
  }
}

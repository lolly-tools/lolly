                },
                "noSandbox": {
                  "type": "boolean"
                },
                "maxConcurrent": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2
                },
                "maxQueued": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 8
                },
                "queueTimeoutMs": {
                  "type": "integer",
                  "minimum": 1000,
                  "maximum": 60000
                }
              }
            }
          },
          "required": [
            "image",
            "port",
            "uid",
            "resources",
            "tmpSize",
            "existingSecret",
            "heapMiB",
            "allowAnonymous",
            "webBase",
            "browser"
          ]
        },
        "ca": {

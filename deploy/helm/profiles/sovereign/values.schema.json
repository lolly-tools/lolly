            },
            "tmpSize": {
              "type": "string",
              "pattern": "^[1-9][0-9]*([EPTGMK]i|[EPTGMk])?$"
            },
            "existingSecret": {
              "type": "string",
              "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$",
              "minLength": 1
            },
            "heapMiB": {
              "type": "integer",
              "minimum": 16,
              "maximum": 384
            },
            "allowAnonymous": {
              "type": "boolean"
            },
            "webBase": {
              "type": "string"

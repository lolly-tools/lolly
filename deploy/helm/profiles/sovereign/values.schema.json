                  "minLength": 1
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                }
              },
              "required": ["repository", "digest"]
            },
            "port": {
              "type": "integer",
              "const": 8080
            },
            "uid": {
              "type": "integer",
              "const": 101
            },
            "resources": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "requests": {
                  "type": "object",

  },
  "required": [
    "manageNamespaces",
    "clusterDomain",
    "imagePullSecrets",
    "public",
    "private",
    "edge",
    "models",
    "components"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "edge": {
            "properties": {
              "tls": {
                "properties": {
                  "mode": {
                    "enum": ["acme", "bootstrap"]
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "edge": {
            "properties": {
              "tls": {
                "properties": {
                  "email": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$",
                    "maxLength": 254
                  },
                  "existingClaim": {
                    "type": "string",
                    "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "edge": {
            "properties": {
              "tls": {
                "properties": {
                  "mode": {
                    "enum": ["file", "bootstrap"]
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "public": {
            "properties": {
              "tlsSecret": {
                "type": "string",
                "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$",

                      "type": "string",
                      "pattern": "^[1-9][0-9]*([EPTGMK]i|[EPTGMk])?$"
                    },
                    "ephemeral-storage": {
                      "type": "string",
                      "pattern": "^[1-9][0-9]*([EPTGMK]i|[EPTGMk])?$"
                    }
                  },
                  "required": ["cpu", "memory", "ephemeral-storage"]
                },
                "limits": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "cpu": {
                      "type": "string",
                      "pattern": "^([1-9][0-9]*m|[1-9][0-9]*|0\\.[0-9]*[1-9][0-9]*)$"
                    },
                    "memory": {
                      "type": "string",
                      "pattern": "^[1-9][0-9]*([EPTGMK]i|[EPTGMk])?$"
                    },
                    "ephemeral-storage": {
                      "type": "string",
                      "pattern": "^[1-9][0-9]*([EPTGMK]i|[EPTGMk])?$"
                    }

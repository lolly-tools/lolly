{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "ca": {
      "type": "object",
      "properties": {
        "config": {
          "type": "object",
          "properties": {
            "issuerMode": {
              "type": "string",
              "enum": [
                "legacy-root",
                "vault-pki"
              ]
            },
            "managed": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "address": {
                  "type": "string",
                  "maxLength": 1024
                },
                "mount": {
                  "type": "string",
                  "maxLength": 1024
                },
                "namespace": {
                  "type": "string",
                  "maxLength": 1024
                },
                "serviceAccountName": {
                  "type": "string",
                  "maxLength": 1024
                },
                "kubernetesMount": {
                  "type": "string",
                  "maxLength": 1024
                },
                "kubernetesRole": {
                  "type": "string",
                  "maxLength": 1024
                },
                "kubernetesAudience": {
                  "type": "string",
                  "maxLength": 1024
                },
                "credentialSecret": {
                  "type": "string",
                  "maxLength": 1024
                },
                "revocationCredentialSecret": {
                  "type": "string",
                  "maxLength": 1024
                },
                "trustJson": {
                  "type": "string",
                  "maxLength": 200000
                },
                "rolesJson": {
                  "type": "string",
                  "maxLength": 200000
                },
                "auth": {
                  "type": "string",
                  "enum": [
                    "agent",
                    "kubernetes"
                  ]
                },
                "egress": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

# Store the real file outside the checkout. No credentials belong here.
LOLLY_PUBLIC_HOST=lolly.tools
LOLLY_PUBLIC_ACME_EMAIL=operator@example.com
# Include every alias that is actually being moved, with exact owned DNS names.
LOLLY_PUBLIC_REDIRECT_HOSTS="www.lolly.tools lolly.ad lolly.art lolly.bot lolly.codes lolly.design lolly.free lolly.gallery lolly.graphics lolly.ink lolly.is lolly.media lolly.sh lolly.style lolly.to lolly.work"

# Immutable image references from one qualified public lolly-start release.
# Placeholders are deliberately unusable until replaced with real sha256 pins.
LOLLY_PUBLIC_WEB_IMAGE=registry.example.com/lolly-web@sha256:REPLACE_WITH_64_HEX
LOLLY_PUBLIC_MCP_IMAGE=registry.example.com/lolly-mcp@sha256:REPLACE_WITH_64_HEX
LOLLY_PUBLIC_CA_IMAGE=registry.example.com/lolly-ca@sha256:REPLACE_WITH_64_HEX
LOLLY_PUBLIC_PENPOT_IMAGE=registry.example.com/lolly-penpot@sha256:REPLACE_WITH_64_HEX

# Direct pathname children from deploy/models-host's verified model release.
LOLLY_PUBLIC_MODELS_DIR=/srv/lolly-public/models/releases/REPLACE_WITH_RELEASE
# Required env_file paths need Docker Compose >=2.24. Use single-quoted values
# for literal secrets and single-quoted multiline PEM values in these files.
LOLLY_PUBLIC_MCP_ENV_FILE=/etc/lolly-public/mcp.env
LOLLY_PUBLIC_CA_ENV_FILE=/etc/lolly-public/ca.env
# Measure the socket peer seen by each upstream on the stage host. Exact IP only.
LOLLY_PUBLIC_PROXY_PEER=REPLACE_WITH_MEASURED_IP

# Contents of mcp.env (not this public interpolation file):
# LOLLY_MCP_TOKEN=<existing approved shared token>
# LOLLY_MCP_SIGNING_SECRET=<existing approved signing secret, if configured>
# LOLLY_RATE_LIMIT_REST_URL=https://<existing approved durable Redis REST store>
# LOLLY_RATE_LIMIT_REST_TOKEN=<existing approved store token>
# Keep the existing approved rate and daily usage limits. Do not set them to zero.
# No VERCEL, private pack, Work/database credentials or private file mode.

# Contents of ca.env (not this public interpolation file):
# CA_ROOT_KEY_PEM=<existing approved multiline private root key>
# CA_ROOT_CERT_PEM=<existing approved multiline public root certificate>
# CA_SERVICE_SECRET=<existing approved state/enrollment signing secret>
# CA_RATE_LIMIT_REST_URL=https://<existing approved durable Redis REST store>
# CA_RATE_LIMIT_REST_TOKEN=<existing approved store token>
# Existing configured Google/GitHub/SUSE OIDC client pairs and/or:
# RESEND_API_KEY=<existing approved provider key>
# EMAIL_FROM=<existing approved sender>
# Preserve root identity and provider registrations through the cutover.

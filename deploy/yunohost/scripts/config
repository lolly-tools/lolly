#!/bin/bash

source _common.sh
source /usr/share/yunohost/helpers

validate__csp_extra_connect_src() {
    if ! lolly_normalize_connect_src "${csp_extra_connect_src:-}" >/dev/null; then
        echo "Use space-separated HTTPS origins without paths or wildcards (at most 4096 characters)."
    fi
}

set__csp_extra_connect_src() {
    csp_extra_connect_src=$(lolly_normalize_connect_src "${csp_extra_connect_src:-}") \
        || ynh_die "Invalid extra CSP origins."
    lolly_apply_includes \
        || ynh_die "nginx could not apply the storage origins; the previous configuration was restored."
    ynh_app_setting_set --key=csp_extra_connect_src --value="$csp_extra_connect_src"
}

validate__models_source() {
    case "${models_source:-}" in
        lolli|local) ;;
        *) echo "Choose lolli.li or this server." ;;
    esac
}

set__models_source() {
    # Fetch and verify first: a failure here leaves the saved setting and nginx alone.
    if [[ "$models_source" == local ]]; then
        ynh_script_progression "Fetching model files into $data_dir/models (several GB, this takes a while)..."
        models_source=local
        lolly_fetch_models
    fi
    lolly_apply_includes \
        || ynh_die "nginx could not apply the model source; the previous configuration was restored."
    ynh_app_setting_set --key=models_source --value="$models_source"
}

ynh_app_config_run "$1"

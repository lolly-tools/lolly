      "values": {
        "heading": "Pick a door",
        "subheading": "",
        "style": "orbit",
        "accent": "#7c3aed",
        "background": "#faf9fd",
        "color": "#1c1730",
        "links": {
          "columns": [
            "URL",
            "Name",
            "Emoji"
          ],
          "rows": [
            [
              "https://example.com/game",
              "Play",
              "🎮"
            ],
            [
              "https://example.com/music",
              "Listen",
              "🎧"
            ],
            [
              "https://example.com/shop",
              "Shop",
              "🛍️"
            ],
            [
              "https://example.com/chat",
              "Chat",
              "💬"
            ]
          ]
        }
      }
    },
    {
      "label": "Conference talk",
      "values": {
        "heading": "Thanks for listening",
        "subheading": "The slides, the paper and the demo from today's talk.",
        "style": "cards",
        "accent": "#0d7a5f",
        "background": "#f5f7f4",
        "color": "#132019",
        "links": {
          "columns": [

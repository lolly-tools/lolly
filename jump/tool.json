{
  "id": "jump",
  "name": "Jump",
  "description": "A one-link landing page: your links, heading, portrait and colours on an expressive page - and the whole page lives inside the link you share.",
  "a11yLabel": "Jump page {{default heading \"Links\"}} holding {{default linkCount \"no\"}} links",
  "version": "1.2.0",
  "engineVersion": "^1.82.0",
  "status": "community",
  "category": "utility",
  "tags": [
    "links",
    "landing",
    "linktree",
    "bio",
    "jump",
    "marketing",
    "share"
  ],
  "examples": [
    {
      "label": "Aurora front door",
      "values": {
        "heading": "Northwind Studio",
        "subheading": "Everything we make, one link.",
        "style": "aurora",
        "accent": "#2563eb",
        "background": "#0b1020",
        "color": "#eef2ff",
        "links": {
          "columns": [
            "URL",
            "Name",
            "Emoji"
          ],
          "rows": [
            [
              "https://example.com/work",
              "Portfolio",
              ""

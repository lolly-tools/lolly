    "./state-dir": "./src/state-dir.ts",
    "./session-store": "./src/session-store.ts",
    "./design-systems": "./src/design-systems.ts",
    "./browsers": "./src/browsers.ts",
    "./browser-tier": "./src/browser-tier.ts",
    "./desktop-renderer": "./src/desktop-renderer.ts",
    "./webshell-render": "./src/webshell-render.ts",
    "./raster": "./src/raster.ts",
    "./hdr": "./src/hdr.ts",
    "./format-sniff": "./src/format-sniff.ts",
    "./images": "./src/images.ts",
    "./ml": "./src/ml/index.ts",
    "./ml/model-pins": "./src/ml/model-pins.ts",
    "./models-dir": "./src/models-dir.ts",
    "./sequence-audio": "./src/sequence-audio.ts",
    "./speech": "./src/speech.ts",
    "./speech-whisper": "./src/speech-whisper.ts",
    "./tts-blend": "./src/tts-blend.ts",
    "./c2pa-opts": "./src/c2pa-opts.ts",
    "./text": "./src/text.ts",
    "./text-svg": "./src/text-svg.ts",
    "./svg-ir": "./src/svg-ir.ts",
    "./render-integrity": "./src/render-integrity.ts",
    "./url-capture": "./src/url-capture.ts",
    "./net": "./src/net.ts",
    "./pptx": "./src/pptx.ts",
    "./lolly-file": "./src/lolly-file.ts",
    "./inspect": "./src/inspect.ts",
    "./inspect-render": "./src/inspect-render.ts",
    "./pdf": "./src/pdf.ts",
    "./pdf-structure": "./src/pdf-structure.ts",
    "./pdf-pages": "./src/pdf-pages.ts",
    "./canvas": "./src/canvas.ts",
    "./pdf-redact": "./src/pdf-redact.ts",
    "./pdf-redact-core": "./src/pdf-redact-core.ts",
    "./image-redact": "./src/image-redact.ts",
    "./verdict-slugs": "./src/verdict-slugs.ts",
    "./verdict-report": "./src/verdict-report.ts",
    "./trust-anchors": "./src/trust-anchors.ts",
    "./signing-identity": "./src/signing-identity.ts"

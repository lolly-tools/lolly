{
  "name": "@lolly-tools/node-shell",
  "version": "0.1.0",
  "description": "Shared Node-shell plumbing for the Lolly CLI and TUI: repo-root resolution, the scoped headless-Chromium launcher, the web-shell render tier, the resvg raster fast path, and the export Content-Credentials payload builder. One implementation so the terminal shells can never drift.",
  "license": "MPL-2.0",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./repo-root": "./src/repo-root.ts",
    "./state-dir": "./src/state-dir.ts",
    "./browsers": "./src/browsers.ts",
    "./browser-tier": "./src/browser-tier.ts",
    "./webshell-render": "./src/webshell-render.ts",
    "./raster": "./src/raster.ts",
    "./format-sniff": "./src/format-sniff.ts",
    "./images": "./src/images.ts",
    "./c2pa-opts": "./src/c2pa-opts.ts",
    "./text": "./src/text.ts",
    "./render-integrity": "./src/render-integrity.ts",
    "./url-capture": "./src/url-capture.ts",
    "./net": "./src/net.ts",
    "./pptx": "./src/pptx.ts",
    "./lolly-file": "./src/lolly-file.ts",
    "./inspect": "./src/inspect.ts",
    "./inspect-render": "./src/inspect-render.ts",
    "./pdf-pages": "./src/pdf-pages.ts",
    "./verdict-slugs": "./src/verdict-slugs.ts",
    "./verdict-report": "./src/verdict-report.ts",
    "./trust-anchors": "./src/trust-anchors.ts",
    "./signing-identity": "./src/signing-identity.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@lolly-tools/core": "*",
    "@lolly/engine": "*",
    "@resvg/resvg-js": "^2.6.2",
    "fflate": "^0.8.3",
    "harfbuzzjs": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "playwright-core": "^1.49.0"
  },
  "optionalDependencies": {
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  }
}

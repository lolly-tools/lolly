    "src",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@lolly-tools/core": "*",
    "@lolly/engine": "*",
    "@resvg/resvg-js": "^2.6.2",
    "fflate": "^0.8.3",
    "harfbuzzjs": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "playwright-core": "^1.49.0"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@napi-rs/canvas": "^1.0.8",
    "onnxruntime-node": "^1.29.0",
    "phonemizer": "^1.2.1",

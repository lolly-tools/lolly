-  '--c-border': C_BORDER,
-  '--c-text': C_TEXT,
-  '--c-dim': C_DIM,
-  '--c-faint': C_FAINT,
-  '--c-accent': C_ACCENT,
-  '--c-accent-alt': C_ACCENT_ALT,
-  '--c-green': C_GREEN,
-  '--c-green-deep': C_GREEN_DEEP,
-  '--c-warn': C_WARN,
-  '--c-rest': C_REST,
-  '--c-error': C_ERROR,
-  '--c-error-bg': C_ERROR_BG,
-  '--c-error-border': C_ERROR_BORDER,
-  '--c-grid': C_GRID,
-}
+export const CSS_VARS: Readonly<Record<string, string>> = HEX
 

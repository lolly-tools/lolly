Lolly patch 0009: files the editor makes are saved by Lolly.

Why: an anchor download from a sandboxed frame does not reach the desktop
app, and Lolly saves files through its own export path. The export popover's
WAV, stems, MIDI and recording, and the library's project export, hand their
bytes to the utility instead (with the names of any sung parts in the file
and their voices), which signs what it can before it saves.

Applied by scripts/vendor-rondocode.ts with git apply --directory=packages/rondo/upstream.

diff --git a/packages/app/src/editor/export.ts b/packages/app/src/editor/export.ts
index 2f6d18f6bd5999c0405cc09ba74e2319cfa8b37e..4d8b2b3f7fd5ee6433ef652fcab42b50393e7bc5 100644
--- a/packages/app/src/editor/export.ts
+++ b/packages/app/src/editor/export.ts
@@ -9,6 +9,8 @@ import { anchorPopover } from '../ui/viewport'
 import { capturePatternNotes, stageCode } from '../../../server/src/render-runner'
 import { renderStagedMix } from './resample'
 import { buildZip } from './zip'
+import { lolly } from '../lolly/host'
+import { bakedSingParts, bakedSingVoices } from '../sing/singMgr'
 
 /* Export the current tune five ways:
  *   - bounce wav: render N cycles offline (deterministic, uses the render path)
@@ -29,6 +31,12 @@ const el = <K extends keyof HTMLElementTagNameMap>(tag: K, cls?: string, text?:
 }
 
 function download(bytes: Uint8Array, name: string, type = 'audio/wav'): void {
+  // Lolly: the file goes to the utility, which saves it the way Lolly saves
+  // files (a frame download does not reach the desktop app)
+  if (lolly) {
+    lolly.download(bytes, name, type, { sung: bakedSingParts(), voices: bakedSingVoices() })
+    return
+  }
   const blob = new Blob([bytes as BlobPart], { type })
   const url = URL.createObjectURL(blob)
   const a = document.createElement('a')

     exportBtn.type = 'button'
     exportBtn.addEventListener('click', () => {
-      const blob = new Blob([JSON.stringify({ name: current.name, code: current.code }, null, 2)], {
+      const json = JSON.stringify({ name: current.name, code: current.code }, null, 2)
+      const fileName = `${current.name.replace(/[^a-z0-9]+/gi, '-').replace(/^-|-$/g, '') || 'project'}.rondo.json`
+      // Lolly: the utility saves the file, as it saves every file this app makes
+      if (lolly) {
+        lolly.download(new TextEncoder().encode(json), fileName, 'application/json')
